{
  "limits": {
    "max_cost_usd": 0.5,
    "run_timeout_ms": 600000
  },
  "steps": [
    {
      "id": "support",
      "kind": "agent",
      "effect": "at_least_once",
      "input": {
        "prompt": "${input.question}",
        "customer": "${input.customer_id}"
      },
      "step_timeout_ms": 120000
    }
  ],
  "output": "${steps.support.output}"
}
