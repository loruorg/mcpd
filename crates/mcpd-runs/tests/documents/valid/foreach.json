{
  "limits": {
    "max_steps": 250
  },
  "steps": [
    {
      "id": "each_file",
      "kind": "foreach",
      "over": "input.files",
      "concurrency": 4,
      "max_items": 200,
      "body": {
        "id": "summarise",
        "kind": "task",
        "input": {
          "file": "${item}",
          "position": "${index}"
        }
      }
    }
  ],
  "output": {
    "summaries": "${steps.each_file.outputs}"
  }
}
