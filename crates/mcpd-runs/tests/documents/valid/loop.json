{
  "steps": [
    {
      "id": "refine",
      "kind": "loop",
      "max_iterations": 5,
      "body": {
        "id": "draft",
        "kind": "agent",
        "input": {
          "brief": "${input.brief}",
          "pass": "${iter.index}"
        }
      },
      "until": {
        "path": "steps.draft.output.score",
        "op": "gte",
        "value": 0.9
      }
    }
  ],
  "output": {
    "drafts": "${steps.refine.outputs}"
  }
}
