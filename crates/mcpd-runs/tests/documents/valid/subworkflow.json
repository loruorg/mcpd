{
  "steps": [
    {
      "id": "check",
      "kind": "subworkflow",
      "definition": "fraud_check",
      "version": 2,
      "input": {
        "order_id": "${input.order_id}"
      }
    },
    {
      "id": "act",
      "kind": "task",
      "when": {
        "path": "steps.check.output.verdict",
        "op": "in",
        "value": [
          "clear",
          "review"
        ]
      },
      "input": "${steps.check.output}"
    }
  ]
}
