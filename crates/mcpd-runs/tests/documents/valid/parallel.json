{
  "steps": [
    {
      "id": "fan_out",
      "kind": "parallel",
      "branches": [
        {
          "id": "search_web",
          "kind": "task",
          "input": {
            "query": "${input.query}"
          },
          "on_error": "continue"
        },
        {
          "id": "search_docs",
          "kind": "task",
          "input": {
            "query": "${input.query}"
          }
        }
      ]
    },
    {
      "id": "merge",
      "kind": "task",
      "input": {
        "web": "${steps.fan_out.search_web.output}",
        "docs": "${steps.fan_out.search_docs.output}"
      }
    }
  ],
  "output": "${steps.merge.output}"
}
