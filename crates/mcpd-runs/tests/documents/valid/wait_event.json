{
  "steps": [
    {
      "id": "request",
      "kind": "task",
      "input": {
        "request_id": "${input.request_id}"
      }
    },
    {
      "id": "approval",
      "kind": "wait_event",
      "event": "approval",
      "key": "${input.request_id}",
      "timeout_ms": 604800000,
      "accept_parked": true,
      "on_timeout": "continue"
    },
    {
      "id": "apply",
      "kind": "task",
      "when": {
        "path": "steps.approval.output.approved",
        "op": "eq",
        "value": true
      },
      "input": {
        "request_id": "${input.request_id}",
        "approved_by": "${steps.approval.output.approver}"
      }
    }
  ],
  "output": {
    "approved": "${steps.approval.output.approved}",
    "status": "${steps.approval.status}"
  }
}
