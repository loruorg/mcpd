{
  "input_schema": {
    "type": "object",
    "properties": {
      "send_at": {
        "type": "string",
        "format": "date-time"
      },
      "email": {
        "type": "string"
      }
    },
    "required": [
      "send_at",
      "email"
    ]
  },
  "steps": [
    {
      "id": "until_send_time",
      "kind": "sleep_until",
      "at": "${input.send_at}"
    },
    {
      "id": "send",
      "kind": "task",
      "effect": "at_most_once",
      "input": {
        "to": "${input.email}"
      }
    }
  ]
}
