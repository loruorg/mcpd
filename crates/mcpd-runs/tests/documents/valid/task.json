{
  "input_schema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string"
      }
    },
    "required": [
      "question"
    ]
  },
  "steps": [
    {
      "id": "answer",
      "kind": "task",
      "input": {
        "question": "${input.question}"
      },
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_ms": 500,
        "max_ms": 30000
      },
      "step_timeout_ms": 60000
    }
  ],
  "output": {
    "answer": "${steps.answer.output.answer}"
  }
}
