{
  "steps": [
    {
      "id": "send",
      "kind": "task",
      "input": {
        "to": "${input.email}"
      }
    },
    {
      "id": "wait_a_day",
      "kind": "sleep",
      "ms": 86400000
    },
    {
      "id": "follow_up",
      "kind": "task",
      "when": {
        "not": {
          "path": "steps.send.output.opened",
          "op": "eq",
          "value": true
        }
      },
      "input": {
        "to": "${input.email}",
        "first_message_id": "${steps.send.output.message_id}"
      }
    }
  ]
}
