internal/
# Credentials. The root .env holds a token, and `COPY deploy` would carry a
# deploy/docker/.env with live keys into a build stage that CI exports to its
# cache with mode=max. Nothing in the image reads either file.
.env
**/.env
.env.*
**/.env.*
!**/.env.example
.claude/
# Local build output of the conformance probes; the site reads only the sources.
tests/e2e/probes/probes
tests/e2e/probes/rust/target/
