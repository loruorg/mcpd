{
  "name": "@mcpd/sdk",
  "version": "0.1.0",
  "description": "Agent observability and durable runs for TypeScript and JavaScript. Sends traces, logs, metrics, scores and feedback to an mcpd daemon, and serves workflows from your own process.",
  "license": "Apache-2.0",
  "homepage": "https://mcpd.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpd/mcpd.git",
    "directory": "sdks/typescript"
  },
  "keywords": [
    "observability",
    "tracing",
    "llm",
    "agent",
    "opentelemetry",
    "mcpd"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      },
      "default": "./dist/esm/testing.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "prepack": "npm run build",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.json --module commonjs --moduleResolution bundler --verbatimModuleSyntax false --outDir dist/cjs && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
