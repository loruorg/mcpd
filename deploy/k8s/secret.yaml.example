# A template, not part of the files beside it.
#
# The extension is .example on purpose. `kubectl apply -f deploy/k8s/` applies
# every manifest in this directory, and a Secret applied as written would put
# these placeholder strings into production as the keys. Create the Secret
# from the command line instead, with keys generated on the spot:
#
#   kubectl -n mcpd create secret generic mcpd-keys \
#     --from-literal=ingest-keys="$(openssl rand -hex 32)" \
#     --from-literal=read-keys="$(openssl rand -hex 32)" \
#     --from-literal=admin-keys="$(openssl rand -hex 32)" \
#     --from-literal=redact-key="$(openssl rand -hex 32)"
#
# Add execute-keys and worker-keys the same way once a worker runs outside the
# cluster; until then the deployment accepts the ingest keys for both.
#
# Or copy this file, replace every value with the output of
# `openssl rand -hex 32`, apply it by name, and do not commit the result.
apiVersion: v1
kind: Secret
metadata:
  name: mcpd-keys
  labels:
    app.kubernetes.io/name: mcpd
type: Opaque
stringData:
  # Comma-separated. One key per fleet or per team means a leaked key can be
  # revoked without redeploying every agent.
  ingest-keys: REPLACE_WITH_A_RANDOM_KEY
  # Never the same value as an ingest key.
  read-keys: REPLACE_WITH_A_DIFFERENT_RANDOM_KEY
  # Keys permitted to delete data and read the audit log. Without this entry
  # the daemon accepts the read keys for admin work, so every read key can
  # delete a trace; `mcpd doctor` reports that as a warning.
  admin-keys: REPLACE_WITH_A_THIRD_RANDOM_KEY
  # Keys permitted to start, cancel and signal runs.
  execute-keys: REPLACE_WITH_A_FIFTH_RANDOM_KEY
  # Keys permitted to claim steps and report their outcome. This one lives in
  # the process that runs step bodies, so it is never the read key.
  worker-keys: REPLACE_WITH_A_SIXTH_RANDOM_KEY
  # Salt for the hashes redaction leaves behind.
  redact-key: REPLACE_WITH_A_FOURTH_RANDOM_KEY
