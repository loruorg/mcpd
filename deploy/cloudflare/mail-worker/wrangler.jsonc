// Sends the hosted daemon's mail (sign-up, password reset, invitations)
// through Cloudflare Email Service. The daemon posts to it with
// --mail-http-url https://mail.mcpd.sh/send and --mail-http-token.
//
//   npx wrangler secret put MAIL_TOKEN && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpd-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "MAIL_FROM": "mcpd <no-reply@mcpd.sh>" },
  "routes": [{ "pattern": "mail.mcpd.sh", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
