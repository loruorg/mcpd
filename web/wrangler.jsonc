// The hosted site at https://mcpd.sh: the static build served from Cloudflare.
// No Worker script. The operator app calls the daemon at https://api.mcpd.sh,
// so build with PUBLIC_MCPD_ENDPOINT=https://api.mcpd.sh before you deploy:
//
//   PUBLIC_MCPD_ENDPOINT=https://api.mcpd.sh npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpd-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // `build.format: 'file'` writes docs/quickstart.html; this serves it at
    // /docs/quickstart, matching `trailingSlash: 'never'`.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mcpd.sh", "custom_domain": true },
    { "pattern": "www.mcpd.sh", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": false }
}
