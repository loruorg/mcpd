---
/**
 * The notice that no release exists yet.
 *
 * Every install command on this site names an image, a chart or a package that
 * the intended distribution will publish and that does not exist today. A
 * reader following the first step of the quickstart fails at `docker run` with
 * no explanation unless the page says so first. This says so, once, and gives
 * the one command that works: a build from source.
 */
import Command from '@/components/Command.astro'
import { localeOf } from '@/lib/i18n'
import type { Locale } from '@/lib/locales'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const code = localeOf(Astro.url.pathname)

/**
 * The notice, in every language.
 *
 * Kept here rather than in the chrome catalogue because it is one component's
 * own words. It must stay exactly as blunt in every language: this is the
 * sentence that stops a reader running a command that cannot work, so
 * softening it into marketing would be a lie.
 *
 * `label` is rendered through CSS uppercase, so the Turkish entry is a Turkish
 * word. An English label there would render with a dotted capital I.
 */
const TEXT: Record<Locale, { heading: string; body: string; label: string }> = {
  en: {
    heading: 'No release yet.',
    body: 'The image, the chart and the packages the commands on this site name are the intended distribution. None of them has been published. What works today is a build from source, which needs Rust and Node:',
    label: 'Build and run it',
  },
  fr: {
    heading: "Aucune version publiée pour l'instant.",
    body: "L'image, le chart et les paquets que nomment les commandes de ce site sont la distribution prévue. Aucun n'est publié. Ce qui fonctionne aujourd'hui est une compilation depuis les sources, qui demande Rust et Node :",
    label: 'Compiler et lancer',
  },
  es: {
    heading: 'Todavía no hay una versión publicada.',
    body: 'La imagen, el chart y los paquetes que nombran los comandos de este sitio son la distribución prevista. Ninguno se ha publicado. Lo que funciona hoy es compilar desde el código fuente, para lo que hacen falta Rust y Node:',
    label: 'Compilar y ejecutar',
  },
  zh: {
    heading: '尚未发布任何版本。',
    body: '本站命令中提到的镜像、Helm chart 和软件包都属于计划中的分发方式，目前一个都没有发布。现在可行的做法是从源码构建，这需要 Rust 和 Node：',
    label: '构建并运行',
  },
  ja: {
    heading: 'リリースはまだありません。',
    body: 'このサイトのコマンドが指すイメージ、チャート、パッケージは予定している配布物であり、どれも公開されていません。今動くのはソースからのビルドで、Rust と Node が必要です。',
    label: 'ビルドして実行',
  },
  ko: {
    heading: '아직 릴리스가 없습니다.',
    body: '이 사이트의 명령이 가리키는 이미지, 차트, 패키지는 예정된 배포물이며 아직 아무것도 공개되지 않았습니다. 현재 동작하는 방법은 소스에서 빌드하는 것이고, Rust와 Node가 필요합니다.',
    label: '빌드하고 실행',
  },
  it: {
    heading: 'Nessuna release, per ora.',
    body: "L'immagine, il chart e i pacchetti che i comandi di questo sito nominano sono la distribuzione prevista. Nessuno di essi è stato pubblicato. Quello che funziona oggi è una compilazione dai sorgenti, che richiede Rust e Node:",
    label: 'Compila ed esegui',
  },
  tr: {
    heading: 'Henüz bir sürüm yayımlanmadı.',
    body: 'Bu sitedeki komutların adını verdiği imaj, chart ve paketler planlanan dağıtımdır; hiçbiri yayımlanmadı. Bugün çalışan yol, kaynaktan derlemektir ve Rust ile Node gerekir:',
    label: 'Derleyip çalıştırma',
  },
  pt: {
    heading: 'Ainda não há uma versão publicada.',
    body: 'A imagem, o chart e os pacotes que os comandos deste site citam são a distribuição pretendida. Nenhum deles foi publicado. O que funciona hoje é compilar a partir do código-fonte, o que exige Rust e Node:',
    label: 'Compilar e executar',
  },
}
const t = TEXT[code]
---

<div class={`panel-raised ${className}`}>
  <div class="px-5 py-4">
    <p class="text-[0.9375rem] font-medium text-ink">{t.heading}</p>
    <p class="mt-2 max-w-[62ch] text-[0.875rem] leading-relaxed text-ink-2">{t.body}</p>
  </div>
  <Command
    class="border-t border-scribe-2"
    label={t.label}
    command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
  />
</div>
