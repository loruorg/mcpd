---
/**
 * The worker protocol as a sequence diagram: what a worker posts about one
 * step, in order. Two lifelines, time running down. Playing sends each message
 * across in turn; the markup shows the whole exchange.
 */
import { localeOf } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const s = strings(localeOf(Astro.url.pathname))

const WORKER = 150
const DAEMON = 470
const messages = [
  { y: 50, label: 'POST /steps/claim', to: 'daemon', note: s('fig.lease.claim') },
  { y: 80, label: 'lease', to: 'worker', note: s('fig.lease.lease') },
  { y: 110, label: 'POST /steps/{lease}/started', to: 'daemon', note: s('fig.lease.started') },
  { y: 145, label: 'heartbeat', to: 'daemon', note: s('fig.lease.heartbeat') },
  { y: 172, label: 'heartbeat', to: 'daemon', note: '' },
  { y: 199, label: 'heartbeat', to: 'daemon', note: '' },
  { y: 234, label: 'POST /steps/{lease}/complete', to: 'daemon', note: s('fig.lease.complete') },
  { y: 264, label: 'run_status, next', to: 'worker', note: s('fig.lease.ack') },
]
const TOP = 32
const BOTTOM = 284
---

<figure class={`fig ${className}`} data-motion data-lease>
  <div class="fig-head">
    <span class="legend">{s('fig.lease.title')}</span>
  </div>
  <div class="px-3 py-3 sm:px-5">
    <svg viewBox="0 0 760 296" class="block h-auto w-full" role="img" aria-label={s('fig.lease.aria')}>
      <text x={WORKER} y="14" text-anchor="middle" dominant-baseline="central" fill="var(--color-ink-2)" style="font-family:var(--font-data);font-size:12px">worker</text>
      <text x={DAEMON} y="14" text-anchor="middle" dominant-baseline="central" fill="var(--color-ink)" style="font-family:var(--font-data);font-size:12px">mcpd</text>
      <line x1={WORKER} y1={TOP} x2={WORKER} y2={BOTTOM} stroke="var(--color-scribe)" />
      <line x1={DAEMON} y1={TOP} x2={DAEMON} y2={BOTTOM} stroke="var(--color-scribe)" />
      <rect x={WORKER - 4} y="110" width="8" height="124" rx="2" fill="color-mix(in oklab, var(--color-accent) 25%, transparent)" stroke="var(--color-accent)" stroke-width="0.75" />
      <text x={WORKER - 14} y="172" text-anchor="end" dominant-baseline="central" fill="var(--color-ink-3)" style="font-family:var(--font-body);font-size:12px">{s('fig.lease.body')}</text>
      {messages.map((m, i) => {
        const from = m.to === 'daemon' ? WORKER + 5 : DAEMON
        const to = m.to === 'daemon' ? DAEMON : WORKER + 5
        const dir = m.to === 'daemon' ? 1 : -1
        return (
          <g class="lp-msg" data-i={i} data-from={from} data-to={to} data-y={m.y}>
            <line x1={from} y1={m.y} x2={to - dir * 2} y2={m.y} stroke="var(--color-ink-3)" stroke-width="1" />
            <path d={`M${to - dir * 7},${m.y - 4} L${to},${m.y} L${to - dir * 7},${m.y + 4}`} fill="none" stroke="var(--color-ink-3)" stroke-width="1" />
            <text x={(WORKER + DAEMON) / 2} y={m.y - 9} text-anchor="middle" fill="var(--color-ink)" style="font-family:var(--font-data);font-size:12px">{m.label}</text>
            {m.note && <text x={DAEMON + 14} y={m.y} dominant-baseline="central" fill="var(--color-ink-3)" style="font-family:var(--font-body);font-size:12px">{m.note}</text>}
          </g>
        )
      })}
      <circle class="lp-dot" r="3.5" cx="0" cy="0" fill="var(--color-accent)" opacity="0" />
    </svg>
  </div>
  <figcaption class="fig-foot">{s('fig.lease.caption')}</figcaption>
</figure>

<style>
  .lp-msg { transition: opacity 200ms var(--ease-out); }
</style>

<script>
  import { animate, each, easeOut } from '@/lib/motion'

  each('[data-lease]', (fig) => {
    const msgs = [...fig.querySelectorAll<SVGGElement>('.lp-msg')].map((g) => ({
      g,
      from: Number(g.dataset.from),
      to: Number(g.dataset.to),
      y: Number(g.dataset.y),
    }))
    const dot = fig.querySelector<SVGCircleElement>('.lp-dot')!
    const STEP = 0.9
    const CYCLE = STEP * msgs.length + 2.5
    animate(fig, (time) => {
      const k = time % CYCLE
      const i = Math.floor(k / STEP)
      msgs.forEach((m, n) => (m.g.style.opacity = n <= i ? '1' : '0.3'))
      const m = msgs[i]
      if (!m) {
        dot.setAttribute('opacity', '0')
        return
      }
      const p = easeOut(Math.min(1, (k - i * STEP) / (STEP * 0.7)))
      dot.setAttribute('opacity', p < 1 ? '1' : '0')
      dot.style.transform = `translate(${m.from + (m.to - m.from) * p}px, ${m.y}px)`
    })
  })
</script>
