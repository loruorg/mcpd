---
/**
 * A recorded terminal session.
 *
 * The whole session is in the markup and readable from the first paint; the
 * animation only reveals it line by line, and with motion reduced every line is
 * simply already there. Nothing here is a screenshot, so the text is
 * selectable, searchable and copyable.
 */
interface Line {
  /** A command the reader would type. */
  cmd?: string
  /** Output the program printed. */
  out?: string
  /** Tint the line: output that carries meaning is not all the same grey. */
  tone?: 'ok' | 'warn' | 'note'
}

interface Props {
  lines: Line[]
  title?: string
  class?: string
}

const { lines, title = 'shell', class: className = '' } = Astro.props

/* Each line waits for the ones before it. Commands hold a beat longer than
   output, which is roughly how a real session reads. */
let t = 0.35
const timed = lines.map((l) => {
  const delay = t
  t += l.cmd ? 0.85 : 0.32
  return { ...l, delay }
})
---

<div class={`fig ${className}`}>
  <div class="fig-head">
    <span class="legend">{title}</span>
  </div>
  <div class="scroll-x bg-well px-4 py-3.5">
    <pre class="data m-0 text-[0.8125rem] leading-[1.7]"><code>{timed.map((l) => (<span class="mcpd-line block" style={`animation-delay:${l.delay}s`}>{l.cmd ? (<><span class="select-none text-ink-3">$ </span><span class="text-ink">{l.cmd}</span></>) : (<span class:list={[l.tone === 'ok' ? 'text-olive' : l.tone === 'warn' ? 'text-amber' : 'text-ink-2']}>{l.out}</span>)}</span>))}</code></pre>
  </div>
</div>

<style>
  /* Every line is opaque from the first paint. The reveal shifts it, it does
     not fade it in: `backwards` fill would otherwise hold the last line at its
     starting opacity for the whole three seconds before its delay elapses, and
     on this well a dimmed line is an unreadable one. Content is never waiting
     on an animation here. */
  .mcpd-line {
    animation: mcpd-reveal 0.42s cubic-bezier(0.2, 0, 0, 1) backwards;
  }
  @keyframes mcpd-reveal {
    from { transform: translateY(2px); }
    to   { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mcpd-line { animation: none; }
  }
</style>
