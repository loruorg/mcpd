---
/**
 * What happens to a signal between arriving and being stored.
 *
 * Drawn because the order genuinely matters and is the thing people get wrong
 * about observability tools: redaction happens BEFORE storage, so a secret that
 * should never have been kept is never kept, rather than being deleted later.
 *
 * The stages and their descriptions are static text. A carrier travels the rail
 * and lights each stage as it passes; with motion reduced every stage simply
 * sits at full strength.
 */
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props

/* No numerals. The carrier already says the order, and a stage that says
   "03" beside a rail that draws it is the same fact twice. */
const stages = [
  { name: 'Decode', detail: 'OTLP or native, gzip or plain' },
  { name: 'Sample', detail: 'Decided once, at the root' },
  { name: 'Redact', detail: 'Before anything is written' },
  { name: 'Price',  detail: 'From the configured price book' },
  { name: 'Store',  detail: 'One transaction per batch' },
]
/** Where the carrier stops: the centre of each stage, as a percentage. */
const stops = stages.map((_, i) => ((i + 0.5) / stages.length) * 100)
---

<div class={`panel overflow-hidden ${className}`}>
  <div class="border-b border-scribe-2 bg-panel-1 px-4 py-2.5">
    <span class="legend text-ink-3">Ingest pipeline</span>
  </div>

  <ol class="relative grid gap-px bg-scribe sm:grid-cols-5">
    {/* The rail the carrier runs along, above the legends and over the stages
        so the carrier is seen. Horizontal on wide screens only, because a
        five-across rail on a phone would be unreadable. */}
    <div
      class="pointer-events-none absolute inset-x-0 top-[0.75rem] z-10 hidden h-px bg-scribe sm:block"
      aria-hidden="true"
    >
      <span class="mcpd-carrier absolute -top-[3px] block h-[7px] w-[7px] -translate-x-1/2 rotate-45 border border-amber bg-amber/80"></span>
    </div>

    {
      stages.map((s, i) => (
        <li
          class="mcpd-stage relative bg-panel-2 px-4 pb-4 pt-4 sm:pt-6"
          style={`animation-delay:${i * 0.7}s`}
        >
          <p class="legend text-ink">{s.name}</p>
          <p class="mt-1.5 text-[0.8125rem] leading-snug text-ink-3">{s.detail}</p>
        </li>
      ))
    }
  </ol>

  <p class="border-t border-scribe-2 bg-panel-1 px-4 py-2.5 text-[0.8125rem] text-ink-2">
    Redaction is stage three, not a cleanup job. A value that a rule matches
    never reaches storage at all.
  </p>
</div>

{/* The stops are computed from the stage list, so a stage added to it
    cannot leave the carrier parking between two cells. */}
<style is:inline set:html={`
  .mcpd-carrier {
    left: ${stops[0]!.toFixed(2)}%;
    animation: mcpd-travel 3.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes mcpd-travel {
    0%, 6%    { left: ${stops[0]!.toFixed(2)}%; }
    22%, 26%  { left: ${stops[1]!.toFixed(2)}%; }
    42%, 46%  { left: ${stops[2]!.toFixed(2)}%; }
    62%, 66%  { left: ${stops[3]!.toFixed(2)}%; }
    82%, 100% { left: ${stops[4]!.toFixed(2)}%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mcpd-carrier { animation: none; left: ${stops[2]!.toFixed(2)}%; }
  }
`}></style>

<style>

  /* Each stage brightens as the carrier reaches it. The base state is already
     fully legible; this only adds emphasis. */
  .mcpd-stage {
    animation: mcpd-stage-lit 3.5s ease-in-out infinite;
  }
  @keyframes mcpd-stage-lit {
    0%, 14%, 100% { background-color: var(--color-panel-2); }
    4%            { background-color: var(--color-panel-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mcpd-stage { animation: none; }
  }
</style>
