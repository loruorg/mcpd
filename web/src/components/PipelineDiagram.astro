---
/**
 * What happens to a span between arriving and being stored.
 *
 * One real-shaped payload rides the ingest pipeline. At Redact its credential
 * is replaced before anything is written, at Price it gains its cost, at Store
 * it is committed. The order is the point: a secret that should never be kept
 * is never kept, rather than deleted later.
 *
 * The markup is the stored payload, redacted and priced. Playing steps through
 * the stages and shows the payload as each one leaves it.
 */
import { localeOf } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const s = strings(localeOf(Astro.url.pathname))

const STAGES = [
  { name: s('fig.pipeline.decode'), detail: s('fig.pipeline.decodeDetail') },
  { name: s('fig.pipeline.sample'), detail: s('fig.pipeline.sampleDetail') },
  { name: s('fig.pipeline.redact'), detail: s('fig.pipeline.redactDetail') },
  { name: s('fig.pipeline.price'), detail: s('fig.pipeline.priceDetail') },
  { name: s('fig.pipeline.store'), detail: s('fig.pipeline.storeDetail') },
]
---

<figure class={`fig ${className}`} data-motion data-pipeline>
  <div class="fig-head">
    <span class="legend">{s('fig.pipeline.title')}</span>
    <span class="data ml-auto text-[0.75rem] text-ink-3">POST /v1/traces</span>
  </div>

  <ol class="m-0 grid list-none grid-cols-5 border-b border-scribe-2 p-0" style="padding-left:0">
    {STAGES.map((st, i) => (
      <li class="pd-stage relative px-2 py-2.5 text-center sm:px-3 sm:text-left" data-i={i} data-on={i === 4 ? '' : undefined}>
        <span class="block text-[0.75rem] font-medium text-ink sm:text-[0.8125rem]">{st.name}</span>
        <span class="mt-0.5 hidden text-[0.75rem] leading-snug text-ink-3 md:block">{st.detail}</span>
        <span class="pd-bar absolute inset-x-0 bottom-[-1px] h-[2px]"></span>
      </li>
    ))}
  </ol>

  <div class="bg-well px-4 py-3">
    <pre class="data m-0 overflow-x-auto text-[0.75rem] leading-[1.7]"><code><span class="text-ink-3">{'{'}</span>
  <span class="text-slate">"name"</span><span class="text-ink-3">:</span> <span class="text-olive">"chat"</span><span class="text-ink-3">,</span>
  <span class="text-slate">"model"</span><span class="text-ink-3">:</span> <span class="text-olive">"gpt-4.1-mini"</span><span class="text-ink-3">,</span>
  <span class="text-slate">"http.request.header.authorization"</span><span class="text-ink-3">:</span> <span class="pd-secret" data-raw={'"Bearer sk-live-8f2c41d9e0"'} data-safe={'"[redacted]"'}>"[redacted]"</span><span class="text-ink-3">,</span>
  <span class="text-slate">"usage.input_tokens"</span><span class="text-ink-3">:</span> <span class="text-amber">1100</span><span class="text-ink-3">,</span>
  <span class="pd-cost"><span class="text-slate">"cost_usd"</span><span class="text-ink-3">:</span> <span class="text-amber">0.00018</span></span>
<span class="text-ink-3">{'}'}</span>  <span class="pd-stored text-olive">{s('fig.pipeline.stored')}</span></code></pre>
  </div>

  <figcaption class="fig-foot">{s('fig.pipeline.caption')}</figcaption>
</figure>

<style>
  .pd-stage + .pd-stage { border-left: 1px solid var(--color-scribe-2); }
  .pd-stage { transition: background-color 220ms var(--ease-out); }
  .pd-stage[data-on] { background: var(--color-panel-3); }
  .pd-stage[data-on] .pd-bar { background: var(--color-accent); }
  .pd-secret {
    border-radius: 3px;
    padding: 0 0.15rem;
    color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
    transition: background-color 260ms var(--ease-out), color 260ms var(--ease-out);
  }
  .pd-secret[data-exposed] {
    color: var(--color-oxide);
    background: color-mix(in oklab, var(--color-oxide) 12%, transparent);
  }
</style>

<script>
  import { animate, each } from '@/lib/motion'

  each('[data-pipeline]', (fig) => {
    const stages = [...fig.querySelectorAll<HTMLElement>('.pd-stage')]
    const secret = fig.querySelector<HTMLElement>('.pd-secret')!
    const cost = fig.querySelector<HTMLElement>('.pd-cost')!
    const stored = fig.querySelector<HTMLElement>('.pd-stored')!
    const STEP = 1.7
    const CYCLE = STEP * stages.length + 1.5
    let last = -1
    animate(fig, (time) => {
      const i = Math.min(stages.length - 1, Math.floor((time % CYCLE) / STEP))
      if (i === last) return
      last = i
      stages.forEach((el, n) => el.toggleAttribute('data-on', n === i))
      const redacted = i >= 2
      secret.toggleAttribute('data-exposed', !redacted)
      secret.textContent = redacted ? secret.dataset.safe! : secret.dataset.raw!
      cost.style.visibility = i >= 3 ? 'visible' : 'hidden'
      stored.style.visibility = i >= 4 ? 'visible' : 'hidden'
    })
  })
</script>
