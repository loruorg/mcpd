---
/**
 * A post's rendered Markdown, with three repairs the file cannot be trusted to
 * make itself, because nobody reads a post between its commit and its deploy.
 *
 * - The page prints the title as its one h1. A body that opens with `# Title`
 *   anyway would give the page two, so a body h1 becomes an h2.
 * - A table wider than the column scrolls inside its own frame. The page never
 *   scrolls sideways.
 * - Images below the first screen load when they are reached.
 * - A highlighted code block sits in a well like the rest of the site's code.
 *
 * Code blocks come out of Shiki with `<` escaped, so none of these patterns can
 * match inside one.
 */
const html = (await Astro.slots.render('default'))
  .replace(/<h1(\s[^>]*)?>/g, '<h2$1>')
  .replace(/<\/h1>/g, '</h2>')
  .replace(/<table(\s[^>]*)?>/g, '<div class="table-scroll"><table$1>')
  .replace(/<\/table>/g, '</table></div>')
  .replace(/<img (?![^>]*\bloading=)/g, '<img loading="lazy" decoding="async" ')
  .replace(/<pre class="astro-code[\s\S]*?<\/pre>/g, '<div class="code-well">$&</div>')
---

<div class="prose post-body" set:html={html} />
