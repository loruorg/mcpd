---
/** The close of every post: what mcpd is, and the two ways to start. */
import { SITE } from '@/lib/site'
---

<aside class="panel-raised px-6 py-6 sm:px-7" aria-labelledby="blog-cta">
  <h2 id="blog-cta" class="text-[1.125rem] font-semibold tracking-[-0.015em] text-ink">Trace your agents with {SITE.name}</h2>
  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{SITE.description}</p>
  <div class="mt-5 flex flex-wrap gap-3">
    <a href="/app" class="btn btn-primary">Start free <span class="arrow" aria-hidden="true">→</span></a>
    <a href="/docs/quickstart" class="btn btn-secondary">Self-host</a>
  </div>
</aside>
