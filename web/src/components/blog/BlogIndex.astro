---
/**
 * One page of the blog index. `/blog` is page 1 and `/blog/page/<n>` the rest.
 *
 * With no posts the page is one line and `noindex`, and the sitemap leaves it
 * out (astro.config.mjs), so search engines never meet an empty blog.
 */
import Base from '@/layouts/Base.astro'
import PostList from '@/components/blog/PostList.astro'
import { SITE } from '@/lib/site'
import { BLOG, PAGE_SIZE, allPosts, indexPath } from '@/lib/blog'

interface Props {
  page: number
}

const { page } = Astro.props
const posts = await allPosts()
const pages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE))
const shown = posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
const newer = page > 1 ? indexPath(page - 1) : undefined
const older = page < pages ? indexPath(page + 1) : undefined

const title = page === 1 ? BLOG.title : `${BLOG.title}, page ${page}`
const description = page === 1 ? BLOG.description : `${BLOG.description} Page ${page} of ${pages}.`
---

<Base title={title} description={description} noindex={posts.length === 0}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${BLOG.title} · ${SITE.name}`} href={BLOG.feed} />
    {newer && <link rel="prev" href={newer} />}
    {older && <link rel="next" href={older} />}
  </Fragment>

  <div class="mx-auto max-w-[56rem] px-5 py-14 sm:px-8 sm:py-20">
    <header>
      <h1 class="display text-[clamp(1.9rem,3.4vw,2.6rem)]">{title}</h1>
      {
        posts.length > 0 && (
          <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-2">
            {BLOG.description} <a href={BLOG.feed} class="link">RSS feed</a>
          </p>
        )
      }
    </header>

    {
      posts.length === 0 ? (
        <p class="mt-6 text-[1.0625rem] text-ink-2">No posts yet.</p>
      ) : (
        <div class="mt-12">
          <PostList posts={shown} />
        </div>
      )
    }

    {
      pages > 1 && (
        <nav class="mt-10 flex items-center justify-between gap-4 text-[0.9375rem]" aria-label="Blog pages">
          {newer ? <a href={newer} rel="prev" class="link">← Newer posts</a> : <span />}
          <span class="data text-[0.8125rem] text-ink-3">Page {page} of {pages}</span>
          {older ? <a href={older} rel="next" class="link">Older posts →</a> : <span />}
        </nav>
      )
    }
  </div>
</Base>
