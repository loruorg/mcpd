---
/**
 * A list of posts: date, title, description and tags. The index shows it in
 * full; the related posts under an article show it without descriptions.
 *
 * Tags are plain text. They name what a post is about and lead nowhere, so
 * they are not drawn as controls.
 */
import { isoDay, longDay, postPath, type Post } from '@/lib/blog'

interface Props {
  posts: Post[]
  /** The heading level of each title, so the list fits the outline it sits in. */
  heading?: 'h2' | 'h3'
  compact?: boolean
}

const { posts, heading: H = 'h2', compact = false } = Astro.props
---

<ol class="border-t border-scribe-2">
  {
    posts.map((p) => (
      <li class:list={['grid gap-x-8 gap-y-1.5 border-b border-scribe-2 sm:grid-cols-[9.5rem_minmax(0,1fr)]', compact ? 'py-4' : 'py-6']}>
        <time datetime={isoDay(p.data.publishDate)} class="data pt-[0.2rem] text-[0.8125rem] text-ink-3">
          {longDay(p.data.publishDate)}
        </time>
        <div class="min-w-0">
          <H class:list={['font-semibold tracking-[-0.015em] text-ink', compact ? 'text-[1rem]' : 'text-[1.1875rem] leading-snug']}>
            <a href={postPath(p.id)} class="transition-colors hover:text-accent">{p.data.title}</a>
          </H>
          {!compact && <p class="mt-2 max-w-[68ch] text-[0.9375rem] leading-relaxed text-ink-2">{p.data.description}</p>}
          {!compact && p.data.tags.length > 0 && (
            <p class="mt-2 text-[0.8125rem] text-ink-3">{p.data.tags.join(' · ')}</p>
          )}
        </div>
      </li>
    ))
  }
</ol>
