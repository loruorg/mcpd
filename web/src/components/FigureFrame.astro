---
/**
 * The plate a figure sits on: the legend and a one-sentence caption above, the
 * drawing, then the hint and the live readout on one line beneath.
 *
 * The same skeleton as the run cursor and the signal flow had, so a figure
 * reads as one more instrument on the panel and not as an illustration set
 * into it. The readout is filled at build time with the frame the drawing
 * starts on, so with no script at all the plate still says what it shows.
 */
interface Props {
  title: string
  caption: string
  hint: string
  readout: string
  class?: string
}
const { title, caption, hint, readout, class: className = '' } = Astro.props
---

<figure class={`panel m-0 overflow-hidden ${className}`}>
  <div class="grid gap-px bg-scribe">
    <div class="flex flex-wrap items-baseline gap-x-8 gap-y-1 bg-panel-2 px-5 py-3.5">
      <p class="legend text-ink-2">{title}</p>
      <p class="max-w-[72ch] text-[0.8125rem] leading-snug text-ink-3">{caption}</p>
    </div>
    <div class="bg-panel-2 px-2 py-3 sm:px-6 sm:py-4">
      <slot />
    </div>
    <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 bg-panel-1 px-5 py-2.5">
      <span class="text-[0.75rem] text-ink-3">{hint}</span>
      {/* Not a live region: it changes many times a second, and a screen reader
          would read every one. The stage's own value text carries the state. */}
      <span class="data text-[0.75rem] text-ink-2" data-readout>{readout}</span>
    </figcaption>
  </div>
</figure>
