---
/**
 * Six signals, one run.
 *
 * mcpd stores spans, logs, metrics, scores, feedback and aspect notes against
 * the same trace and span ids. The figure is one run's timeline with a lane
 * per signal: as the run plays, each signal lands in its lane at the moment it
 * was produced, and the counters on the left add up. Every lane is keyed by
 * the one trace id in the header, which is the whole point.
 *
 * The markup is the finished run.
 */
import { localeOf } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const s = strings(localeOf(Astro.url.pathname))

/* Times are fractions of the run. Hand-placed to read as one plausible run:
   spans throughout, logs inside the tool calls, a metric per model call, the
   scores and the feedback after it ends. */
const LANES = [
  { id: 'span', label: s('fig.signals.spans'), color: 'var(--color-slate)', marks: [0.02, 0.08, 0.2, 0.31, 0.38, 0.5, 0.62, 0.7, 0.78] },
  { id: 'log', label: s('fig.signals.logs'), color: 'var(--color-ink-2)', marks: [0.22, 0.25, 0.4, 0.42, 0.44, 0.64, 0.73] },
  { id: 'metric', label: s('fig.signals.metrics'), color: 'var(--color-amber)', marks: [0.3, 0.6, 0.8] },
  { id: 'score', label: s('fig.signals.scores'), color: 'var(--color-accent)', marks: [0.86, 0.88] },
  { id: 'feedback', label: s('fig.signals.feedback'), color: 'var(--color-violet)', marks: [0.95] },
  { id: 'note', label: s('fig.signals.notes'), color: 'var(--color-oxide)', marks: [0.91] },
]
---

<figure class={`fig ${className}`} data-motion data-signals>
  <div class="fig-head">
    <span class="legend">{s('fig.signals.title')}</span>
    <span class="data ml-auto text-[0.75rem] text-ink-2">trace_id <span class="text-ink">7f3a91c2…</span></span>
  </div>
  <div class="relative px-4 py-3">
    <ul class="m-0 grid list-none gap-1 p-0" style="padding-left:0">
      {LANES.map((l) => (
        <li class="sf-lane grid grid-cols-[6.5rem_1.75rem_minmax(0,1fr)] items-center gap-3 sm:grid-cols-[8rem_2rem_minmax(0,1fr)]">
          <span class="truncate text-[0.8125rem] text-ink-2">{l.label}</span>
          <span class="sf-count data text-right text-[0.75rem] text-ink">{l.marks.length}</span>
          <span class="sf-track relative h-6 rounded-[4px] bg-well">
            {l.marks.map((m) => (
              <span
                class="sf-mark absolute top-1/2 h-3 w-[3px] rounded-[2px]"
                data-at={m}
                style={`left:${(m * 100).toFixed(2)}%; background:${l.color}; transform:translateY(-50%)`}
              ></span>
            ))}
          </span>
        </li>
      ))}
    </ul>
    <div class="sf-now pointer-events-none absolute inset-y-3 w-px bg-accent opacity-0" aria-hidden="true"></div>
  </div>
  <figcaption class="fig-foot">{s('fig.signals.caption')}</figcaption>
</figure>

<style>
  .sf-mark { transition: transform 260ms var(--ease-out); }
</style>

<script>
  import { animate, each } from '@/lib/motion'

  each('[data-signals]', (fig) => {
    const lanes = [...fig.querySelectorAll<HTMLElement>('.sf-lane')].map((el) => ({
      count: el.querySelector<HTMLElement>('.sf-count')!,
      marks: [...el.querySelectorAll<HTMLElement>('.sf-mark')].map((m) => ({ m, at: Number(m.dataset.at) })),
    }))
    const track = fig.querySelector<HTMLElement>('.sf-track')!
    const now = fig.querySelector<HTMLElement>('.sf-now')!
    let left = 0
    let width = 0
    const measure = () => {
      const box = fig.getBoundingClientRect()
      const t = track.getBoundingClientRect()
      left = t.left - box.left
      width = t.width
    }
    measure()
    addEventListener('resize', measure, { passive: true })
    document.fonts?.ready.then(measure)

    const RUN = 6
    const CYCLE = RUN + 3
    animate(fig, (time) => {
      const k = time % CYCLE
      const u = Math.min(1, k / RUN)
      for (const lane of lanes) {
        let n = 0
        for (const { m, at } of lane.marks) {
          const on = u >= at
          if (on) n += 1
          m.style.opacity = on ? '1' : '0'
          m.style.transform = `translateY(-50%) scaleY(${on ? 1 : 0.2})`
        }
        lane.count.textContent = String(n)
      }
      now.style.opacity = k < RUN ? '0.8' : '0'
      now.style.transform = `translateX(${left + u * width}px)`
    })
  })
</script>
