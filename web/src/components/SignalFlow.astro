---
/**
 * How the six signals reach the daemon and why they stay together.
 *
 * A diagram of the actual mechanism rather than a row of feature cards: the
 * point being made is that all six signals carry the same trace and span ids,
 * so the drawing has to show them converging on one correlation key.
 *
 * The labels and the structure are static markup. Only the packets move, and
 * with motion reduced they simply rest on the paths.
 */
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props

const signals = [
  { id: 'span',     label: 'Spans',    detail: 'What ran, nested, with timings' },
  { id: 'log',      label: 'Logs',     detail: 'Lines the run emitted' },
  { id: 'metric',   label: 'Metrics',  detail: 'Numbers, with exemplars back to a run' },
  { id: 'score',    label: 'Scores',   detail: 'Machine evaluation' },
  { id: 'feedback', label: 'Feedback', detail: 'What a person thought' },
  { id: 'aspect_note', label: 'Aspect notes', detail: 'A sentence a model wrote about the run' },
]
---

<div class={`panel overflow-hidden ${className}`}>
  <div class="grid gap-px bg-scribe lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
    {/* The six inputs. */}
    <ul class="grid gap-px bg-scribe">
      {
        signals.map((s) => (
          <li class="flex items-baseline gap-3 bg-panel-2 px-5 py-3.5">
            {/* The pip is a static mark, not a second animation. It used to
                pulse on the same stagger as the packets travelling the paths
                beside it, so the diagram ran two motion systems making the same
                argument. The packets carry it; six rows and six paths already
                read as six inputs. */}
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber" aria-hidden="true" />
            <div class="min-w-0">
              <p class="legend text-ink-2">{s.label}</p>
              <p class="mt-0.5 text-[0.8125rem] leading-snug text-ink-3">{s.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {/* The convergence. */}
    <div class="relative bg-panel-2 p-6 sm:px-8 sm:py-6">
      <svg
        class="h-auto w-full"
        style="min-height: 190px"
        viewBox="0 0 520 250"
        preserveAspectRatio="xMidYMid meet"
        fill="none"
        role="img"
        aria-label="Six signal paths converging on one trace identifier, then splitting to storage, search and export."
      >
        <defs>
          {/* Six paths, evenly spaced and symmetric about the junction at
              y=130. The outer two keep the exact y they had when there were
              five, so adding a signal did not move the drawing's bounds; the
              spacing is (234 - 26) / 5 = 41.6. With an even number of inputs no
              path runs straight through the centre any more, so all six are the
              same curve rather than four curves around one straight line. */}
          <path id="mcpd-p0" d="M0,26 C130,26 150,130 240,130" />
          <path id="mcpd-p1" d="M0,67.6 C130,67.6 150,130 240,130" />
          <path id="mcpd-p2" d="M0,109.2 C130,109.2 150,130 240,130" />
          <path id="mcpd-p3" d="M0,150.8 C130,150.8 150,130 240,130" />
          <path id="mcpd-p4" d="M0,192.4 C130,192.4 150,130 240,130" />
          <path id="mcpd-p5" d="M0,234 C130,234 150,130 240,130" />
        </defs>

        {[0, 1, 2, 3, 4, 5].map((i) => (
          <use href={`#mcpd-p${i}`} stroke="var(--color-scribe)" stroke-width="1" />
        ))}
        {/* One shared stem into the box, so six converging hairlines do not
            stack into a dark blob at the junction. */}
        <path d="M240,130 L262,130" stroke="var(--color-scribe)" stroke-width="1" />

        {/* The correlation key everything converges on. */}
        <rect x="262" y="112" width="120" height="36" fill="var(--color-well)" stroke="var(--color-scribe)" />
        {/* Dead centre of the rect: y = 112 + 36/2. `dominant-baseline: central`
            does the vertical centring, so the coordinate must be the box's
            centre and not a baseline guessed from it. */}
        <text
          x="322" y="130"
          text-anchor="middle" dominant-baseline="central"
          fill="var(--color-ink)"
          style="font-family:var(--font-data);font-size:14px"
        >trace_id</text>

        <path d="M382,130 L440,130" stroke="var(--color-scribe)" stroke-width="1" />
        <path d="M440,130 L440,60 L446,60" stroke="var(--color-scribe)" stroke-width="1" />
        <path d="M440,130 L446,130" stroke="var(--color-scribe)" stroke-width="1" />
        <path d="M440,130 L440,200 L446,200" stroke="var(--color-scribe)" stroke-width="1" />

        {/* On the line, not above it: same y as each branch, centred on it. */}
        <text x="450" y="60" dominant-baseline="central" fill="var(--color-ink-3)" style="font-family:var(--font-display);font-size:13px;letter-spacing:.14em;text-transform:uppercase">Store</text>
        <text x="450" y="130" dominant-baseline="central" fill="var(--color-ink-3)" style="font-family:var(--font-display);font-size:13px;letter-spacing:.14em;text-transform:uppercase">Search</text>
        <text x="450" y="200" dominant-baseline="central" fill="var(--color-ink-3)" style="font-family:var(--font-display);font-size:13px;letter-spacing:.14em;text-transform:uppercase">Export</text>

        {/* The packets. Each rides its own path at its own pace.

            The stagger is NEGATIVE, and that is the whole point of it. A
            positive `begin` leaves a circle at its own coordinates until its
            delay elapses, and a circle driven by `animateMotion` has to sit at
            0,0 for the path to place it, so four amber dots sat stacked in the
            top-left corner of the diagram, half clipped by the edge, for the
            first 1.7 seconds of every visit. A negative offset starts each
            animation already in progress, so a packet is on its path in the
            first painted frame and never rests at the origin. */}
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <circle r="2.75" fill="var(--color-amber)" class="mcpd-packet">
            <animateMotion
              dur={`${3.4 + i * 0.35}s`}
              repeatCount="indefinite"
              begin={`-${(i * 0.42).toFixed(2)}s`}
            >
              <mpath href={`#mcpd-p${i}`} />
            </animateMotion>
          </circle>
        ))}
      </svg>
    </div>
  </div>
</div>

<style>
  /* With motion reduced the packets stop where they are. Everything else on the
     diagram is static markup, so it still reads as six inputs converging on
     one id. */
  @media (prefers-reduced-motion: reduce) {
    .mcpd-packet { display: none; }
  }
</style>
