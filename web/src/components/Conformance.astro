---
/**
 * The conformance panel.
 *
 * Seven language channels against the nine families of invariant the
 * cross-language suite asserts.
 *
 * The channel list and the check count are READ from `tests/e2e/run.mjs` at
 * build time rather than written here. They were written here, and the suite
 * grew from nine assertions per language to thirty-three while the panel went
 * on saying 63: a drawing that cites a file and then states a number the file
 * no longer produces is worse than one that cites nothing, because a reader can
 * check it. AGENTS.md puts it as a rule for every graphic on this site, and
 * this is the one that broke it. The build now fails if the harness moves out
 * from under this panel instead of the panel quietly lying.
 *
 * This is the one claim on the site a competitor cannot copy by writing better
 * copy: every SDK is unit-tested alone, which proves each does what its authors
 * meant and nothing about whether they AGREE. The suite this panel draws writes
 * one canonical run through each language against one live daemon and asserts
 * the traces come back structurally identical.
 *
 * The lit state is the CSS default and the sweep REMOVES light before restoring
 * it. That ordering is the whole reason this is safe: a dead animation engine, a
 * backgrounded tab or a screenshot pass leaves a fully passing instrument rather
 * than an empty grid waiting for a script that is not coming.
 */

import { CHANNELS, HARNESS, PER_CHANNEL, TOTAL_CHECKS, spell } from '@/lib/conformance'

interface Props {
  /** Seconds for one full sweep of all seven channels. */
  period?: number
  class?: string
}

const { period = 12, class: className = '' } = Astro.props

/** The channels, in the order the harness runs them. */
const LANGUAGES = CHANNELS

/**
 * The nine families the suite's assertions fall into.
 *
 * Families rather than assertions: a panel has room for nine columns and the
 * harness asserts far more than nine things, so each column stands for the
 * group of checks about that part of the run. Short labels on the panel, a
 * sentence in the caption, because nine columns of sentence would not fit and
 * a legend that wraps is not a legend.
 */
const CHECKS = [
  { short: 'root', full: 'the root span is the agent run' },
  { short: 'tree', full: 'every child hangs off the root' },
  { short: 'status', full: 'a failed step makes the whole run an error, and only that step' },
  { short: 'error', full: 'the error carries a message, on the step that failed' },
  { short: 'model', full: 'the model call records its model' },
  { short: 'tokens', full: 'token usage and cost survive the wire' },
  { short: 'score', full: 'the scores land, with their scale' },
  { short: 'feedback', full: 'the feedback lands' },
  { short: 'ids', full: 'ids are OpenTelemetry-shaped' },
]

const ROWS = LANGUAGES.length
/** Each channel gets an equal slice of the loop, with the last held longer. */
const SLICE = 100 / (ROWS + 1)
---

<figure class={`panel-raised min-w-0 ${className}`}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 pt-3.5 pb-3">
    <p class="legend">Cross-language conformance</p>
    {/* The instrument cites the file it draws. A drawing becomes a claim you can
        go and check, and it costs one line. */}
    <p class="data text-[0.6875rem] text-ink-3">{HARNESS}</p>
  </div>

  <div class="seam min-w-0 overflow-x-auto scroll-x">
    <table class="w-full min-w-[34rem] border-collapse">
      <thead>
        <tr>
          <th class="legend px-4 py-2 text-left font-normal text-ink-3">Channel</th>
          {
            CHECKS.map((c) => (
              <th
                class="data px-1 py-2 text-center text-[0.625rem] font-normal text-ink-3"
                title={c.full}
              >
                {c.short}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          LANGUAGES.map((lang, row) => (
            <tr class="mcpd-chan border-t border-scribe-2" style={`--row:${row}`}>
              <th
                scope="row"
                class="whitespace-nowrap px-4 py-2 text-left text-[0.8125rem] font-medium text-ink"
              >
                {lang}
              </th>
              {
                CHECKS.map(() => (
                  <td class="px-1 py-2 text-center">
                    {/* A filled cell, not a tick glyph: the design system draws
                        its own marks and does not carry an icon pack. */}
                    <span class="mcpd-cell mx-auto block h-2 w-2 rounded-[1px] bg-olive" />
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="seam flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3">
    <p class="text-[0.8125rem] leading-snug text-ink-2">
      {spell(LANGUAGES.length)} languages, one canonical run, one daemon. Every
      trace comes back the same shape.
    </p>
    <p class="data text-[0.75rem] text-ink-3">{TOTAL_CHECKS} checks</p>
  </div>

  <figcaption class="sr-only">
    A conformance panel with one row per language and one column per family of
    check. Every cell passes. The families are:
    {CHECKS.map((c) => c.full).join('; ')}. The suite asserts {PER_CHANNEL}
    checks in each of the {LANGUAGES.length} languages.
  </figcaption>
</figure>

{/* The keyframes are generated from the channel count, so adding a language to
    the suite and to this panel cannot leave the sweep out of step with it. */}
<style is:inline set:html={`
  .mcpd-chan .mcpd-cell {
    animation: mcpd-conf ${period}s steps(1, end) infinite;
    animation-delay: calc(var(--row) * ${(period / (ROWS + 1)).toFixed(3)}s);
  }

  /* Lit and held, then unlit for a moment, then lit again. The cells are
     painted lit in the markup and this takes the light away briefly, so nothing
     depends on the animation running for the panel to read as passing. The
     hold comes first: the sweep used to open on the first channel dark, so the
     instrument's first frame showed a failing row. */
  @keyframes mcpd-conf {
    0%                             { opacity: 1; }
    ${SLICE.toFixed(2)}%           { opacity: 0.16; }
    ${(SLICE * 1.55).toFixed(2)}%  { opacity: 0.16; }
    ${(SLICE * 1.6).toFixed(2)}%   { opacity: 1; }
    100%                           { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mcpd-chan .mcpd-cell { animation: none; opacity: 1; }
  }
`}></style>
