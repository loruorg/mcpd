---
/**
 * A note set apart from the steps around it. Used where a reader would lose
 * time or data without it, not as decoration: most guides carry one or none.
 *
 * The label names the region, the way a figure header does. The edge colour is
 * a signal token, so a warning reads as attention in both themes.
 */
interface Props {
  tone?: 'note' | 'tip' | 'warning'
}

const { tone = 'note' } = Astro.props
const label = { note: 'Note', tip: 'Tip', warning: 'Warning' }[tone]
---

<aside class="callout not-prose" data-tone={tone} role="note">
  <p class="legend">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    border: 1px solid var(--color-scribe-2);
    border-left: 2px solid var(--color-accent);
    border-radius: var(--radius-tile);
    background: var(--color-panel-1);
    padding: 0.85rem 1.1rem;
    max-width: 68ch;
  }
  .callout[data-tone='warning'] {
    border-left-color: var(--color-amber);
  }
  .callout .legend {
    color: var(--color-ink-3);
  }
  .callout-body {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }
  .callout-body :global(code) {
    font-family: var(--font-data);
    font-size: 0.875em;
  }
  .callout-body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-scribe);
  }
  .callout-body :global(a:hover) {
    color: var(--color-accent);
  }
</style>
