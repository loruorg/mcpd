---
/**
 * What search is actually for.
 *
 * The queries cycle to make the point that mcpd indexes the payload, not just
 * the metadata: you can find a run by something the model said. The result rows
 * are real shapes from the demo data set.
 */
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props

const queries = [
  { q: 'shipped on Tuesday', found: 'the run whose completion said it', hits: 3 },
  { q: 'score_below=0.5', found: 'every answer a scorer marked down', hits: 12 },
  { q: 'min_duration_ms=5000', found: 'runs slower than five seconds', hits: 7 },
  { q: 'model=gpt-4o AND status=error', found: 'failures on one model', hits: 2 },
]
---

<div class={`panel-raised overflow-hidden ${className}`}>
  <div class="flex items-center gap-3 border-b border-scribe-2 bg-panel-1 px-4 py-2.5">
    <span class="legend text-ink-3">Search</span>
  </div>

  {/* The cycling field. Hidden under reduced motion, where each row carries its
      own query instead: a single static field above four answers would be one
      question with four replies. */}
  <div class="mcpd-field well m-4 flex items-center gap-2.5 rounded-[2px] px-3 py-2.5">
    <span class="data shrink-0 select-none text-[0.8125rem] text-ink-3" aria-hidden="true">/</span>
    <span class="data relative min-w-0 flex-1 text-[0.8125rem] text-ink">
      {
        queries.map((x, i) => (
          <span class="mcpd-q" style={`animation-delay:${i * 3.2}s`}>{x.q}</span>
        ))
      }
    </span>
    <span class="mcpd-caret block h-[1.1em] w-px shrink-0 bg-ink" aria-hidden="true"></span>
  </div>

  <ul class="border-t border-scribe-2 divide-y divide-scribe-2">
    {
      queries.map((x, i) => (
        <li
          class="mcpd-hit flex items-baseline gap-3 px-4 py-2.5"
          style={`animation-delay:${i * 3.2}s`}
        >
          <span class="data shrink-0 text-[0.6875rem] text-ink-3">{x.hits} hits</span>
          {/* Shown only when the field is not cycling, so the pairing survives
              a reader who has asked for no motion. */}
          <span class="mcpd-row-q data hidden shrink-0 text-[0.75rem] text-ink">
            {x.q}
          </span>
          <span class="min-w-0 truncate text-[0.8125rem] text-ink-2">{x.found}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* One query is visible at a time. The FIRST one is visible by default and is
     the only one in normal flow, so if the animation never runs, for any reason
     at all, the field still reads as a single populated search box rather than
     four queries stacked on top of each other. */
  .mcpd-q {
    display: block;
    animation: mcpd-cycle 12.8s steps(1) infinite;
  }
  .mcpd-q:not(:first-child) {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  @keyframes mcpd-cycle {
    0%, 25%   { opacity: 1; }
    25.01%, 100% { opacity: 0; }
  }

  .mcpd-hit {
    animation: mcpd-cycle-row 12.8s steps(1) infinite;
  }
  @keyframes mcpd-cycle-row {
    0%, 25%      { background-color: var(--color-panel-3); }
    25.01%, 100% { background-color: transparent; }
  }

  .mcpd-caret { animation: mcpd-blink 1.1s steps(1) infinite; }
  @keyframes mcpd-blink { 0%, 50% { opacity: 1 } 50.01%, 100% { opacity: 0 } }

  /* With motion reduced, every query and every answer is still on the page, as
     four pairs. The previous branch hid three of the four queries with
     `display: none`, which left one question above four replies and made the
     component say something untrue about what search returned. */
  @media (prefers-reduced-motion: reduce) {
    .mcpd-field { display: none; }
    .mcpd-row-q { display: inline; }
    .mcpd-hit, .mcpd-caret { animation: none; }
  }
</style>
