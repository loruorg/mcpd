---
/**
 * Search reads the payload, not just the metadata.
 *
 * A query is typed, filters are added, and the runs that match come back with
 * the line of the prompt or completion that matched. The queries use the
 * parameters the server parses (`q`, `status`, `model`); the result rows have
 * the shape the interface draws.
 *
 * The markup holds every query with its results, the first one shown. Playing
 * types each query and swaps its results in.
 */
import { localeOf } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const s = strings(localeOf(Astro.url.pathname))

const QUERIES = [
  {
    q: 'Leeds depot',
    filters: ['status=error'],
    hits: [
      { name: 'support_agent', pre: '…the parcel is held at the ', match: 'Leeds depot', post: ' until Friday…', ms: '8.42 s', error: true },
      { name: 'support_agent', pre: 'Call the ', match: 'Leeds depot', post: ' and ask for…', ms: '5.10 s', error: true },
      { name: 'triage', pre: 'route: ', match: 'Leeds depot', post: ' → returns', ms: '1.92 s', error: true },
    ],
  },
  {
    q: 'refund policy',
    filters: ['model=gpt-4o-mini'],
    hits: [
      { name: 'support_agent', pre: 'According to our ', match: 'refund policy', post: ', items can…', ms: '3.04 s', error: false },
      { name: 'refund_agent', pre: 'Look up the ', match: 'refund policy', post: ' for region EU', ms: '2.47 s', error: false },
      { name: 'support_agent', pre: '…the ', match: 'refund policy', post: ' does not cover…', ms: '4.88 s', error: false },
    ],
  },
]
---

<figure class={`fig ${className}`} data-motion data-search>
  <div class="fig-head">
    <span class="legend">{s('fig.search.title')}</span>
    <span class="data ml-auto text-[0.75rem] text-ink-3">GET /v1/api/traces</span>
  </div>

  <div class="flex flex-wrap items-center gap-2 border-b border-scribe-2 px-4 py-3">
    <div class="well flex min-w-0 flex-1 items-center gap-2 px-3 py-2">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--color-ink-3)" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" stroke-linecap="round" /></svg>
      <span class="sd-q data min-w-0 truncate text-[0.8125rem] text-ink">{QUERIES[0]!.q}</span>
      <span class="sd-caret h-[1.05em] w-px shrink-0 bg-ink" aria-hidden="true"></span>
    </div>
    <span class="sd-filter data rounded-[4px] border border-scribe bg-panel-1 px-2 py-1 text-[0.6875rem] text-ink-2">{QUERIES[0]!.filters[0]}</span>
  </div>

  {QUERIES.map((query, qi) => (
    <ul class="sd-results m-0 list-none divide-y divide-scribe-2 p-0" data-q={query.q} data-filter={query.filters[0]} hidden={qi !== 0} style="padding-left:0">
      {query.hits.map((h) => (
        <li class="sd-hit grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 px-4 py-2.5">
          <span class="flex min-w-0 items-center gap-2">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${h.error ? 'var(--color-oxide)' : 'var(--color-olive)'}`} aria-hidden="true"></span>
            <span class="data text-[0.75rem] text-ink">{h.name}</span>
          </span>
          <span class="data text-[0.6875rem] text-ink-3">{h.ms}</span>
          <span class="col-span-2 mt-0.5 truncate pl-3.5 text-[0.8125rem] text-ink-2">
            {h.pre}<mark class="rounded-[3px] px-0.5 text-ink" style="background:color-mix(in oklab, var(--color-amber) 22%, transparent)">{h.match}</mark>{h.post}
          </span>
        </li>
      ))}
    </ul>
  ))}

  <figcaption class="fig-foot">{s('fig.search.caption')}</figcaption>
</figure>

<style>
  .sd-caret { animation: sd-blink 1.05s steps(1) infinite; }
  @keyframes sd-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sd-caret { display: none; } }
</style>

<script>
  import { animate, each } from '@/lib/motion'

  each('[data-search]', (fig) => {
    const sets = [...fig.querySelectorAll<HTMLElement>('.sd-results')]
    const field = fig.querySelector<HTMLElement>('.sd-q')!
    const filter = fig.querySelector<HTMLElement>('.sd-filter')!
    const PER = 7
    animate(fig, (time) => {
      const i = Math.floor(time / PER) % sets.length
      const k = time % PER
      const set = sets[i]!
      const q = set.dataset.q!
      const typed = Math.min(q.length, Math.floor(k / 0.09))
      const text = q.slice(0, typed)
      if (field.textContent !== text) field.textContent = text
      const ready = typed >= q.length && k > q.length * 0.09 + 0.35
      filter.textContent = set.dataset.filter!
      filter.style.visibility = ready || typed >= q.length ? 'visible' : 'hidden'
      // The previous answer stays, dimmed, while the next query is typed, so
      // the figure never changes height.
      const shown = ready ? i : (i - 1 + sets.length) % sets.length
      sets.forEach((s, n) => {
        const show = n === shown
        if (s.hidden === show) s.hidden = !show
        s.style.opacity = ready ? '1' : '0.45'
      })
      if (ready) {
        set.querySelectorAll<HTMLElement>('.sd-hit').forEach((h, n) => {
          const p = Math.min(1, Math.max(0, (k - q.length * 0.09 - 0.35 - n * 0.12) / 0.25))
          h.style.opacity = String(p)
          h.style.transform = `translateY(${(1 - p) * 4}px)`
        })
      }
    })
  })
</script>
