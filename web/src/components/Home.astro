---
/**
 * The home page's layout, written once for all nine locales.
 *
 * Each `pages/<locale>/index.astro` carries its own words as a `HomeCopy`
 * and passes the motion graphics in as slots, so the page file itself renders
 * them (which `tools/check-consistency.mjs` requires) and a layout change is
 * made in one place rather than nine.
 */
import Command from '@/components/Command.astro'
import { localeOf, urlFor } from '@/lib/i18n'

export interface HomeCopy {
  h1: string
  lede: string
  startFree: string
  selfHost: string
  heroNote: string
  worksTitle: string
  worksBody: string
  otelLabel: string
  sdkLead: string
  frameworksLegend: string
  providersLegend: string
  ownLoop: string
  seeTitle: string
  seeBody: string
  seeFacts: [string, string, string, string]
  openInterface: string
  flowTitle: string
  flowBody: string
  flowNotes: [string, string][]
  flowLink: string
  evalTitle: string
  evalBody: string
  evalLink: string
  alertLink: string
  deployTitle: string
  deployBody: string
  deployLink: string
  targets: [string, string][]
  ownLabel: string
  fromSource: string
  closeTitle: string
  closeBody: string
}

interface Props {
  copy: HomeCopy
}
const { copy: c } = Astro.props
const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, code)

/* Names a reader can instrument today. Text, never logos: these are other
   people's marks. Each reaches mcpd through OpenTelemetry, using the gen_ai.*
   or OpenInference conventions the daemon reads. */
const FRAMEWORKS = [
  'LangChain', 'LangGraph', 'LlamaIndex', 'CrewAI', 'Vercel AI SDK', 'OpenAI Agents SDK',
  'Pydantic AI', 'AutoGen', 'Semantic Kernel', 'Haystack', 'DSPy',
]
const PROVIDERS = ['OpenAI', 'Anthropic', 'Google Gemini', 'Mistral', 'Azure OpenAI', 'Groq', 'Ollama', 'vLLM']
const SDKS = [
  ['TypeScript', '/docs/sdks/typescript'], ['Python', '/docs/sdks/python'], ['Rust', '/docs/sdks/rust'],
  ['Go', '/docs/sdks/go'], ['Kotlin', '/docs/sdks/kotlin'], ['Elixir', '/docs/sdks/elixir'],
] as const
const H2 = 'display text-[clamp(1.85rem,3.4vw,2.75rem)]'
---

{/* ------------------------------------------------------------------ hero */}
<section class="hero relative overflow-hidden">
  <div class="mx-auto grid max-w-[86rem] items-center gap-12 px-5 pb-16 pt-12 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14 lg:pb-28 lg:pt-24">
    <div class="min-w-0">
      <h1 class="display max-w-[15ch] text-[clamp(2.5rem,5.2vw,4.25rem)]">{c.h1}</h1>
      <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-ink-2 sm:text-[1.125rem]">{c.lede}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/app" class="btn btn-primary">{c.startFree} <span class="arrow" aria-hidden="true">→</span></a>
        <a href={linkTo('/docs/quickstart')} class="btn btn-secondary">{c.selfHost}</a>
      </div>
      <p class="mt-5 text-[0.875rem] text-ink-3">{c.heroNote}</p>
    </div>
    <slot name="hero" />
  </div>
</section>

{/* ------------------------------------------------------------ works with */}
<section class="border-y border-scribe-2 bg-panel-1">
  <div class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <div class="min-w-0">
        <h2 class={`${H2} max-w-[18ch]`}>{c.worksTitle}</h2>
        <p class="mt-5 max-w-[48ch] text-[1rem] leading-relaxed text-ink-2">{c.worksBody}</p>
        <Command
          class="mt-7"
          label={c.otelLabel}
          command={`export OTEL_EXPORTER_OTLP_ENDPOINT=https://api.mcpd.sh
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json`}
        />
        <p class="mt-4 text-[0.9375rem] text-ink-2">
          {c.sdkLead}{' '}
          {SDKS.map(([name, path], i) => (
            <>{i > 0 && <span class="text-ink-3"> · </span>}<a href={linkTo(path)} class="link">{name}</a></>
          ))}
        </p>
      </div>
      <div class="grid min-w-0 gap-8 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
        <div>
          <p class="legend">{c.frameworksLegend}</p>
          <ul class="wordmarks mt-3">
            {FRAMEWORKS.map((f) => <li>{f}</li>)}
            <li class="!border-dashed !bg-transparent !text-ink-2">{c.ownLoop}</li>
          </ul>
        </div>
        <div>
          <p class="legend">{c.providersLegend}</p>
          <ul class="wordmarks mt-3">
            {PROVIDERS.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ---------------------------------------------------------- what you see */}
<section class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 lg:py-28">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-16">
    <div class="min-w-0">
      <h2 class={`${H2} max-w-[16ch]`}>{c.seeTitle}</h2>
      <p class="mt-5 max-w-[44ch] text-[1rem] leading-relaxed text-ink-2">{c.seeBody}</p>
      <ul class="facts mt-7">
        {c.seeFacts.map((f) => <li>{f}</li>)}
      </ul>
      <p class="mt-7"><a href="/app" class="link">{c.openInterface}</a></p>
    </div>
    <slot name="see" />
  </div>
</section>

{/* ------------------------------------------------------------- workflows */}
<section class="border-y border-scribe-2 bg-panel-1">
  <div class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-5">
      <h2 class={`${H2} max-w-[18ch]`}>{c.flowTitle}</h2>
      <p class="max-w-[50ch] text-[1rem] leading-relaxed text-ink-2">{c.flowBody}</p>
    </div>
    <slot name="flow" />
    <div class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-3">
      {c.flowNotes.map(([title, body]) => (
        <div>
          <p class="text-[0.9375rem] font-medium text-ink">{title}</p>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">{body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8"><a href={linkTo('/docs/workflows')} class="link">{c.flowLink}</a></p>
  </div>
</section>

{/* -------------------------------------------------- evaluation, monitors */}
<section class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 lg:py-28">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16">
    <div class="min-w-0 max-lg:order-2"><slot name="eval" /></div>
    <div class="min-w-0">
      <h2 class={`${H2} max-w-[16ch]`}>{c.evalTitle}</h2>
      <p class="mt-5 max-w-[44ch] text-[1rem] leading-relaxed text-ink-2">{c.evalBody}</p>
      <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
        <a href={linkTo('/docs/evaluation')} class="link">{c.evalLink}</a>
        <a href={linkTo('/docs/alerting')} class="link">{c.alertLink}</a>
      </div>
    </div>
  </div>
</section>

{/* ---------------------------------------------------------------- deploy */}
<section class="border-t border-scribe-2 bg-panel-1">
  <div class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="min-w-0">
        <h2 class={`${H2} max-w-[14ch]`}>{c.deployTitle}</h2>
        <p class="mt-5 max-w-[46ch] text-[1rem] leading-relaxed text-ink-2">{c.deployBody}</p>
        <p class="mt-7"><a href={linkTo('/deploy')} class="link">{c.deployLink}</a></p>
      </div>
      <div class="grid min-w-0 gap-3 sm:grid-cols-2">
        {c.targets.map(([title, body]) => (
          <div class="target">
            <p class="text-[0.9375rem] font-medium text-ink">{title}</p>
            <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-2">{body}</p>
          </div>
        ))}
        <Command
          class="mt-3 sm:col-span-2"
          label={c.ownLabel}
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
          primaryLabel={c.fromSource}
          secondary={[
            { label: 'Docker', command: 'docker run -p 4317:4317 ghcr.io/mcpd/mcpd' },
            { label: 'Kubernetes', command: 'helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace' },
          ]}
        />
      </div>
    </div>
  </div>
</section>

{/* ----------------------------------------------------------------- close */}
<section class="bg-floor text-floor-ink">
  <div class="mx-auto flex max-w-[86rem] flex-col items-start gap-8 px-5 py-16 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:py-24">
    <div>
      <h2 class="max-w-[20ch] text-[clamp(1.85rem,3.6vw,3rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-floor-ink">{c.closeTitle}</h2>
      <p class="mt-4 max-w-[46ch] text-[1rem] leading-relaxed text-floor-ink/75">{c.closeBody}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/app" class="btn btn-floor">{c.startFree} <span class="arrow" aria-hidden="true">→</span></a>
      <a href={linkTo('/docs/quickstart')} class="btn btn-floor-secondary">{c.selfHost}</a>
    </div>
  </div>
</section>
