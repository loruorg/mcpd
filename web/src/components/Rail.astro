---
/**
 * The console rail.
 *
 * The top edge of the panel, not a navigation bar: a wordmark plate, engraved
 * route legends, a live status annunciator, the language selector, and the
 * scribed seam that separates the rail from the panel below it.
 *
 * Every word in here comes from `lib/ui-strings`, because the rail is on all
 * nine locales and the markup is one copy.
 */
import { SITE } from '@/lib/site'
import { localeOf, routeOf, urlFor } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'
import LanguageSelector from '@/components/LanguageSelector.astro'

/* `route` is the path with the locale prefix taken off, so one list of routes
   written once serves all nine locales. */
const locale = localeOf(Astro.url.pathname)
const route = routeOf(Astro.url.pathname)
const s = strings(locale)

// The interface has its own daemon indicator in its toolbar; a second one in
// the rail 40px away is the same fact twice.
const showDaemonTile = !route.startsWith('/app')

const routes = [
  { path: '/docs', label: s('rail.docs') },
  { path: '/docs/quickstart', label: s('rail.quickstart') },
  { path: '/deploy', label: s('rail.deploy') },
]
const isCurrent = (path: string) =>
  path === '/docs' ? route === '/docs' : route === path || route.startsWith(`${path}/`)
---

<header class="rail sticky top-0 z-40">
  <div class="mx-auto flex h-14 max-w-[86rem] items-center gap-5 px-5 sm:px-8">
    <a href={urlFor('/', locale)} class="group flex shrink-0 items-center gap-2.5" aria-label={s('rail.home')}>
      {/* The mark: three spans of a waterfall, the shape everything here is about. */}
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" class="shrink-0">
        <rect x="0.5" y="0.5" width="21" height="21" rx="6" fill="var(--color-ink)" />
        <rect x="5" y="6" width="9" height="2.4" rx="1.2" fill="var(--color-panel-0)" />
        <rect x="8" y="9.8" width="9" height="2.4" rx="1.2" fill="var(--color-accent)" />
        <rect x="6.5" y="13.6" width="6" height="2.4" rx="1.2" fill="var(--color-panel-0)" opacity="0.7" />
      </svg>
      <span class="text-[1.125rem] font-semibold leading-none tracking-[-0.03em] text-ink">{SITE.name}</span>
      <span class="hidden text-[0.8125rem] text-ink-3 xl:inline">{s('rail.tagline')}</span>
    </a>

    <nav class="ml-4 hidden items-center gap-0.5 md:flex" aria-label={s('rail.nav')}>
      {routes.map((r) => (
        <a
          href={urlFor(r.path, locale)}
          aria-current={isCurrent(r.path) ? 'page' : undefined}
          class:list={[
            'rounded-[5px] px-3 py-1.5 text-[0.875rem] transition-colors hover:bg-panel-1',
            isCurrent(r.path) ? 'font-medium text-ink' : 'text-ink-2 hover:text-ink',
          ]}
        >{r.label}</a>
      ))}
      <a href={SITE.repo} rel="noopener" class="rounded-[5px] px-3 py-1.5 text-[0.875rem] text-ink-2 transition-colors hover:bg-panel-1 hover:text-ink">{s('rail.source')}</a>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      {showDaemonTile && (
        <div
          id="daemon-status"
          class="annunciator mcpd-tile-off mr-1"
          data-lit=""
          data-label-ready={s('rail.daemonReady')}
          role="status"
          aria-live="polite"
        >
          <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
          <span data-label>{s('rail.daemonAbsent')}</span>
        </div>
      )}

      <LanguageSelector />

      <button type="button" id="theme-toggle" class="theme-toggle" aria-label={s('rail.theme')} title={s('rail.theme')}>
        <svg class="theme-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <circle cx="8" cy="8" r="3" />
          <path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" />
        </svg>
        <svg class="theme-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
          <path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1Z" />
        </svg>
      </button>

      <a href="/app" class="btn btn-primary ml-1.5 hidden !h-9 !px-3.5 !text-[0.875rem] sm:inline-flex">{s('rail.startFree')}</a>

      <button
        type="button"
        id="rail-toggle"
        class="theme-toggle rail-menu-button"
        aria-expanded="false"
        aria-controls="rail-menu"
        aria-label={s('rail.menu')}
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 5h11M2.5 11h11" /></svg>
      </button>
    </div>
  </div>

  {/* Mobile routes. In the document and only hidden, so a crawler and a reader
      with no JavaScript still have them. */}
  <nav id="rail-menu" class="hidden border-t border-scribe-2 px-5 pb-3 md:!hidden sm:px-8" aria-label={s('rail.nav')}>
    {routes.map((r) => (
      <a
        href={urlFor(r.path, locale)}
        aria-current={isCurrent(r.path) ? 'page' : undefined}
        class:list={['block border-b border-scribe-2 py-3 text-[0.9375rem]', isCurrent(r.path) ? 'font-medium text-ink' : 'text-ink-2']}
      >{r.label}</a>
    ))}
    <a href={SITE.repo} rel="noopener" class="block border-b border-scribe-2 py-3 text-[0.9375rem] text-ink-2">{s('rail.source')}</a>
    <a href="/app" class="btn btn-primary mt-3 w-full">{s('rail.startFree')}</a>
  </nav>
</header>

<style>
  .rail {
    background: color-mix(in oklab, var(--color-panel-0) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--color-scribe-2);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-tile);
    color: var(--color-ink-2);
    transition: background-color 140ms var(--ease-out), color 140ms var(--ease-out);
  }
  .theme-toggle:hover { background: var(--color-panel-1); color: var(--color-ink); }
  @media (min-width: 768px) { .rail-menu-button { display: none; } }
  /* Show the theme you would switch TO. Written as the two explicit choices
     and the system fallback, so the icon is right before any script runs. */
  .theme-moon { display: block; }
  .theme-sun { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-moon { display: none; }
    :global(:root:not([data-theme='light'])) .theme-sun { display: block; }
  }
  :global(:root[data-theme='dark']) .theme-moon { display: none; }
  :global(:root[data-theme='dark']) .theme-sun { display: block; }
</style>

<script>
  // The theme control. The choice is stored and written to `data-theme`; the
  // head script in Base.astro reads it back before the next page paints.
  const themeButton = document.getElementById('theme-toggle')
  themeButton?.addEventListener('click', () => {
    const root = document.documentElement
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    const next = current === 'dark' ? 'light' : 'dark'
    root.classList.add('theme-switching')
    root.dataset.theme = next
    try {
      localStorage.setItem('mcpd:theme', next)
    } catch {
      /* Private browsing: the choice holds for this page. */
    }
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')))
  })

  // The menu toggle. A control that looks interactive must work, so this is
  // wired directly rather than through a framework island.
  const toggle = document.getElementById('rail-toggle')
  const menu = document.getElementById('rail-menu')
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!open))
    menu?.classList.toggle('hidden', open)
  })

  // Ask the local daemon whether it is running. The tile starts in its honest
  // unlit state and only lights when something actually answered, so a failed
  // probe leaves a correct label rather than a stale green light.
  const tile = document.getElementById('daemon-status')
  // Probe once per browsing session rather than on every navigation. A machine
  // with no daemon does not become one three pages later, and each failed
  // attempt costs a console line the reader did not ask for.
  const PROBED = 'mcpd:probed'
  let cached: string | null = null
  try {
    cached = sessionStorage.getItem(PROBED)
  } catch {
    /* Private browsing; probe as usual. */
  }
  // One place that lights the tile, used by both the cached answer and a fresh
  // probe. They were two copies, and the cached one lit the lamp and wrote the
  // label but never took the tile out of `display: none`. The tile is hidden
  // until something answers, so on a machine that IS running mcpd it appeared
  // on the first page of a session and then vanished for every page after it,
  // which is the wrong way round: the cache exists to keep it there.
  const light = (version: string) => {
    if (!tile) return
    tile.setAttribute('data-lit', 'olive')
    tile.classList.remove('mcpd-tile-off')
    const l = tile.querySelector('[data-label]')
    // The sentence comes from the string catalogue on the element, filled here.
    // Building it in script would leave one language hard-coded in the bundle.
    if (l) l.textContent = (tile.dataset.labelReady ?? 'daemon {version}').replace('{version}', version)
  }
  if (tile && cached) {
    if (cached !== 'absent') light(cached)
  } else if (tile) {
    // The daemon serves this page from its own binary, so its own origin is
    // the first place to look. A documentation host will not answer at all,
    // and the tile stays hidden.
    const endpoint =
      new URLSearchParams(location.search).get('daemon') ??
      (location.protocol.startsWith('http') ? location.origin : 'http://localhost:4317')
    const controller = new AbortController()
    const timer = setTimeout(() => controller.abort(), 1200)
    fetch(`${endpoint}/healthz`, { signal: controller.signal, mode: 'cors' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((h: { version?: string }) => {
        // Only ever shown lit. An unlit chip saying "no daemon" in the header
        // of a marketing page reads as an error to someone who has not
        // installed anything yet.
        light(h.version ?? 'ready')
        try { sessionStorage.setItem(PROBED, h.version ?? 'ready') } catch { /* ignore */ }
      })
      .catch(() => {
        /* No daemon on this machine. The unlit tile already says so. */
        try { sessionStorage.setItem(PROBED, 'absent') } catch { /* ignore */ }
      })
      .finally(() => clearTimeout(timer))
  }
</script>
