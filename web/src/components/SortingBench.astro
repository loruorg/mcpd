---
/**
 * Six signals, filed by the run that produced them, drawn as a sorting bench.
 *
 * The build draws the bench, every piece at its place at `START`, and the
 * first drawer open, so the figure is complete before any script runs. The
 * script only moves what moves: the pieces, the belt's cleats, the drawers and
 * the lamps. Everything it moves comes from `@/lib/iso/sorter`, the same
 * module that drew the static frame.
 */
import FigureFrame from '@/components/FigureFrame.astro'
import { t } from '@/lib/ui-strings'
import { localeOf } from '@/lib/i18n'
import * as S from '@/lib/iso/sorter'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const locale = localeOf(Astro.url.pathname)

/** The frame the drawing starts on: several pieces in flight, one at the reader. */
const START = 9.6
const art = S.art()
const pieces = S.STREAM.map(([kind], i) => ({ i, kind, at: S.placeOf(i, START) }))
const readout = (run: number) =>
  `trace ${S.RUNS[run]} · ${S.countsOf(run).map(([kd, n]) => `${kd} ${n}`).join(' · ')}`
---

<FigureFrame
  class={className}
  title={t('fig.sorter.title', locale)}
  caption={t('fig.sorter.caption', locale)}
  hint={t('fig.sorter.hint', locale)}
  readout={readout(0)}
>
  <div
    class="iso iso-stage"
    data-fig="sorter"
    data-start={START}
    data-readouts={JSON.stringify(S.RUNS.map((_, r) => readout(r)))}
    tabindex="0"
    role="slider"
    aria-label={t('fig.sorter.label', locale)}
    aria-valuemin="1"
    aria-valuemax={S.RUNS.length}
    aria-valuenow="1"
    aria-valuetext={readout(0)}
  >
    <svg class="iso-svg mx-auto max-w-[60rem]" viewBox={`0 0 ${S.WIDTH} ${S.HEIGHT}`} aria-hidden="true">
      <g set:html={art.back} />
      <path class="iso-line" data-tone="faint" data-cleats d={S.cleats(START * S.BELT_V)} />
      <g data-layer="belt">
        {pieces.filter((p) => p.at?.leg === 'belt').map((p) => (
          <g data-piece={p.i} transform={S.translate(p.at!.x, p.at!.y, p.at!.z)} data-sel={S.STREAM[p.i]![1] === 0 ? '' : undefined} set:html={S.pieceSvg(p.kind)} />
        ))}
      </g>
      <g set:html={art.afterBelt} />
      <circle class="iso-lamp" data-reader cx={S.READER_LAMP[0].toFixed(1)} cy={S.READER_LAMP[1].toFixed(1)} r="1.6" />
      <g set:html={art.table} />
      <g data-layer="table">
        {pieces.filter((p) => p.at?.leg === 'table').map((p) => (
          <g data-piece={p.i} transform={S.translate(p.at!.x, p.at!.y, p.at!.z)} data-sel={S.STREAM[p.i]![1] === 0 ? '' : undefined} set:html={S.pieceSvg(p.kind)} />
        ))}
      </g>
      <g data-layer="spare" style="display:none">
        {pieces.filter((p) => !p.at).map((p) => (
          <g data-piece={p.i} set:html={S.pieceSvg(p.kind)} />
        ))}
      </g>
      <g set:html={art.cabinet} />
      {S.LANES.map((_, lane) => (
        <g data-drawer={lane}>
          <g data-tray set:html={lane === 0 ? S.trayAt(0, S.OPEN) : ''} />
          <g data-front transform={lane === 0 ? S.translate(S.OPEN, 0, 0) : undefined} set:html={S.drawerFront(lane)} />
        </g>
      ))}
    </svg>
  </div>
</FigureFrame>

<script>
  import * as S from '@/lib/iso/sorter'
  import { live } from '@/lib/iso/live'

  for (const stage of document.querySelectorAll<HTMLElement>('[data-fig="sorter"]')) {
    const svg = stage.querySelector('svg')!
    const readout = stage.closest('figure')?.querySelector<HTMLElement>('[data-readout]')
    const readouts = JSON.parse(stage.dataset.readouts ?? '[]') as string[]
    const cleats = svg.querySelector<SVGPathElement>('[data-cleats]')!
    const layers = {
      belt: svg.querySelector<SVGGElement>('[data-layer="belt"]')!,
      table: svg.querySelector<SVGGElement>('[data-layer="table"]')!,
      spare: svg.querySelector<SVGGElement>('[data-layer="spare"]')!,
    }
    const pieces = [...svg.querySelectorAll<SVGGElement>('[data-piece]')].sort(
      (a, b) => Number(a.dataset.piece) - Number(b.dataset.piece),
    )
    const drawers = [...svg.querySelectorAll<SVGGElement>('[data-drawer]')].map((g) => ({
      tray: g.querySelector<SVGGElement>('[data-tray]')!,
      front: g.querySelector<SVGGElement>('[data-front]')!,
      lamp: g.querySelector<SVGCircleElement>('[data-lamp]')!,
      open: 0,
      drawn: -1,
    }))
    drawers[0]!.open = S.OPEN
    drawers[0]!.drawn = S.OPEN
    const reader = svg.querySelector<SVGCircleElement>('[data-reader]')!

    let clock = Number(stage.dataset.start ?? 0)
    let selected = 0
    let order = ''

    const select = (lane: number) => {
      if (lane === selected) return
      selected = lane
      stage.setAttribute('aria-valuenow', String(lane + 1))
      stage.setAttribute('aria-valuetext', readouts[lane] ?? '')
      if (readout) readout.textContent = readouts[lane] ?? ''
    }

    const fig = live(stage, {
      tour: (step) => select(step % S.RUNS.length),
      tourEvery: 4.2,
      tick(dt, calm) {
        if (!calm) clock += dt
        // Pieces: place each, move it between the belt and table layers when
        // it changes leg, and keep each layer painted far to near.
        const belt: [number, SVGGElement][] = []
        const table: [number, SVGGElement][] = []
        pieces.forEach((el, i) => {
          const q = S.placeOf(i, clock)
          const run = S.STREAM[i]![1]
          if (run === selected) el.setAttribute('data-sel', '')
          else el.removeAttribute('data-sel')
          if (!q) {
            if (el.parentNode !== layers.spare) layers.spare.appendChild(el)
            return
          }
          el.setAttribute('transform', S.translate(q.x, q.y, q.z))
          ;(q.leg === 'belt' ? belt : table).push([S.depthOf(q.x, q.y), el])
        })
        belt.sort((a, b) => a[0] - b[0])
        table.sort((a, b) => a[0] - b[0])
        const key = belt.map(([, e]) => e.dataset.piece).join() + '|' + table.map(([, e]) => e.dataset.piece).join()
        if (key !== order) {
          order = key
          for (const [, e] of belt) layers.belt.appendChild(e)
          for (const [, e] of table) layers.table.appendChild(e)
        }
        cleats.setAttribute('d', S.cleats(clock * S.BELT_V))
        reader.dataset.on = S.underReader(clock) >= 0 ? 'lit' : ''

        // Drawers: the selected one opens, the rest close, each on its own
        // exponential follow so a quick change of mind reverses smoothly.
        let moving = false
        drawers.forEach((d, lane) => {
          const target = lane === selected ? S.OPEN : 0
          d.open = calm ? target : d.open + (target - d.open) * (1 - Math.exp(-dt / 0.22))
          if (Math.abs(target - d.open) < 0.05) d.open = target
          else moving = true
          const rounded = Math.round(d.open * 4) / 4
          if (rounded !== d.drawn) {
            d.drawn = rounded
            d.front.setAttribute('transform', S.translate(rounded, 0, 0))
            d.tray.innerHTML = S.trayAt(lane, rounded)
          }
          // A drawer's lamp lights for a moment as each of its pieces lands.
          let lit = false
          S.STREAM.forEach(([, r], i) => {
            if (r === lane && S.landedAgo(i, clock) >= 0 && S.landedAgo(i, clock) < 0.5) lit = true
          })
          d.lamp.dataset.on = lit && !calm ? 'lit' : lane === selected ? 'ok' : ''
        })
        return !calm || moving
      },
    })

    const pick = (clientX: number, clientY: number) => {
      const m = svg.getScreenCTM()
      if (!m) return
      const pt = new DOMPoint(clientX, clientY).matrixTransform(m.inverse())
      let best = 0
      let bestD = Infinity
      S.DRAWER_AT.forEach(([x, y], lane) => {
        const d = Math.hypot(pt.x - x, pt.y - y)
        if (d < bestD) {
          bestD = d
          best = lane
        }
      })
      select(best)
      fig.touch()
    }
    stage.addEventListener('pointermove', (e) => pick(e.clientX, e.clientY))
    stage.addEventListener('pointerdown', (e) => pick(e.clientX, e.clientY))
    stage.addEventListener('keydown', (e) => {
      const n = S.RUNS.length
      let to: number | null = null
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = (selected + 1) % n
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = (selected + n - 1) % n
      if (e.key === 'Home') to = 0
      if (e.key === 'End') to = n - 1
      if (to === null) return
      e.preventDefault()
      select(to)
      fig.touch()
    })
  }
</script>
