---
/**
 * A trace waterfall, drawn from the failing run in `mcpd demo`.
 *
 * Every bar is placed from the span's real offset and duration (see
 * `@/lib/specimen`), on one coordinate system with its ruler. Playing replays
 * the run: bars grow from their start time under a sweeping "now" line, and
 * the failing agent lights when the run ends. The markup is the finished run.
 */
import { SPECIMEN, SPECIMEN_TRACE, type Row } from '@/lib/specimen'
import { localeOf } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  rows?: Row[]
  class?: string
}
const { rows = SPECIMEN, class: className = '' } = Astro.props
const s = strings(localeOf(Astro.url.pathname))

const total = Math.max(...rows.map((r) => r.at + r.ms))
const pct = (n: number) => `${((n / total) * 100).toFixed(3)}%`
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(2)}s` : `${n}ms`)
const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => ({ f, label: fmt(Math.round(total * f)) }))
---

<figure class={`fig ${className}`} data-motion data-waterfall data-total={total}>
  <div class="fig-head">
    <span class="legend">{s('fig.waterfall.title')}</span>
    <span class="data text-[0.75rem] text-ink-3">{SPECIMEN_TRACE}</span>
    <span class="wf-fault annunciator ml-auto py-0.5 text-[0.625rem]" data-lit="oxide">{s('fig.waterfall.fault')}</span>
    <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">8.42 s · {rows.length} spans · $0.00055</span>
  </div>

  <div class="wf-grid border-b border-scribe-2 px-4 py-1.5">
    <span class="legend">{s('fig.live.span')}</span>
    <div class="wf-axis relative h-4">
      {ticks.map((t, i) => (
        <span
          class:list={['data absolute top-0 text-[0.625rem] text-ink-3', i % 2 === 1 && 'wf-odd']}
          style={`left:${(t.f * 100).toFixed(3)}%; transform:translateX(${i === 0 ? '0' : i === ticks.length - 1 ? '-100%' : '-50%'})`}
        >{t.label}</span>
      ))}
    </div>
    <span class="wf-metric legend text-right">{s('fig.waterfall.duration')}</span>
    <span class="wf-metric wf-wide legend text-right">{s('fig.waterfall.tokens')}</span>
    <span class="wf-metric wf-wide legend text-right">{s('fig.waterfall.cost')}</span>
  </div>

  <div class="relative">
    <ol class="m-0 list-none py-1.5" style="padding-left:0">
      {rows.map((r) => (
        <li class="wf-row wf-grid items-center px-4 py-[0.38rem]" data-kind={r.kind} data-at={r.at} data-ms={r.ms} data-error={r.status === 'error' ? '' : undefined}>
          <span class="flex min-w-0 items-center gap-2" style={`padding-left:${r.depth * 0.85}rem`}>
            <span class="h-2 w-2 shrink-0 rounded-[2px]" style="background:var(--kind)" aria-hidden="true"></span>
            <span class="data truncate text-[0.75rem] text-ink">{r.name}</span>
            {r.status === 'error' && <span class="data shrink-0 text-[0.625rem] text-oxide">error</span>}
          </span>
          <span class="wf-track relative h-[0.9rem]">
            <span class="absolute inset-y-0" style={`left:${pct(r.at)}; width:max(3px, ${pct(r.ms)})`}>
              <span
                class="wf-bar absolute inset-0 rounded-[3px]"
                style={`background:color-mix(in oklab, var(--kind) ${r.status === 'error' ? 26 : 80}%, transparent);${r.status === 'error' ? 'box-shadow: inset 0 0 0 1px var(--color-oxide)' : ''}`}
                title={`${r.name} · ${r.ms} ms`}
              ></span>
            </span>
          </span>
          <span class="wf-metric data text-right text-[0.6875rem] text-ink-3">{fmt(r.ms)}</span>
          <span class="wf-metric wf-wide data text-right text-[0.6875rem] text-ink-3">{r.tokens ?? ''}</span>
          <span class="wf-metric wf-wide data text-right text-[0.6875rem] text-ink-3">{r.cost ?? ''}</span>
        </li>
      ))}
    </ol>
    <div class="wf-now pointer-events-none absolute inset-y-0 left-0 w-px bg-accent opacity-0" aria-hidden="true"></div>
  </div>

  <figcaption class="fig-foot">
    <span class="text-ink">{s('fig.waterfall.caption')}</span>
    {' '}{s('fig.waterfall.note')}
  </figcaption>
</figure>

<style>
  /* Columns follow the figure's own width, not the viewport: in a docs column
     a wide screen still leaves the figure narrow, and the bar track is the
     thing that must keep its room. */
  [data-waterfall] { container-type: inline-size; }
  .wf-grid {
    display: grid;
    grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
    column-gap: 0.75rem;
  }
  .wf-metric { display: none; }
  @container (min-width: 520px) {
    .wf-grid { grid-template-columns: minmax(9rem, 11rem) minmax(0, 1fr) 3.5rem; }
    .wf-metric { display: block; }
    .wf-wide { display: none; }
  }
  @container (min-width: 860px) {
    .wf-grid { grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr) 3.5rem 5.5rem 4.5rem; }
    .wf-wide { display: block; }
  }
  .wf-axis { container-type: inline-size; }
  @container (max-width: 260px) { .wf-odd { display: none; } }
  .wf-bar { transform-origin: left center; }
</style>

<script>
  import { animate, each, easeOut } from '@/lib/motion'

  each('[data-waterfall]', (fig) => {
    const total = Number(fig.dataset.total)
    const rows = [...fig.querySelectorAll<HTMLElement>('.wf-row')].map((el) => ({
      el,
      at: Number(el.dataset.at),
      ms: Number(el.dataset.ms),
      bar: el.querySelector<HTMLElement>('.wf-bar')!,
    }))
    const track = fig.querySelector<HTMLElement>('.wf-track')!
    const now = fig.querySelector<HTMLElement>('.wf-now')!
    const fault = fig.querySelector<HTMLElement>('.wf-fault')!
    let left = 0
    let width = 0
    const measure = () => {
      const box = fig.getBoundingClientRect()
      const t = track.getBoundingClientRect()
      left = t.left - box.left
      width = t.width
    }
    measure()
    addEventListener('resize', measure, { passive: true })
    document.fonts?.ready.then(measure)

    const FILL = 5.5
    const CYCLE = FILL + 4
    animate(fig, (time) => {
      const k = time % CYCLE
      const u = Math.min(1, k / FILL) * total
      for (const r of rows) {
        const started = u >= r.at
        const p = Math.max(0, Math.min(1, (u - r.at) / r.ms))
        r.el.style.opacity = started ? String(0.4 + 0.6 * easeOut(Math.min(1, (u - r.at) / 200))) : '0.15'
        r.bar.style.transform = `scaleX(${p})`
      }
      const done = k >= FILL
      fault.style.visibility = done ? 'visible' : 'hidden'
      now.style.opacity = done ? '0' : '0.8'
      now.style.transform = `translateX(${left + (u / total) * width}px)`
    })
  })
</script>
