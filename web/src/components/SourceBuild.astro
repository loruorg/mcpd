---
/**
 * The two ways to start, side by side: the free hosted version, or a daemon
 * of your own built from source. Shown at the top of the pages that teach an
 * install, so a reader always has a command that works today.
 */
import Command from '@/components/Command.astro'
import { localeOf } from '@/lib/i18n'
import type { Locale } from '@/lib/locales'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const code = localeOf(Astro.url.pathname)

const TEXT: Record<Locale, { heading: string; body: string; hosted: string; label: string }> = {
  en: {
    heading: 'Start in a minute.',
    body: 'Use the free hosted version, or build your own daemon from source with Rust and Node:',
    hosted: 'Open mcpd.sh/app',
    label: 'Build and run it',
  },
  fr: {
    heading: 'Démarrez en une minute.',
    body: 'Utilisez la version hébergée gratuite, ou compilez votre propre daemon depuis les sources avec Rust et Node :',
    hosted: 'Ouvrir mcpd.sh/app',
    label: 'Compiler et lancer',
  },
  es: {
    heading: 'Empieza en un minuto.',
    body: 'Usa la versión alojada gratuita, o compila tu propio daemon desde el código fuente con Rust y Node:',
    hosted: 'Abrir mcpd.sh/app',
    label: 'Compilar y ejecutar',
  },
  zh: {
    heading: '一分钟即可开始。',
    body: '使用免费的托管版本，或者用 Rust 和 Node 从源码构建你自己的守护进程：',
    hosted: '打开 mcpd.sh/app',
    label: '构建并运行',
  },
  ja: {
    heading: '1 分で始められます。',
    body: '無料のホスト版を使うか、Rust と Node を使ってソースから自分のデーモンをビルドします。',
    hosted: 'mcpd.sh/app を開く',
    label: 'ビルドして実行',
  },
  ko: {
    heading: '1분이면 시작합니다.',
    body: '무료 호스팅 버전을 쓰거나, Rust와 Node로 소스에서 직접 데몬을 빌드하세요.',
    hosted: 'mcpd.sh/app 열기',
    label: '빌드하고 실행',
  },
  it: {
    heading: 'Inizia in un minuto.',
    body: 'Usa la versione ospitata gratuita, oppure compila il tuo daemon dai sorgenti con Rust e Node:',
    hosted: 'Apri mcpd.sh/app',
    label: 'Compila ed esegui',
  },
  tr: {
    heading: 'Bir dakikada başlayın.',
    body: 'Ücretsiz barındırılan sürümü kullanın ya da kendi daemon’unuzu Rust ve Node ile kaynaktan derleyin:',
    hosted: 'mcpd.sh/app adresini açın',
    label: 'Derleyip çalıştırma',
  },
  pt: {
    heading: 'Comece em um minuto.',
    body: 'Use a versão hospedada gratuita, ou compile o seu próprio daemon a partir do código-fonte com Rust e Node:',
    hosted: 'Abrir mcpd.sh/app',
    label: 'Compilar e executar',
  },
}
const t = TEXT[code]
---

<div class={`panel-raised not-prose ${className}`}>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4">
    <div class="min-w-0">
      <p class="text-[0.9375rem] font-medium text-ink">{t.heading}</p>
      <p class="mt-1 max-w-[62ch] text-[0.875rem] leading-relaxed text-ink-2">{t.body}</p>
    </div>
    <a href="/app" class="btn btn-primary !h-9 !text-[0.875rem]">{t.hosted}</a>
  </div>
  <div class="border-t border-scribe-2 px-5 py-4">
    <Command
      label={t.label}
      command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
    />
  </div>
</div>
