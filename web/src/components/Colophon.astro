---
/**
 * The colophon: the panel's bottom edge, stepping onto its own darker floor.
 *
 * The oversized wordmark is anchored flush to the very bottom and bleeds off it
 * deliberately, while staying whole and centred on every other edge. The links
 * and the licence sit above it, and the wordmark is on the layer above the
 * texture, not buried under it.
 */
import { SITE } from '@/lib/site'
import { localeOf, urlFor } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'

interface Props {
  /**
   * Set when the section above the footer is already on the dark floor. Without
   * it the unconditional top margin paints a band of light page between two
   * dark surfaces, which reads as a layout gap rather than a decision.
   */
  flush?: boolean
}

const { flush = false } = Astro.props

const locale = localeOf(Astro.url.pathname)
const s = strings(locale)

/* A language's own name is not translated, so the six SDK names are written
   here rather than in the string catalogue. */
const columns = [
  {
    legend: s('colophon.start'),
    links: [
      { path: '/docs/quickstart', label: s('colophon.quickstart') },
      { path: '/docs/install', label: s('colophon.install') },
      { path: '/docs/workflows', label: s('colophon.workflows') },
      { path: '/deploy', label: s('colophon.deploy') },
      { path: '/app', label: s('colophon.interface') },
    ],
  },
  {
    legend: s('colophon.instrument'),
    links: [
      { path: '/docs/sdks/typescript', label: 'TypeScript' },
      { path: '/docs/sdks/python', label: 'Python' },
      { path: '/docs/sdks/rust', label: 'Rust' },
      { path: '/docs/sdks/go', label: 'Go' },
      { path: '/docs/sdks/kotlin', label: 'Kotlin' },
      // Six SDKs ship, so six are listed. Elixir was missing here and on the
      // landing page while the docs sidebar and the conformance panel both
      // carried it, which reads as a language that was quietly dropped.
      { path: '/docs/sdks/elixir', label: 'Elixir' },
    ],
  },
  {
    legend: s('colophon.reference'),
    links: [
      { path: '/docs/reference/data-model', label: s('colophon.dataModel') },
      { path: '/docs/reference/api', label: s('colophon.api') },
      { path: '/docs/opentelemetry', label: s('colophon.otel') },
      { path: '/docs/configuration', label: s('colophon.configuration') },
    ],
  },
]

const year = new Date().getUTCFullYear()
---

<footer class:list={['relative overflow-hidden bg-floor text-floor-ink', flush ? '' : 'mt-24']}>
  {/* The floor is painted too, and carries the same fine cast texture as the
      panel so the two surfaces read as one object: the same fractal noise the
      page is cast in, never a repeating rule, which is ruled paper and aliases
      into scanlines at 1x. A touch stronger than on the panel, because the
      grain is light on dark here and reads fainter at the same opacity. */}
  <div
    class="pointer-events-none absolute inset-0 opacity-[1.6]"
    style="background-image: var(--panel-noise); mix-blend-mode: screen;"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[86rem] px-5 pt-16 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="display text-[1.375rem] leading-none tracking-[-0.03em] text-floor-ink">
          {SITE.name}
        </p>
        <p class="mt-3 max-w-[26ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
          {s('colophon.blurb')}
        </p>
        <p class="mt-5 text-[0.8125rem] text-floor-ink/85">{s('colophon.licence', { year })}</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.legend}>
            <p class="legend text-floor-ink/85">{col.legend}</p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={urlFor(l.path, locale)}
                    class="text-[0.9375rem] text-floor-ink/85 transition-colors hover:text-floor-ink"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-white/10 pt-5">
      <a
        href={SITE.repo}
        rel="noopener"
        class="text-[0.9375rem] text-floor-ink/85 transition-colors hover:text-floor-ink"
        >{s('colophon.source')}</a
      >
      <a
        href={`${SITE.repo}/blob/main/AGENTS.md`}
        rel="noopener"
        class="text-[0.9375rem] text-floor-ink/85 transition-colors hover:text-floor-ink"
        >{s('colophon.contributing')}</a
      >
      <p class="ml-auto text-[0.8125rem] text-floor-ink/72">
        {s('colophon.promise')}
      </p>
    </div>
  </div>

  {/* The signature. Flush to the bottom edge with nothing beneath it, bleeding
      off that one edge on purpose while every glyph stays whole above. The
      generous tracking is what keeps it a composition rather than big text. */}
  <div class="relative mt-10 select-none" aria-hidden="true">
    {/* `letter-spacing` adds a trailing space after the final glyph, and
        `text-align: center` centres the line box including it, which pushed the
        word half a letter-space left of true centre. The negative right margin
        cancels exactly that. */}
    <p
      class="display translate-y-[0.16em] whitespace-nowrap text-center leading-[0.78] !text-white/[0.14]"
      style="font-size: clamp(5rem, 21vw, 19rem); letter-spacing: 0.06em; margin-right: -0.06em;"
    >
      {SITE.name}
    </p>
  </div>
</footer>
