---
import '@/styles/panel.css'
import { SITE } from '@/lib/site'
import { localeOf, routeOf, urlFor, locale, localesWithPage, DEFAULT_LOCALE } from '@/lib/i18n'
import { strings } from '@/lib/ui-strings'
import Rail from '@/components/Rail.astro'
import Colophon from '@/components/Colophon.astro'

interface Props {
  title: string
  description: string
  /** Path of the share image under /og/, without extension. */
  og?: string
  /** Set on the operator UI so search engines leave it alone. */
  noindex?: boolean
  /** Adds Article structured data on documentation pages. */
  kind?: 'website' | 'article' | 'software'
  /** ISO date the page's content last changed, for article metadata. */
  updated?: string
  /** Set when the page's last section already sits on the dark floor. */
  flushFooter?: boolean
}

const {
  title,
  description,
  og = 'default',
  noindex = false,
  kind = 'website',
  updated,
  flushFooter = false,
} = Astro.props

/* Language. The page's own locale decides the `lang` attribute, and `title` and
   `description` still arrive as props, so a translated page supplies translated
   text and the head follows it with no special case. */
const code = localeOf(Astro.url.pathname)
const here = locale(code)
const route = routeOf(Astro.url.pathname)

const absolute = (path: string) => new URL(path, SITE.url).href.replace(/\/$/, '') || SITE.url

/* Canonical points at this locale's own URL, never at English. Built from the
   same helper as the alternates below, so the two cannot disagree about where a
   translation lives. */
const canonical = absolute(urlFor(route, code))

/* Alternates, and only for locales that have actually been written. A page
   translated into three languages lists three; one that exists only in English
   lists none at all, because a self-referencing alternate says nothing and an
   alternate pointing at an unwritten page points at a 404. `x-default` names
   English, which is the copy a reader lands on when nothing matches them. */
const translations = localesWithPage(route)
const alternates =
  translations.length > 1
    ? translations.map((c) => ({ tag: locale(c).tag, href: absolute(urlFor(route, c)) }))
    : []
const xDefault = alternates.length > 0 ? absolute(urlFor(route, DEFAULT_LOCALE)) : undefined

/* The skip link is the first thing a keyboard reader reaches, so it is read
   from the catalogue like the rest of the chrome rather than left in English. */
const s = strings(code)

const ogImage = new URL(`/og/${og}.png`, SITE.url).href
const fullTitle = title === SITE.name ? `${SITE.name} · ${SITE.tagline}` : `${title} · ${SITE.name}`

/* Structured data. Only claims that are true: mcpd is free and open source,
   so `offers` is priced at zero rather than omitted, and no rating, review or
   organisation is asserted because none exists. */
const structured =
  kind === 'software'
    ? {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: SITE.name,
        description: SITE.description,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS, Windows',
        url: SITE.url,
        codeRepository: SITE.repo,
        license: `https://spdx.org/licenses/${SITE.licence}.html`,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      }
    : kind === 'article'
      ? {
          '@context': 'https://schema.org',
          '@type': 'TechArticle',
          headline: title,
          description,
          url: canonical,
          ...(updated ? { dateModified: updated } : {}),
          isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
        }
      : {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: SITE.name,
          url: SITE.url,
          description: SITE.description,
        }
---

<!doctype html>
<html lang={here.tag} dir={here.dir === 'ltr' ? undefined : here.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => <link rel="alternate" hreflang={a.tag} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    {/* The theme, before anything paints. A reader who chose one with the
        theme control gets it on the first frame; everyone else gets their
        system's, through `color-scheme: light dark` in panel.css, with no
        script needed at all. Inline and tiny on purpose: an external file
        would arrive after the first paint and flash the wrong theme. */}
    <script is:inline>
      try {
        var t = localStorage.getItem('mcpd:theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    {/* The Latin faces carry the brand in every locale. Nothing is preloaded
        for Chinese, Japanese or Korean: those systems already ship good faces. */}
    <link rel="preload" href="/fonts/supreme.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={kind === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} · ${SITE.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>

  <body>
    <!--
      mcpd, direction contract

      THESIS: the unopinionated agent observatory. Any agent, any framework,
      any language, any model provider, seen in one place. The page shows the
      product working, not a metaphor for it.

      WORLD: calm neutral surfaces with a faint green cast, hairline edges,
      one brand green, signal colours that name span kinds. Light and dark are
      one token set (light-dark pairs). Figures are stylised, live product UI:
      a waterfall filling, spans arriving from many frameworks, a cost meter,
      a workflow surviving a crash.

      FIRST VIEWPORT: the claim and two actions (start free, self-host) beside
      a live trace that fills from several frameworks at once.

      RULES: no gradient text, no glow, no icon tiles, no stock logos, no
      invented numbers. Content is visible without animation; every figure
      pauses off-screen and respects reduced motion.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-panel-3 focus:px-4 focus:py-2 focus:text-ink"
      >{s('base.skipToContent')}</a
    >
    <Rail />
    <main id="main">
      <slot />
    </main>
    <Colophon flush={flushFooter} />
  </body>
</html>
