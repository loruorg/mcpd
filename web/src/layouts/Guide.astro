---
/**
 * A task guide: the documentation layout, with the guide's structured data, the
 * date it was last checked, links to the guides beside it, and one way to start.
 *
 * Everything that names the guide (title, description, reading order) is read
 * from `@/lib/guides` by slug, so a page cannot drift from the index that
 * lists it.
 */
import Doc from '@/layouts/Doc.astro'
import { GUIDES_PATH, GUIDES_UPDATED, guide, guideNeighbours, guidePath, guideSchema } from '@/lib/guides'

interface Props {
  slug: string
  /** One sentence under the H1. */
  lede: string
  /** Two to four other guides, by slug. */
  related: string[]
  /** The closing call to action. Defaults to the hosted mcpd. */
  cta?: 'hosted' | 'self-host'
}

const { slug, lede, related, cta = 'hosted' } = Astro.props
const g = guide(slug)
const near = related.map(guide)
---

<Doc
  title={g.title}
  headTitle={g.short}
  description={g.description}
  lede={lede}
  updated={GUIDES_UPDATED}
  stamp
  schema={guideSchema(g)}
  section={GUIDES_PATH}
  pager={guideNeighbours(slug)}
>
  <slot />

  <h2>Related guides</h2>
  <ul>
    {
      near.map((r) => (
        <li>
          <a href={guidePath(r.slug)} class="link">
            {r.title}
          </a>
        </li>
      ))
    }
  </ul>

  {
    cta === 'self-host' ? (
      <p>
        mcpd is free and open source, one binary with its storage built in.{' '}
        <a href="/docs/quickstart" class="link">
          Run it with the Quickstart
        </a>{' '}
        and point your agent at it.
      </p>
    ) : (
      <p>
        mcpd is free and open source.{' '}
        <a href="/app" class="link">
          Start free at mcpd.sh
        </a>
        , or run the daemon yourself.
      </p>
    )
  }
</Doc>
