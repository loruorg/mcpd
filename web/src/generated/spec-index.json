  "spanKinds": [
    {
      "name": "agent_run",
      "doc": "One agent invocation. Usually the root of a trace."
    },
    {
      "name": "model_generation",
      "doc": "One logical generation: everything from the first request to the final answer, including every intermediate step."
    },
    {
      "name": "model_step",
      "doc": "One step inside a generation. A generation that calls tools twice has three steps."
    },
    {
      "name": "model_inference",
      "doc": "The provider round-trip alone, excluding processors and tool execution. Measure pure model latency here."
    },
    {
      "name": "model_chunk",
      "doc": "A single streamed chunk. Recorded as an event, not a duration."
    },
    {
      "name": "tool_call",
      "doc": "A tool your code executes."
    },
    {
      "name": "client_tool_call",
      "doc": "A tool the calling client executes. The server records the marker; the client returns the detail."
    },
    {
      "name": "provider_tool_call",
      "doc": "A tool the model provider executes server-side, such as hosted web search or code execution."
    },
    {
      "name": "mcp_tool_call",
      "doc": "A tool reached over the Model Context Protocol."
    },
    {
      "name": "handoff",
      "doc": "Control passing from one agent to another. The span's name is the agent handed to; its parent is the agent handing off."
    },
    {
      "name": "workflow_run",
      "doc": "One workflow execution. Usually the root of a trace."
    },
    {
      "name": "workflow_step",
      "doc": "One step within a workflow."
    },
    {
      "name": "workflow_conditional",
      "doc": "A branch point, with the conditions it evaluated."
    },
    {
      "name": "workflow_conditional_eval",
      "doc": "One condition evaluated inside a branch point."
    },
    {
      "name": "workflow_parallel",
      "doc": "A fan-out of concurrent branches."
    },
    {
      "name": "workflow_loop",
      "doc": "A loop construct: foreach, do-while or do-until."
    },
    {
      "name": "workflow_sleep",
      "doc": "A deliberate pause."
    },
    {
      "name": "workflow_wait_event",
      "doc": "A wait for an external event, with its timeout."
    },
    {
      "name": "memory_operation",
      "doc": "A read from or write to agent memory."
    },
    {
      "name": "rag_ingestion",
      "doc": "One ingestion pipeline run: load, chunk, extract, embed, upsert."
    },
    {
      "name": "rag_embedding",
      "doc": "One embedding call, possibly batched."
    },
    {
      "name": "rag_vector_operation",
      "doc": "Vector store I/O: query, upsert, delete or fetch."
    },
    {
      "name": "rag_action",
      "doc": "A RAG-specific transform: chunk, extract metadata or rerank."
    },
    {
      "name": "graph_action",
      "doc": "A graph build, traverse, update or prune."
    },
    {
      "name": "processor_run",
      "doc": "An input or output processor."
    },
    {
      "name": "scorer_run",
      "doc": "One scorer evaluating a target."
    },
    {
      "name": "scorer_step",
      "doc": "One stage of a scorer's pipeline."
    },
    {
      "name": "guardrail",
