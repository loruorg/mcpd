---
import BlogIndex from '@/components/blog/BlogIndex.astro'
import { PAGE_SIZE, allPosts } from '@/lib/blog'

/* Page 1 is `/blog` itself, so this route builds pages 2 and up, and none at
   all until there are more than PAGE_SIZE posts. */
export async function getStaticPaths() {
  const pages = Math.ceil((await allPosts()).length / PAGE_SIZE)
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({ params: { page: String(i + 2) } }))
}

const page = Number(Astro.params.page)
---

<BlogIndex page={page} />
