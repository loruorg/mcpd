---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* Internal links stay written as English routes and are localised here. A
   route whose French page is not written yet resolves to the English page
   rather than to a French URL with nothing behind it. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)
---

<Base
  title="Exécutions durables et observabilité pour agents, en un seul binaire"
  description="Un daemon libre et open source pour agents IA. Il conserve un workflow entre les étapes ; votre code travaille dans chacune, en tout langage, et chaque étape devient une trace avec son coût."
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">
          Chaque étape de votre agent, tenue jusqu’au bout et consignée.
        </h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">
          mcpd est un daemon, pas un framework. Il conserve une exécution entre
          les étapes : les nouvelles tentatives, les timers, l’attente d’une
          approbation qui dure une semaine, pendant que votre propre code fait
          le travail à l’intérieur de chaque étape, dans n’importe quel langage.
          Chaque étape arrive dans une trace, avec ce qu’elle a coûté.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">Latence du modèle</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">trace d’exemple</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="Compiler et lancer"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">
          Ouvrez ensuite <span class="data text-ink">localhost:4317</span>. Pas de
          compte, pas de base de données à monter, rien à signer. Aucune version
          publiée pour l’instant : l’image et les paquets arriveront avec la
          première.
          <a href={url('/docs/quickstart')} class="link ml-1"
            >Lisez la prise en main en cinq minutes</a
          >.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Une exécution qui se lit.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Un agent qui échoue n’échoue pas dans la ligne de log qui mentionne
          l’erreur. Il échoue trois étapes plus tôt, quand le modèle a choisi le
          mauvais outil, puis l’a choisi de nouveau.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          mcpd reconstitue l’exécution entière sous forme d’arbre : chaque appel
          de modèle, chaque appel d’outil, chaque récupération, avec le prompt et
          la complétion exacts attachés à chacun, la latence de chacun, et ce que
          chacun a coûté.
        </p>
        <p class="mt-6">
          <a href={url('/app')} class="link">Ouvrir l’interface</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Une exécution qui survit au processus qui l’a lancée.
      </h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">
        Le daemon détient l’exécution entre les étapes. Votre processus détient
        tout ce qui se passe à l’intérieur d’une étape, et ne cède rien : ni le
        modèle, ni le prompt, ni un secret.
      </p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Le graphe est une donnée, les corps sont à vous
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un workflow s’écrit une fois, en code. Le graphe part vers le daemon
          comme une définition qu’il valide et versionne. Les corps des étapes
          restent dans votre processus, dans l’un des six langages, servis par un
          worker.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Les nouvelles tentatives, les timers et les attentes sont des lignes
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Une défaillance passagère donne lieu à une nouvelle tentative, sur le
          budget propre à l’étape. Une mise en veille ou une attente d’approbation
          retient l’exécution sans qu’aucun processus ne tourne : elle survit à un
          déploiement, à un plantage ou à une semaine entière. Un événement répond à
          l’attente par nom et par clé, et un événement répété est un doublon, pas
          une seconde exécution.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Chaque exécution est une trace</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Chaque étape est un span avec son entrée, sa sortie et la consommation
          qu’elle a déclarée, tarifée avec la grille qui tarife tous les autres
          spans. L’appel de modèle effectué à l’intérieur d’une étape se place sous
          elle, si bien que la recherche, le coût et les scorers travaillent sur une
          exécution sans rien y changer.
        </p>
      </div>
    </div>
    <p class="mt-8">
      <a href={url('/docs/workflows')} class="link">Lire la page sur les workflows</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
          Instrumentez dans le langage que vous écrivez déjà.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Six SDK, un seul comportement. Enregistrer un span ne bloque jamais, ne
          lève jamais d’exception et ne grossit jamais sans limite : si mcpd est
          injoignable, votre agent ne s’en aperçoit pas, c’est la seule défaillance
          acceptable pour de l’observabilité. Chacun porte aussi un worker, si bien
          que les étapes d’une exécution durable sont servies par le processus même
          qui les enregistre.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          Aucun n’est obligatoire. Pointez <span class="data text-ink"
            >OTEL_EXPORTER_OTLP_ENDPOINT</span
          > vers mcpd et un SDK OpenTelemetry que vous exécutez déjà l’atteint, sans
          une ligne de notre code dans votre application. Les six sont une facilité
          posée sur une surface HTTP, pas une condition pour être enregistré.
        </p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">
          Une observabilité livrée avec un framework ne sait enregistrer que les
          agents bâtis avec ce framework. mcpd prend tout ce qui atteint son
          endpoint OTLP : un framework d’agents, une boucle que vous avez écrite
          vous-même, ou les services que l’un ou l’autre appelle.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={url('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={url('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={url('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={url('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={url('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={url('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="instrumenter une exécution" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Six signaux, corrélés par l’exécution qui les a produits.
    </h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">
      La plupart des outils vous donnent les traces ici et les logs ailleurs,
      puis vous laissent apparier les horodatages à l’œil. mcpd range les six
      signaux sous les mêmes identifiants de trace et de span : un pic sur un
      graphique ouvre l’exécution qui l’a causé, et une exécution montre les
      lignes de log qu’elle a émises.
    </p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. It reads as a numeral in French because the
        spelling helper writes English words. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Les {CHANNELS.length} langages s’accordent.
    </h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Chaque SDK est testé isolément, ce qui prouve que chacun fait ce que ses
        auteurs voulaient et ne dit rien de leur accord entre eux. Chacun écrit
        donc la même exécution vers un seul daemon, et les traces sont relues
        puis comparées entre elles.
      </p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Un comportement qui tient dans un langage et pas dans un autre se voit
        là et nulle part ailleurs. Cela tourne en CI à chaque changement.
        <a href={url('/docs/from-mastra')} class="link ml-1">Comment mcpd se compare</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Qui a lu quoi, y compris qui s’est vu refuser l’accès.
      </h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">
        La question qui décide d’une revue de sécurité n’est pas de savoir si les
        données sont à l’abri. C’est de savoir si vous pouvez montrer, après
        coup, qui les a atteintes.
      </p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Six portées de clé</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Émettre de la télémétrie, lire des prompts, modifier des données
          stockées, les détruire, démarrer des exécutions et réclamer des étapes
          sont des privilèges distincts. Une liste write non définie accepte les
          clés d’ingestion, et une liste admin non définie accepte les clés de
          lecture. Des listes execute et worker non définies acceptent les clés
          d’écriture. Une mise à jour ne vous ferme pas l’accès.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Un projet est une frontière</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Les clés, la conservation et l’échantillonnage se règlent par projet. Une
          clé inscrite sous un projet atteint ce projet, et le daemon établit à qui
          appartient un dataset avant d’en renvoyer le moindre cas.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Rien n’appelle l’extérieur</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Le daemon entier compte quatre endroits d’où part une requête sortante,
          et vous les configurez tous les quatre : le transfert, deux webhooks et
          le juge. Il n’y a pas de vérification de mise à jour, pas de
          télémétrie et pas de serveur de licences.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Quelle clé, et quelle personne</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Le journal nomme la clé. Donnez à mcpd l’en-tête que votre ingress définit
          déjà, et les adresses autorisées à le définir, et il nomme aussi la
          personne. Envoyé depuis ailleurs, un en-tête est une affirmation que
          n’importe qui pourrait faire : la ligne reste vide plutôt que de porter
          une supposition.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Une demande de suppression tient en un appel
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un seul DELETE retire toutes les exécutions enregistrées pour une
          personne, avec les spans, logs, métriques, scores et feedback qui en
          dépendent, et répond par un décompte signal par signal. Les lignes d’un
          projet que cette clé ne peut pas ouvrir ne sont ni touchées ni
          comptées.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Vérifiez avant de faire confiance
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          <span class="data text-ink">mcpd doctor</span> note un déploiement :
          si le stockage accepte une écriture et la restitue, si une portée est
          restée ouverte, si un projet configuré a déjà reçu un span. Tout ce sur
          quoi il vous demande d’agir nomme l’indicateur qui le corrige.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">
            Cinq minutes jusqu’à votre première trace.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
            Lancez le daemon, pointez votre agent vers lui, ouvrez l’interface.
            Si cela prend plus longtemps, c’est un bug et le rapport nous
            intéresse.
          </p>
        </div>
        <Command
          variant="floor"
          label="Démarrer"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: 'Depuis les sources', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
