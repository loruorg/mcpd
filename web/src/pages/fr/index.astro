---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const description =
  'Observabilité libre et open source pour agents IA. Tout framework, langage ' +
  'ou fournisseur de modèles, via OpenTelemetry ou six SDK. Hébergez un seul binaire, ' +
  'ou utilisez-le gratuitement sur mcpd.sh.'

const copy: HomeCopy = {
  h1: 'L’observatoire d’agents sans parti pris.',
  lede:
    'Voyez chaque exécution de chaque agent que vous livrez : chaque appel au modèle, ' +
    'chaque appel d’outil et chaque recherche, avec son prompt, sa réponse et son coût. ' +
    'Tout framework, tout langage, tout fournisseur de modèles. Rien à adopter.',
  startFree: 'Commencer gratuitement',
  selfHost: 'L’héberger soi-même',
  heroNote: 'Hébergé gratuitement avec toutes les fonctions, ou un binaire open source sur votre propre machine.',

  worksTitle: 'Compatible avec ce que vous utilisez déjà.',
  worksBody:
    'mcpd reçoit OpenTelemetry et lit les conventions OpenTelemetry comme OpenInference ' +
    'pour les appels aux modèles : l’instrumentation qui existe déjà pour votre stack ' +
    'fonctionne telle quelle. Votre agent garde son framework, et vous gardez votre code.',
  otelLabel: 'Pointez n’importe quel exportateur OpenTelemetry vers mcpd',
  sdkLead: 'Ou ajoutez un SDK :',
  frameworksLegend: 'Frameworks d’agents',
  providersLegend: 'Fournisseurs de modèles',
  ownLoop: 'Votre propre boucle',

  seeTitle: 'Chaque étape, avec les preuves.',
  seeBody:
    'Une exécution est un arbre d’appels aux modèles, d’appels d’outils et de recherches. ' +
    'Ouvrez n’importe quelle étape pour lire le prompt et la réponse exacts, les tokens ' +
    'utilisés et le coût. La recherche retrouve une exécution par ce que le modèle a dit, ' +
    'et chaque ligne de log renvoie à l’étape qui l’a écrite.',
  seeFacts: [
    'Une cascade de chaque exécution, sur une seule horloge',
    'La conversation complète, appels d’outils compris',
    'Le coût par exécution, par modèle et par projet',
    'Logs, métriques et traces reliés par l’identifiant de trace',
  ],
  openInterface: 'Ouvrir l’interface',

  flowTitle: 'Des workflows qui survivent à un crash.',
  flowBody:
    'Écrivez les étapes dans votre propre code, dans l’un des six langages. mcpd conserve ' +
    'l’exécution entre elles : nouvelles tentatives, timers, et attentes d’un événement ' +
    'qui peut prendre une semaine. Si un worker meurt en pleine étape, un autre la reprend.',
  flowNotes: [
    ['Votre code exécute chaque étape', 'Le daemon ne voit jamais ni modèle, ni prompt, ni identifiant. Les workers réclament une étape à la fois.'],
    ['Attendre ne retient aucun processus', 'Une pause ou l’attente d’une approbation conserve l’exécution sans aucun processus actif, pendant un déploiement ou une semaine.'],
    ['Chaque exécution est une trace', 'Chaque étape est un span avec son entrée, sa sortie et son coût : la recherche et l’évaluation marchent aussi sur les exécutions.'],
  ],
  flowLink: 'Lire la page sur les workflows',

  evalTitle: 'Sachez quand la qualité baisse.',
  evalBody:
    'Évaluez chaque exécution avec treize évaluateurs intégrés ou avec un modèle comme juge. ' +
    'Transformez les exécutions de production en jeux de données et comparez des expériences. ' +
    'Les moniteurs surveillent le taux d’erreur, la latence, le coût et les scores, et ' +
    'appellent votre webhook quand l’un d’eux bouge.',
  evalLink: 'Évaluation',
  alertLink: 'Moniteurs et alertes',

  deployTitle: 'Faites-le tourner partout.',
  deployBody:
    'Un seul binaire, avec le stockage et l’interface intégrés. SQLite sur un portable, ' +
    'Postgres ou ClickHouse pour une équipe, Docker ou Kubernetes en production. Pas de ' +
    'télémétrie, pas de serveur de licences.',
  deployLink: 'Guide de déploiement',
  targets: [
    ['Hébergé', 'Gratuit sur mcpd.sh, avec toutes les fonctions. Inscrivez-vous et envoyez votre première trace.'],
    ['Votre portable', 'Un processus et un fichier SQLite. Rien d’autre à installer.'],
    ['Docker', 'Un conteneur, un volume, un port.'],
    ['Kubernetes', 'Un chart Helm, avec Postgres ou ClickHouse derrière et des clés par projet.'],
  ],
  ownLabel: 'Hébergez le vôtre',
  fromSource: 'Depuis les sources',

  closeTitle: 'Votre première trace en cinq minutes.',
  closeBody: 'Inscrivez-vous gratuitement, ou lancez-le sur votre propre machine. Le même produit dans les deux cas.',
}
---

<Base title="L’observatoire d’agents sans parti pris" description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
