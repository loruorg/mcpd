---
import Doc from '@/layouts/Doc.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'
import { localeOf, urlFor } from '@/lib/i18n'

const locale = localeOf(Astro.url.pathname)

const exporterEnv = `# L’URL de base. Votre exporter y ajoute lui-même /v1/traces.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# http/protobuf, http/json et grpc fonctionnent tous sur ce seul port.
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Facultatif. Envoyez du gzip si vos payloads sont volumineux.
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Seulement quand mcpd tourne avec --ingest-key.
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer YOUR_INGEST_KEY"`

const rawPost = `curl -X POST http://localhost:4317/v1/traces \\
  -H 'content-type: application/json' \\
  -d '{
  "resourceSpans": [{
    "resource": { "attributes": [
      { "key": "service.name", "value": { "stringValue": "checkout-agent" } }
    ]},
    "scopeSpans": [{
      "spans": [{
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "name": "chat gpt-4o",
        "startTimeUnixNano": "1700000000000000000",
        "endTimeUnixNano": "1700000001500000000",
        "status": { "code": 1 },
        "attributes": [
          { "key": "gen_ai.system", "value": { "stringValue": "openai" } },
          { "key": "gen_ai.request.model", "value": { "stringValue": "gpt-4o" } },
          { "key": "gen_ai.operation.name", "value": { "stringValue": "chat" } },
          { "key": "gen_ai.usage.input_tokens", "value": { "intValue": "1200" } },
          { "key": "gen_ai.usage.output_tokens", "value": { "intValue": "350" } }
        ]
      }]
    }]
  }]
}'

# {"partialSuccess":{"rejectedSpans":0,"errorMessage":""}}`

const grpcEnv = `# gRPC sur le même port. Pas de chemin : l’exporter nomme lui-même le service.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Seulement quand mcpd tourne avec --ingest-key. Les clés de métadonnées gRPC sont en minuscules.
export OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer YOUR_INGEST_KEY"`

const collectorYaml = `# Un OpenTelemetry Collector qui transmet tout à mcpd en gRPC.
receivers:
  otlp:
    protocols: { grpc: {}, http: {} }

exporters:
  otlp:
    endpoint: mcpd.internal:4317
    compression: gzip
    tls:
      insecure: true # mcpd sert en clair ; terminez le TLS devant lui
    headers:
      authorization: Bearer \${env:MCPD_INGEST_KEY}

service:
  pipelines:
    traces: { receivers: [otlp], exporters: [otlp] }
    logs: { receivers: [otlp], exporters: [otlp] }
    metrics: { receivers: [otlp], exporters: [otlp] }`

const zipkinEnv = `# Un SDK OpenTelemetry qui exporte au format Zipkin.
export OTEL_TRACES_EXPORTER=zipkin
export OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:4317/api/v2/spans

# Un reporter Zipkin prend la même URL comme endpoint, par exemple
#   URLConnectionSender.create("http://localhost:4317/api/v2/spans")`

const zipkinPost = `curl -X POST http://localhost:4317/api/v2/spans \\
  -H 'content-type: application/json' \\
  -d '[{
  "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
  "id": "00f067aa0ba902b7",
  "kind": "CLIENT",
  "name": "chat gpt-4o",
  "timestamp": 1700000000000000,
  "duration": 1500000,
  "localEndpoint": { "serviceName": "checkout-agent" },
  "tags": { "gen_ai.system": "openai", "gen_ai.request.model": "gpt-4o" }
}]'

# HTTP 202 {"accepted":1,"rejected":0,"duplicate":0}`

const jaegerEnv = `# Une bibliothèque cliente Jaeger, qui envoie du Thrift sur HTTP.
export JAEGER_ENDPOINT=http://localhost:4317/api/traces

# Tout ce qui parle l’API gRPC du collecteur Jaeger, comme jaeger-agent.
jaeger-agent --reporter.grpc.host-port=localhost:4317`
---

<Doc
  title="OpenTelemetry"
  description="mcpd accepte OTLP sur HTTP et sur gRPC, Zipkin v2 et Jaeger sur un seul port, et lit aussi bien les conventions sémantiques gen_ai.* d’OpenTelemetry que les llm.* d’OpenInference. Aucun code propre à mcpd."
  lede="Si votre agent émet déjà de l’OpenTelemetry, du Zipkin ou du Jaeger, mcpd est un changement d’endpoint. Cette page couvre tout le chemin : les endpoints, les encodages, et chaque attribut que mcpd lit."
  og="docs"
>
  <h2>Les endpoints</h2>
  <p>
    mcpd sert OTLP sur HTTP et sur gRPC, Zipkin et Jaeger sur le même port que
    son API de requête et son interface. Il n’y a pas de collecteur à faire
    tourner devant, pas de second conteneur, et pas de port de réception séparé.
    Le port accepte HTTP/1.1 et HTTP/2 en clair côte à côte, et un appel gRPC
    est une requête HTTP/2, donc une seule adresse sert tous les protocoles
    ci-dessous.
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Endpoint</th>
          <th>Accepte</th>
          <th>Répond avec</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>POST /v1/traces</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partialSuccess.rejectedSpans</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/logs</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedLogRecords</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/metrics</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedDataPoints</code></td>
        </tr>
        <tr>
          <td>gRPC <code>TraceService/Export</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partial_success.rejected_spans</code></td>
        </tr>
        <tr>
          <td>gRPC <code>LogsService/Export</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partial_success.rejected_log_records</code></td>
        </tr>
        <tr>
          <td>gRPC <code>MetricsService/Export</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partial_success.rejected_data_points</code></td>
        </tr>
        <tr>
          <td><code>POST /api/v2/spans</code></td>
          <td>des spans Zipkin v2, en JSON ou en proto3</td>
          <td><code>202</code> avec <code>accepted</code> et <code>rejected</code></td>
        </tr>
        <tr>
          <td><code>POST /api/traces</code></td>
          <td>un lot Jaeger en Thrift binaire</td>
          <td><code>202</code> avec <code>accepted</code> et <code>rejected</code></td>
        </tr>
        <tr>
          <td>gRPC <code>jaeger.api_v2.CollectorService/PostSpans</code></td>
          <td><code>PostSpansRequest</code></td>
          <td><code>PostSpansResponse</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Chaque export OTLP réussi répond avec la forme
    <code>partialSuccess</code> propre à OTLP. Quand quelque chose a été refusé,
    elle porte le décompte et la raison. C’est ainsi qu’un collecteur dit à un
    émetteur qu’il a laissé tomber quelque chose, et les exporters le lisent. La
    réponse arrive dans l’encodage de l’export : protobuf pour du protobuf, JSON
    pour du JSON.
  </p>

  <h2>Y pointer un exporter</h2>
  <p>
    Deux variables font le travail. Posez-les dans l’environnement du processus
    qui fait tourner votre agent, et rien d’autre ne change.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exporter"
    samples={[{ lang: 'curl', label: 'Environnement', shiki: 'bash', code: exporterEnv }]}
  />

  <p>
    Deux détails valent d’être connus avant de déboguer un silence. D’abord,
    <code>OTEL_EXPORTER_OTLP_ENDPOINT</code> est une URL de base, à laquelle
    l’exporter ajoute lui-même le chemin du signal. Posez plutôt
    <code>OTEL_EXPORTER_OTLP_TRACES_ENDPOINT</code> si vous voulez donner l’URL
    complète, chemin compris. Ensuite, le port 4317 est par convention le port
    gRPC dans OpenTelemetry, et 4318 le port HTTP. mcpd sert les deux sur 4317,
    parce qu’il sert tout sur un seul port. Un exporter réglé sur
    <code>grpc</code> le trouve sur son port par défaut ; un exporter HTTP
    laissé sur son défaut émet vers 4318, donc nommez le port.
  </p>

  <h2>OTLP sur gRPC</h2>
  <p>
    Les trois services de collecte OTLP sont servis sur le même port :
    <code>opentelemetry.proto.collector.trace.v1.TraceService</code>,
    <code>logs.v1.LogsService</code> et <code>metrics.v1.MetricsService</code>.
    Réglez le protocole de l’exporter sur <code>grpc</code> et gardez
    l’endpoint :
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exporter grpc"
    samples={[{ lang: 'curl', label: 'Environnement', shiki: 'bash', code: grpcEnv }]}
  />

  <p>
    Un appel gRPC suit exactement la route de la porte HTTP correspondante : le
    même contrôle de clé, le même projet pour la clé d’un compte, les mêmes
    plafonds, le même échantillonnage, le même caviardage et le même calcul du
    coût, et la même reconnaissance d’un export renvoyé. La clé va dans les
    métadonnées de l’appel en <code>authorization: Bearer</code>, ou en
    <code>x-mcpd-key</code>. Un appel refusé se termine avec le statut gRPC sur
    lequel un exporter agit : <code>UNAUTHENTICATED</code> pour une clé
    absente ou inconnue, <code>PERMISSION_DENIED</code> pour une clé sans le
    droit d’ingestion, <code>INVALID_ARGUMENT</code> pour un message qui ne se
    décode pas, <code>RESOURCE_EXHAUSTED</code> au-delà d’une limite, et
    <code>UNAVAILABLE</code> quand le stockage ne peut pas prendre l’écriture,
    ce que les exporters réessaient. Une méthode que mcpd ne sert pas répond
    <code>UNIMPLEMENTED</code>.
  </p>
  <p>
    Les messages peuvent être compressés en gzip
    (<code>grpc-encoding: gzip</code>). Le listener parle HTTP/2 en clair. Pour
    servir gRPC sur TLS, terminez le TLS dans un proxy et transmettez du HTTP/2
    à mcpd ; le proxy doit garder HTTP/2 sur le saut vers le démon, parce
    que gRPC ne tourne pas sur HTTP/1.1.
  </p>
  <p>
    Un OpenTelemetry Collector transmet à mcpd avec son exporter OTLP :
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="collector"
    samples={[{ lang: 'curl', label: 'YAML', shiki: 'yaml', code: collectorYaml }]}
  />

  <h2>Les deux encodages, pour chaque signal</h2>
  <p>
    <code>/v1/traces</code>, <code>/v1/logs</code> et <code>/v1/metrics</code>
    lisent l’en-tête <code>content-type</code> et acceptent l’un ou l’autre
    encodage : OTLP/protobuf quand il contient <code>protobuf</code>,
    OTLP/JSON sinon. Protobuf est le défaut d’OpenTelemetry, donc un SDK non
    modifié pointé sur mcpd envoie les trois signaux, et ils arrivent sans
    aucune configuration. Le même export stocke les mêmes enregistrements dans
    l’un ou l’autre encodage, jusqu’aux identifiants par lesquels un renvoi est
    reconnu.
  </p>

  <p>
    Quand aucun <code>content-type</code> n’est envoyé, mcpd suppose
    <code>application/json</code>.
  </p>

  <h2>Compression et taille</h2>
  <p>
    Le corps d’une requête peut arriver avec <code>content-encoding: gzip</code>,
    avec <code>identity</code>, ou sans en-tête d’encodage. Tout le reste est
    refusé nommément : <code>content-encoding "br" is not supported; use gzip or
    send the body uncompressed</code>. Les réponses sont compressées par
    négociation de contenu, donc une grosse trace relue sur un lien lent l’est
    aussi.
  </p>
  <p>
    Deux limites s’appliquent à une même requête. La limite de corps est de
    32 MiB et se mesure sur ce qui arrive, donc gzip vous achète de la marge. La
    limite de lot est de 10 000 signaux, comptés après décodage à chaque porte
    d’ingestion : les spans sur <code>/v1/traces</code>,
    <code>/api/v2/spans</code>, <code>/api/traces</code> et leurs services
    gRPC, les enregistrements sur <code>/v1/logs</code>, les points de données
    sur <code>/v1/metrics</code> et tout ce que contient la requête sur
    <code>/v1/ingest</code>. Un corps ou un message gzip est aussi tenu à la
    limite de corps une fois décompressé. Un lot plus grand est refusé par <code>413 payload_too_large</code>, qui nomme les deux
    nombres. Les deux limites sont des réglages :
    <code>--max-body-bytes</code> et <code>--max-batch-signals</code>, décrits
    dans <a href={urlFor('/docs/configuration', locale)} class="link">Configuration</a>.
  </p>

  <h2>Zipkin</h2>
  <p>
    <code>POST /api/v2/spans</code> est l’endpoint de spans v2 de Zipkin. Il
    prend un tableau JSON de spans, ou un <code>ListOfSpans</code> proto3 quand
    le <code>content-type</code> contient <code>protobuf</code>, encodé en gzip
    ou non, et répond <code>202</code>. Pointez-y un reporter Zipkin ou
    l’exporter Zipkin d’un SDK OpenTelemetry :
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exporter zipkin"
    samples={[{ lang: 'curl', label: 'Environnement', shiki: 'bash', code: zipkinEnv }]}
  />

  <CodeSwitcher
    class="not-prose my-6"
    title="JSON Zipkin brut"
    samples={[{ lang: 'curl', label: 'Shell', shiki: 'bash', code: zipkinPost }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Champ Zipkin</th>
          <th>Devient</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>localEndpoint.serviceName</code></td><td>le service, ressource <code>service.name</code></td></tr>
        <tr><td><code>tags</code></td><td>les attributs du span, donc les tags <code>gen_ai.*</code> et <code>llm.*</code> sont lus comme sur OTLP</td></tr>
        <tr><td><code>kind</code></td><td>l’attribut <code>span.kind</code>, en minuscules</td></tr>
        <tr><td><code>annotations</code></td><td>des événements de span, chacun nommé par sa valeur</td></tr>
        <tr><td><code>remoteEndpoint</code></td><td><code>peer.service</code>, <code>network.peer.address</code>, <code>network.peer.port</code></td></tr>
        <tr><td>tag <code>error</code>, ou <code>otel.status_code</code></td><td>le statut, avec la valeur du tag comme message</td></tr>
        <tr><td><code>timestamp</code>, <code>duration</code></td><td>le début et la fin ; un span sans durée n’est pas terminé</td></tr>
        <tr><td><code>debug</code></td><td>le bit d’échantillonnage, donc l’échantillonneur garde la trace</td></tr>
        <tr><td><code>parentId</code></td><td>le parent</td></tr>
        <tr><td><code>shared</code></td><td>une moitié serveur, gardée à côté de sa moitié client</td></tr>
      </tbody>
    </table>
  </div>

  <p>
    Un identifiant de trace de 64 bits est complété à 128 bits par des zéros
    en tête, ce qui donne l’identifiant qu’OpenTelemetry attribue à la même
    trace. Un span serveur partagé réutilise l’identifiant de span de son
    client ; mcpd indexe un span sur son identifiant, donc la moitié serveur
    est stockée sous un identifiant dérivé de celui qui est partagé et rattachée
    à lui comme parent, et les deux moitiés sont gardées. Un span renvoyé
    arrive sur la même ligne.
  </p>

  <h2>Jaeger</h2>
  <p>
    Deux portes de collecteur Jaeger sont servies : <code>POST /api/traces</code>,
    qui prend un <code>jaeger.Batch</code> dans le protocole binaire de Thrift
    (<code>application/x-thrift</code>) et répond <code>202</code>, et le
    service gRPC <code>jaeger.api_v2.CollectorService/PostSpans</code>. Les deux
    mappent un span de la même façon.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="jaeger"
    samples={[{ lang: 'curl', label: 'Environnement', shiki: 'bash', code: jaegerEnv }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Champ Jaeger</th>
          <th>Devient</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>serviceName</code> du processus</td><td>le service, ressource <code>service.name</code></td></tr>
        <tr><td>tags du processus</td><td>les attributs de ressource</td></tr>
        <tr><td>tags du span</td><td>les attributs du span, typés comme Jaeger les a typés</td></tr>
        <tr><td>logs</td><td>des événements de span, nommés par le champ <code>event</code></td></tr>
        <tr><td><code>parentSpanId</code>, ou le premier <code>CHILD_OF</code> dans la même trace</td><td>le parent</td></tr>
        <tr><td>toute autre référence</td><td>un lien de span, de type <code>child_of</code> ou <code>follows_from</code></td></tr>
        <tr><td>tag <code>error</code>, ou <code>otel.status_code</code></td><td>le statut</td></tr>
        <tr><td>drapeau sampled ou debug</td><td>le bit d’échantillonnage</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Liens de span</h2>
  <p>
    Un lien dit qu’un span est lié à un autre span, dans cette trace ou dans une
    autre, sans en être l’enfant. mcpd garde les liens de chaque porte : les
    <code>links</code> d’un span OTLP dans l’un ou l’autre encodage et sur l’un
    ou l’autre transport, les <code>links</code> d’un span natif, et les
    références d’un span Jaeger qui ne sont pas son parent. Le type d’un lien
    vient de son attribut <code>mcpd.link.kind</code>, ou de
    <code>opentracing.ref_type</code>, ce que devient une référence Jaeger.
    Chaque lien est stocké avec le span et renvoyé avec la trace.
  </p>

  <h2>Ce qui se passe entre l’arrivée et le stockage</h2>
  <p>
    Un span OTLP, un span Zipkin ou Jaeger et un span natif suivent le même
    chemin. C’est tout l’intérêt d’un pipeline partagé : l’ordre ci-dessous
    ne peut pas diverger entre les portes.
  </p>

  <PipelineDiagram class="not-prose my-8" />

  <p>
    Le calcul du coût à l’ingestion est ce qui donne un chiffre de coût à un
    span OTLP. mcpd le tarife avec la grille sur laquelle ce serveur tourne, au
    moment où le span arrive, de sorte que changer vos tarifs plus tard ne peut
    pas réécrire en silence ce que le mois dernier a coûté. Voir
    <a href={urlFor('/docs/cost', locale)} class="link">Comptabilité des coûts</a>.
  </p>

  <h2>Les deux conventions sémantiques</h2>
  <p>
    Deux jeux concurrents de noms d’attributs coexistent pour les spans d’IA :
    les <code>gen_ai.*</code> d’OpenTelemetry et les <code>llm.*</code>
    d’OpenInference, avec <code>openinference.span.kind</code>. mcpd lit les
    deux, et par-dessus ses propres noms <code>mcpd.*</code>. Vous ne renommez
    rien.
  </p>
  <p>
    Chaque ligne ci-dessous est lue dans l’ordre, la première correspondance
    gagne. Un attribut qu’aucune ligne ne nomme est conservé quand même : toute
    la table d’attributs aplatie est stockée sur le span, donc rien de ce que
    vous envoyez n’est perdu faute d’avoir été mappé.
  </p>

  <h3>Modèle, payload et consommation</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Champ mcpd</th>
          <th>Lu depuis, dans l’ordre</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>model</code></td>
          <td><code>gen_ai.request.model</code>, <code>gen_ai.response.model</code>, <code>llm.model_name</code>, <code>mcpd.model</code></td>
        </tr>
        <tr>
          <td><code>provider</code></td>
          <td><code>gen_ai.system</code>, <code>llm.provider</code>, <code>mcpd.provider</code></td>
        </tr>
        <tr>
          <td><code>input</code></td>
          <td><code>input.value</code>, <code>gen_ai.prompt</code>, <code>mcpd.input</code></td>
        </tr>
        <tr>
          <td><code>output</code></td>
          <td><code>output.value</code>, <code>gen_ai.completion</code>, <code>mcpd.output</code></td>
        </tr>
        <tr>
          <td><code>entity_name</code></td>
          <td><code>gen_ai.agent.name</code>, <code>mcpd.entity.name</code></td>
        </tr>
        <tr>
          <td><code>usage.input_tokens</code></td>
          <td><code>gen_ai.usage.input_tokens</code>, <code>gen_ai.usage.prompt_tokens</code>, <code>llm.token_count.prompt</code>, <code>mcpd.usage.input_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.output_tokens</code></td>
          <td><code>gen_ai.usage.output_tokens</code>, <code>gen_ai.usage.completion_tokens</code>, <code>llm.token_count.completion</code>, <code>mcpd.usage.output_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.total_tokens</code></td>
          <td><code>llm.token_count.total</code>, <code>gen_ai.usage.total_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_read</code></td>
          <td><code>gen_ai.usage.cache_read_input_tokens</code>, <code>llm.token_count.prompt_details.cache_read</code>, <code>mcpd.usage.cache_read_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_write</code></td>
          <td><code>gen_ai.usage.cache_creation_input_tokens</code>, <code>llm.token_count.prompt_details.cache_write</code>, <code>mcpd.usage.cache_write_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.audio</code></td>
          <td><code>llm.token_count.prompt_details.audio</code></td>
        </tr>
        <tr>
          <td><code>output_details.reasoning</code></td>
          <td><code>llm.token_count.completion_details.reasoning</code>, <code>gen_ai.usage.reasoning_tokens</code></td>
        </tr>
        <tr>
          <td><code>output_details.audio</code></td>
          <td><code>llm.token_count.completion_details.audio</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Un span qui n’a aucun des trois décomptes de tokens ne porte pas d’objet
    <code>usage</code> du tout, plutôt qu’un objet rempli de zéros. Zéro token
    en entrée et un nombre inconnu de tokens en entrée sont deux faits
    différents, et un rapport de coût bâti sur le premier alors qu’il s’agissait
    du second est faux d’une façon que personne ne remarque.
  </p>

  <h3>Corrélation</h3>
  <p>
    Les champs de corrélation sont ce qui vous permet de demander les exécutions
    d’un utilisateur, ou celles d’une session. Les attributs du span sont lus
    d’abord, puis ceux de la ressource.
  </p>
