---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const title = '프레임워크를 가리지 않는 에이전트 관측소'
const description =
  'AI 에이전트를 위한 무료 오픈 소스 관측 도구입니다. 어떤 프레임워크, 언어, 모델 ' +
  '제공자든 OpenTelemetry나 SDK 6종으로 연결합니다. 바이너리 하나로 직접 호스팅하거나 mcpd.sh에서 무료로 쓰세요.'

const copy: HomeCopy = {
  h1: '프레임워크를 가리지 않는 에이전트 관측소.',
  lede:
    '배포한 모든 에이전트의 모든 실행이 보입니다. 모델 호출, 도구 호출, 검색 하나하나를 ' +
    '프롬프트, 응답, 비용과 함께 봅니다. 프레임워크도, 언어도, 모델 제공자도 가리지 ' +
    '않습니다. 새로 도입할 것은 없습니다.',
  startFree: '무료로 시작',
  selfHost: '셀프 호스팅',
  heroNote: '호스팅 버전은 모든 기능이 무료입니다. 오픈 소스 바이너리 하나를 내 컴퓨터에서 실행할 수도 있습니다.',

  worksTitle: '지금 쓰는 스택 그대로.',
  worksBody:
    'mcpd는 OpenTelemetry를 받고, 모델 호출에 대한 OpenTelemetry 규약과 OpenInference ' +
    '규약을 모두 읽습니다. 그래서 스택에 이미 있는 계측이 그대로 작동합니다. 에이전트는 ' +
    '프레임워크를, 여러분은 코드를 그대로 유지합니다.',
  otelLabel: 'OpenTelemetry 익스포터를 mcpd로 지정',
  sdkLead: '또는 SDK 추가:',
  frameworksLegend: '에이전트 프레임워크',
  providersLegend: '모델 제공자',
  ownLoop: '직접 만든 루프',

  seeTitle: '모든 단계를 근거와 함께.',
  seeBody:
    '실행은 모델 호출, 도구 호출, 검색으로 이루어진 트리입니다. 어느 단계든 열면 정확한 ' +
    '프롬프트와 응답, 사용한 토큰, 든 비용을 볼 수 있습니다. 모델이 한 말로 실행을 ' +
    '검색할 수 있고, 모든 로그 줄은 그 줄을 쓴 단계로 연결됩니다.',
  seeFacts: [
    '모든 실행의 워터폴, 하나의 시간축',
    '도구 호출까지 포함한 전체 대화',
    '실행별, 모델별, 프로젝트별 비용',
    'trace id로 묶인 로그, 메트릭, 트레이스',
  ],
  openInterface: '인터페이스 열기',

  flowTitle: '크래시에도 살아남는 워크플로.',
  flowBody:
    '단계는 여섯 가지 언어 중 하나로, 직접 코드로 작성합니다. 단계 사이의 실행은 mcpd가 ' +
    '보관합니다. 재시도, 타이머, 일주일이 걸릴 수도 있는 이벤트 대기까지 맡습니다. ' +
    '단계 도중에 워커가 죽으면 다른 워커가 그 단계를 이어받습니다.',
  flowNotes: [
    ['모든 단계는 여러분의 코드가 실행', '데몬은 모델도, 프롬프트도, 자격 증명도 보지 않습니다. 워커는 한 번에 한 단계씩 가져갑니다.'],
    ['대기 중에는 프로세스가 필요 없음', '슬립이나 승인 대기 중에는 살아 있는 프로세스 없이도 실행이 유지됩니다. 배포를 거쳐도, 일주일이 지나도 마찬가지입니다.'],
    ['모든 실행은 하나의 트레이스', '각 단계는 입력, 출력, 비용을 담은 스팬입니다. 그래서 검색과 스코어링도 실행에 그대로 쓸 수 있습니다.'],
  ],
  flowLink: '워크플로 알아보기',

  evalTitle: '품질이 떨어지면 바로 압니다.',
  evalBody:
    '내장 스코어러 13개나 판정 모델로 모든 실행을 채점합니다. 프로덕션 실행으로 ' +
    '데이터셋을 만들고 실험을 비교합니다. 모니터가 오류율, 지연 시간, 비용, 점수를 ' +
    '지켜보다가 하나라도 움직이면 웹훅을 호출합니다.',
  evalLink: '평가',
  alertLink: '모니터와 알림',

  deployTitle: '어디서든 실행됩니다.',
  deployBody:
    '스토리지와 인터페이스를 내장한 바이너리 하나입니다. 노트북에서는 SQLite, 팀에서는 ' +
    'Postgres나 ClickHouse, 프로덕션에서는 Docker나 Kubernetes를 씁니다. 텔레메트리도, ' +
    '라이선스 서버도 없습니다.',
  deployLink: '배포 가이드',
  targets: [
    ['호스팅', 'mcpd.sh에서 모든 기능을 무료로 씁니다. 가입하고 첫 트레이스를 보내세요.'],
    ['노트북', '프로세스 하나와 SQLite 파일 하나로 충분합니다. 따로 설치할 것이 없습니다.'],
    ['Docker', '컨테이너 하나, 볼륨 하나, 포트 하나.'],
    ['Kubernetes', 'Helm 차트에 Postgres나 ClickHouse를 붙이고, 프로젝트마다 키를 따로 둡니다.'],
  ],
  ownLabel: '직접 실행',
  fromSource: '소스에서 빌드',

  closeTitle: '5분 안에 첫 트레이스.',
  closeBody: '무료로 가입하거나 내 컴퓨터에서 실행하세요. 어느 쪽이든 같은 제품입니다.',
}
---

<Base title={title} description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
