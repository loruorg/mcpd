---
import Doc from '@/layouts/Doc.astro'
import SearchDemo from '@/components/SearchDemo.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import { localeOf, urlFor } from '@/lib/i18n'

const loc = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, loc)

/* 이 예제들은 예제 프로그램에서 읽어 오지 않고 여기에 적어 두었습니다. CI가
   실행할 수 있는 코드가 아니라, 독자가 자기 데몬을 상대로 돌리는 쿼리이기
   때문입니다. 여기 나오는 모든 파라미터는 서버가 실제로 파싱하는 것입니다. */
const finding = [
  {
    lang: 'curl' as const,
    label: 'cURL',
    shiki: 'bash',
    code: `# Failed runs from the last day that mention both words, anywhere in a
# span name, a prompt or a completion.
curl -s --get http://localhost:4317/v1/api/traces \\
  --data-urlencode 'q=Leeds depot' \\
  --data-urlencode 'status=error' \\
  --data-urlencode 'from=-24h'

# Every step that called one model and failed, across every run at once.
curl -s --get http://localhost:4317/v1/api/spans \\
  --data-urlencode 'model=gpt-4o-mini' \\
  --data-urlencode 'status=error' \\
  --data-urlencode 'min_duration_ms=2000'
`,
  },
  {
    lang: 'typescript' as const,
    label: 'TypeScript',
    shiki: 'typescript',
    code: `import { Mcpd } from '@mcpd/sdk'

const mcpd = new Mcpd()

const bad = await mcpd.listTraces({
  q: 'Leeds depot',
  status: 'error',
  from: '-24h',
  limit: 20,
})

for (const trace of bad.traces) {
  console.log(trace.traceId, trace.name, trace.status)
}`,
  },
  {
    lang: 'python' as const,
    label: 'Python',
    shiki: 'python',
    code: `from mcpd import Mcpd

mcpd = Mcpd()

bad = mcpd.list_traces(q="Leeds depot", status="error", from_="-24h", limit=20)

for trace in bad.traces:
    print(trace.trace_id, trace.name, trace.status.value)`,
  },
]

const discovery = [
  {
    lang: 'curl' as const,
    label: 'cURL',
    shiki: 'bash',
    code: `# Every environment this project has reported, for a filter box.
curl -s --get http://localhost:4317/v1/api/discovery \\
  --data-urlencode 'project=default' \\
  --data-urlencode 'facet=environment'

# Typeahead: the service names starting with "check".
curl -s --get http://localhost:4317/v1/api/discovery \\
  --data-urlencode 'facet=service_name' \\
  --data-urlencode 'prefix=check'

# The values one metric label takes.
curl -s --get http://localhost:4317/v1/api/discovery \\
  --data-urlencode 'facet=metric_label_value' \\
  --data-urlencode 'key=model'
`,
  },
  {
    lang: 'curl' as const,
    label: '200 OK',
    shiki: 'json',
    code: `{
  "facet": "environment",
  "values": [
    { "value": "production", "last_seen": "2026-09-03T08:04:18Z" },
    { "value": "staging", "last_seen": "2026-09-02T17:41:02Z" }
  ]
}`,
  },
  {
    lang: 'curl' as const,
    label: '501 Not Implemented',
    shiki: 'json',
    code: `{
  "error": "not_implemented",
  "capability": "discovery",
  "message": "this deployment stores signals in <backend>, which does not support discovery: ... GET /v1/api/capabilities lists what it does support."
}`,
  },
]

const badParam = [
  {
    lang: 'curl' as const,
    label: '400 Bad Request',
    shiki: 'json',
    code: `{
  "error": "bad_parameter",
  "field": "from",
  "message": "\\"yesterday\\" is not an RFC 3339 timestamp or a relative duration like -1h"
}`,
  },
]

const paging = [
  {
    lang: 'curl' as const,
    label: 'cURL',
    shiki: 'bash',
    code: `# The first page hands back a cursor in page.next_cursor.
curl -s --get http://localhost:4317/v1/api/traces \\
  --data-urlencode 'q=refund' \\
  --data-urlencode 'sort=cost' \\
  --data-urlencode 'limit=100'

# The next page: the same filters, the same sort, plus the cursor.
curl -s --get http://localhost:4317/v1/api/traces \\
  --data-urlencode 'q=refund' \\
  --data-urlencode 'sort=cost' \\
  --data-urlencode 'limit=100' \\
  --data-urlencode 'cursor=MzEzNzQyfDBhZjM...'
`,
  },
  {
    lang: 'typescript' as const,
    label: 'TypeScript',
    shiki: 'typescript',
    code: `let cursor: string | undefined

do {
  const page = await mcpd.listTraces({
    q: 'refund',
    sort: 'cost',
    order: 'desc',
    limit: 100,
    cursor,
  })

  for (const trace of page.traces) {
    console.log(trace.traceId, trace.cost?.totalCost ?? 'not priced')
  }

  // Loop on hasMore. There is no total to count towards.
  cursor = page.page.hasMore ? page.page.nextCursor : undefined
} while (cursor)`,
  },
  {
    lang: 'python' as const,
    label: 'Python',
    shiki: 'python',
    code: `cursor = None

while True:
    page = mcpd.list_traces(
        q="refund", sort="cost", order="desc", limit=100, cursor=cursor
    )

    for trace in page.traces:
        cost = trace.cost.total_cost if trace.cost else "not priced"
        print(trace.trace_id, cost)

    # Loop on has_more. There is no total to count towards.
    if not page.page.has_more:
        break
    cursor = page.page.next_cursor`,
  },
]
---

<Doc
  title="실행 찾기"
  description="프롬프트와 컴플리션에 대한 전문 검색, mcpd가 트레이스와 스팬에 받아 주는 모든 필터, 그리고 스코어러가 낮게 매긴 답변을 찾아내는 쿼리를 다룹니다."
  lede="조사는 대시보드가 아니라 불만에서 시작합니다. 이 페이지는 그 불만을 그것을 일으킨 실행 하나로 바꾸는 방법입니다."
  og="docs"
>
  <h2>라벨이 아니라 페이로드를 검색하십시오</h2>
  <p>
    대부분의 트레이싱 도구는 이름과 속성을 색인합니다. mcpd는 프롬프트와 컴플리션까지
    색인합니다. 사람이 불만을 제기하는 대상은 모델이 한 말이고, 그 사람이 인용해 주는
    낱말이 쥘 수 있는 유일한 손잡이이기 때문입니다. <code>q</code>
    파라미터가 그 색인입니다.
  </p>

  <SearchDemo class="not-prose my-8" />

  <h2>q가 정확히 무엇을 덮는가</h2>
  <p>
    색인은 스팬마다 세 필드를 담습니다. 이름, 입력, 출력입니다. 입력과 출력은
    JSON이므로, 색인하기 전에 mcpd가 페이로드를 훑으며 문자열과 숫자만 남기고 중괄호와
    따옴표와 키는 버립니다. 날것의 JSON을 색인하면 구두점 하나하나가 토큰이 되어, 정작
    찾는 낱말이 묻혀 버립니다.
  </p>
  <p>이것에 기대기 전에 알아 둘 만한 결과가 여섯 있습니다.</p>
  <ul>
    <li>
      실행은 <strong>그 안의 스팬 하나라도</strong> 일치하면 걸립니다. 돌아오는 것은
      실행 전체이니, 어느 단계였는지는 하나를 열어 보십시오.
    </li>
    <li>
      낱말은 AND로 묶입니다. <code>q=refund delayed</code>는 색인된 텍스트 어디에서든
      둘 다를 담은 스팬을 찾으며, 둘이 붙어 있어야 하는 것은 아닙니다.
    </li>
    <li>
      일치는 낱말 단위이고 대소문자를 가리지 않으며, 발음 구별 기호는 같은 것으로
      취급합니다. 그래서 <code>resume</code>이 <code>résumé</code>를 찾습니다. 어간
      추출은 없습니다. <code>refund</code>는 <code>refunds</code>를 찾지 못합니다.
    </li>
    <li>
      입력과 출력 각각의 앞 64 KiB가 색인에 들어갑니다. 그보다 긴 페이로드도 통째로
      저장되고 통째로 표시됩니다. 아주 긴 프롬프트의 꼬리만 검색되지 않습니다.
    </li>
    <li>
      마스킹은 저장 전에 이루어지므로, 마스킹이 지운 것은 색인에도 애초에 들어가지
      않았습니다.
      <a href={linkTo('/docs/privacy')} class="link">마스킹과 보존 기간</a>을 보십시오.
    </li>
    <li>
      오래 도는 스팬이 끝날 때처럼 스팬이 두 번 이상 쓰이면 자기 색인 행을 대체하므로,
      검색은 언제나 현재 버전을 반영합니다.
    </li>
  </ul>

  <h2>따옴표 하나는 오류가 아니라 검색어입니다</h2>
  <p>
    그 아래의 색인에는 자기만의 질의 언어가 있습니다. 큰따옴표는 구절을 열고,
    <code>NEAR</code>와 <code>OR</code>와 <code>*</code>는 연산자입니다. 입력한
    텍스트를 그대로 넘긴다면, 따옴표가 들어 있는 고객 메시지가 결과 대신 구문 오류로
    돌아올 것입니다. 예외를 던질 수 있는 검색창은 사람들이 쓰지 않게 되는 검색창입니다.
  </p>
  <p>
    그래서 입력한 텍스트는 그 파서에 닿지 않습니다. mcpd는 입력된 것을
    공백으로 나누고, 각 낱말에서 큰따옴표를 떼어 내고, 각 낱말을 리터럴 항으로 감싼 뒤 AND로
    잇습니다. <code>q=say "no"</code>는 <em>say</em>와 <em>no</em>라는 낱말을 찾습니다.
    <code>q=NEAR</code>는 NEAR라는 낱말을 찾습니다. 입력할 수 있는 어떤 것도
    구문 오류가 아니고, 쓸 수 있는 연산자도 없습니다. 그것이 맞바꾼 것이고, 일부러 이
    방향으로 정했습니다.
  </p>
  <p>
    공백뿐인 <code>q</code>는 아무것도 일치시키지 않는 대신 버려지고, 비어 있는
    <code>q=</code>는 없는 것으로 봅니다. 모든 파라미터가 그렇게 동작하므로, 빈 필터
    상자를 함께 보내는 폼이 실수로 빈 문자열을 걸러 내는 일은 없습니다.
  </p>

  <h2>실행 목록 좁히기</h2>
  <p>
    <code>GET /v1/api/traces</code>는 다음을 받습니다. 빼놓은 것은 적용되지 않습니다.
  </p>

  <table>
    <thead>
      <tr><th>파라미터</th><th>고르는 것</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>q</code></td>
        <td>각 스팬의 이름과 입력과 출력에 대한 전문 검색.</td>
      </tr>
      <tr>
        <td><code>status</code></td>
        <td>
          <code>unset</code>, <code>ok</code>, <code>error</code> 또는
          <code>cancelled</code>. 실행 안의 스팬이 하나라도 실패하면 그 실행은
          <code>error</code>이며, 오류를 잡아낸 스팬이라도 마찬가지입니다.
        </td>
      </tr>
      <tr>
        <td><code>kind</code></td>
        <td>
          실행의 루트 스팬 종류. <code>agent_run</code>이나
          <code>workflow_run</code> 같은 것입니다.
        </td>
      </tr>
      <tr>
        <td><code>name</code></td>
        <td>루트 스팬의 이름과 정확히 일치. 접두사도 패턴도 아닙니다.</td>
      </tr>
      <tr>
        <td><code>tags</code></td>
        <td>
          쉼표로 구분합니다. 실행은 나열된 태그를 <em>전부</em> 달고 있어야 하며,
          그중 아무거나가 아닙니다.
        </td>
      </tr>
      <tr><td><code>session_id</code></td><td>한 대화 안의 모든 실행.</td></tr>
      <tr><td><code>thread_id</code></td><td>한 스레드 안의 모든 실행.</td></tr>
      <tr><td><code>user_id</code></td><td>한 최종 사용자의 모든 실행.</td></tr>
      <tr><td><code>environment</code></td><td><code>production</code> 같은 환경 하나.</td></tr>
      <tr>
        <td><code>model</code></td>
        <td>이 모델 id를 상대로 한 스팬이 하나 이상 있는 실행.</td>
      </tr>
      <tr>
        <td><code>from</code>, <code>to</code></td>
        <td>구간. 실행의 시작 시각을 기준으로 잽니다.</td>
      </tr>
      <tr>
        <td><code>min_duration_ms</code></td>
        <td>적어도 이만큼 느린 실행. 밀리초 단위입니다.</td>
      </tr>
      <tr>
        <td><code>min_cost</code></td>
        <td>
          적어도 이만큼 비용이 든 실행. 값이 매겨진 스팬이 없는 실행은 0으로 세므로,
          0보다 큰 값을 주면 그런 실행은 빠집니다.
        </td>
      </tr>
      <tr>
        <td><code>has_score</code></td>
        <td>이 스코어러 id의 점수를 달고 있는 실행.</td>
      </tr>
      <tr>
        <td><code>score_below</code></td>
        <td><code>has_score</code>와 함께 쓰면, 그 스코어러가 이 값 아래로 매긴 실행.</td>
      </tr>
      <tr>
        <td><code>sort</code></td>
        <td>
          <code>start_time</code>, <code>duration</code>, <code>cost</code>,
          <code>span_count</code> 또는 <code>score</code>. 기본값은
          <code>start_time</code>입니다. <code>score</code>는 어느 스코어러든 매긴 것
          중 가장 낮은 점수로 실행을 정렬하므로, 오름차순이면 가장 나쁜 실행이 맨
          앞에 옵니다. 점수가 없는 실행은 0으로 순위가 매겨집니다.
        </td>
      </tr>
      <tr>
        <td><code>order</code></td>
        <td><code>asc</code> 또는 <code>desc</code>. 기본값은 <code>desc</code>입니다.</td>
      </tr>
      <tr>
        <td><code>limit</code></td>
        <td>페이지 크기. 1에서 500 사이로 조정됩니다. 기본값은 50입니다.</td>
      </tr>
      <tr>
        <td><code>cursor</code></td>
        <td>앞 페이지에서 받은 불투명한 커서.</td>
      </tr>
      <tr>
        <td><code>project</code></td>
        <td>
          어느 프로젝트를 읽을지. 기본값은 데몬 자신의 기본 프로젝트이므로, 프로젝트가
          하나뿐인 설치에서는 넘길 일이 없습니다.
        </td>
      </tr>
    </tbody>
  </table>

  <p>
    <code>name</code>과 상관 정보 id들과 <code>environment</code>는 동등 비교이고, 그래서
    값이 쌉니다. 이름의 일부만 맞추고 싶다면 <code>q</code>를 쓰십시오. 스팬 이름도
    텍스트 색인에 들어 있습니다.
  </p>

  <h2>목록 한 줄이 치르는 비용</h2>
  <p>
    더 가벼운 두 번째 실행 목록은 없습니다. 첫 번째가 이미 가볍기 때문입니다. 저장된
    트레이스 요약본은 입력도, 출력도, 속성도 전혀 싣지 않습니다. 이름, 개수, 시각,
    비용, 태그, 상관 정보뿐이고, 모델이 한 말은 하나도 없습니다. 페이로드를 가져오는
    것은 실행을 열 때입니다.
  </p>
  <p>
    현실적인 실행 하나로 재 보았습니다. 정책 문서 세 건을 검색하고, 도구를 두 번
    호출하고, 실제 프롬프트와 컴플리션으로 모델을 두 번 호출하는 여덟 단계짜리 지원
    에이전트입니다. 목록 한 줄은 <strong>577바이트</strong>, 실행 전체는
    <strong>10,717바이트</strong>로 <strong>94.6퍼센트가 줄어듭니다</strong>. 이
    데몬으로, 그 실행에 대해, 실제 HTTP 표면 위에서 잰 값입니다. 실행마다 값은 다를
    것이고, 중요한 것은 방향입니다. 프롬프트가 커질수록 절약도 커집니다. 커지는 부분이
    바로 목록이 싣지 않는 부분이기 때문입니다.
  </p>
  <p>
    이 수치는 여기에 타이핑된 것이 아니라 테스트가 만들어 냅니다. 그래서 한쪽만 낡고
    다른 쪽은 멀쩡한 일이 생기지 않습니다.
    <code>cargo test -p mcpd-server --test payload_size -- --nocapture</code>를 돌리면
    두 바이트 수를 모두 출력합니다. 페이로드를 싣는 필드를 요약본에 추가하면 그
    테스트가 실패합니다.
  </p>

  <h2>그 밖의 것은 이름을 밝혀 거절합니다</h2>
  <p>
    저 표가 어휘의 전부입니다. 표에 없는 파라미터는 받아들여진 뒤 버려지는 대신, 그
    이름을 밝히는 400으로 거절됩니다. 이것은 바뀐 동작입니다. 예전의 mcpd는 모르는
    파라미터를 무시했기 때문에, <code>?statuss=error</code>가 프로젝트의 모든 실행을
    담은 200으로 돌아왔고, 필터가 적용되지 않았다는 사실을 응답의 어디에서도 알 수
    없었습니다. 그럴듯한 오답은 오류보다 나쁩니다. 알아차릴 거리가 없기 때문입니다.
  </p>
  <p>
    여기서 맞바꾼 것도 짚어 둘 만합니다. 더 새로운 데몬이 이해하는 필터를 보내는
    클라이언트는 이제 더 넓은 결과 대신 옛 데몬에서 400을 받습니다. 두 실패 중에서는
    그쪽이 낫습니다. 400은 그 파라미터의 이름을 말하고 거기서 멈춥니다.
  </p>
  <p>
    "알 수 없음"보다 더 많은 것을 말하는 거절도 있습니다. mcpd는 모든 트레이스에
    <code>service_name</code>, <code>service_version</code>,
    <code>resource_id</code>, <code>run_id</code>, <code>request_id</code>,
    <code>experiment_id</code>, <code>release</code>를 기록하지만, 실행 목록은
    아직 그것들로 거를 수 없습니다. 일곱 가운데
    <a href="#filling-a-filter-box" class="link">디스커버리</a> 패싯은
    <code>service_name</code> 하나뿐이므로, 디스커버리가 값을 나열해 주는 것도 그것
    하나입니다. 그 일곱은 그렇게 말하는 메시지와 함께 거절됩니다.
    <code>service_name=checkout-api</code>는 오타가 아니고, 그것을 알 수 없는
    파라미터라고 말하면 있지도 않은 철자 오류를 찾아 헤매게 만들기 때문입니다.
  </p>

  <p>
    이 규칙은 실행 목록만의 것이 아닙니다. <code>GET /v1/api/spans</code>,
    <code>/v1/api/logs</code>, <code>/v1/api/scores</code>,
    <code>/v1/api/metrics</code>, <code>/v1/api/feedback</code>이 각각 자기 어휘를 같은
    방식으로 강제합니다. 마주치기 전에 알아 둘 만한 것이 둘 있습니다. 점수 목록은
    <code>order</code>를 받지 않습니다. 최신순으로 고정되어 있고 그 커서가 한 방향으로만
    비교하기 때문입니다. 그리고 피드백 목록은 <code>trace_id</code>를 요구합니다. mcpd가
    아직 프로젝트 전체의 피드백을 나열할 수 없고, 빈 목록은 피드백이 없다는 뜻으로 읽힐
    것이기 때문입니다.
  </p>

  <h2 id="filling-a-filter-box">필터 상자 채우기</h2>
  <p>
    무엇을 입력해야 하는지 알아야 필터를 쓸 수 있는데, 그 값들은 고정된 목록이 아닙니다.
    프로젝트에 보고하는 서비스들이 보내는 것이 곧 그 값입니다.
    <code>GET /v1/api/discovery</code>가 그 답을 줍니다. <code>facet</code>으로 한 번에
    한 차원씩 물으면, 그 차원이 프로젝트 안에서 취해 온 값들을 값 순서로 돌려주고,
    각각에 그 값을 실은 시그널이 마지막으로 언제 왔는지가 붙습니다.
  </p>
  <table>
    <thead>
      <tr><th>패싯</th><th>나열하는 것</th></tr>
    </thead>
    <tbody>
      <tr><td><code>entity_kind</code></td><td>에이전트, 워크플로, 도구, 모델, 스코어러, 프로세서, 파이프라인 또는 서비스.</td></tr>
      <tr><td><code>entity_name</code></td><td>호출된 도구처럼, 그것들이 가진 이름.</td></tr>
      <tr><td><code>service_name</code></td><td>보고해 온 서비스들.</td></tr>
      <tr><td><code>environment</code></td><td><code>production</code>처럼, 관측된 환경들.</td></tr>
      <tr><td><code>tag</code></td><td>어느 실행이든 달고 있는 모든 태그.</td></tr>
      <tr><td><code>metric_name</code></td><td>기록된 메트릭 이름들. mcpd가 파생시키는 것까지 포함합니다.</td></tr>
      <tr><td><code>metric_label_key</code></td><td>프로젝트에서 관측된 모든 라벨 키.</td></tr>
      <tr><td><code>metric_label_value</code></td><td>라벨 하나의 값들. <code>key</code>가 필요합니다.</td></tr>
    </tbody>
  </table>
  <p>
    <code>prefix</code>는 자동완성을 위해 목록을 좁히며, 글자 그대로 대소문자를 가려
    맞춥니다. 이 값들은 필터가 대조될 대상이고, 여기서 대소문자를 뭉개면 아무것도 맞지
    않는 값을 제시하게 되기 때문입니다. <code>limit</code>은 답을 1000개로 자릅니다. 값은
    최신순이 아니라 값 순서로 정렬되므로, 누군가 읽고 있는 목록이 폴링 사이에 발밑에서
    뒤섞이지 않습니다.
  </p>
  <p>
    이것을 상대로 무언가를 만들기 전에 알아 둘 한계가 하나 있습니다.
    <code>metric_label_key</code>는 이름 붙은 메트릭 하나의 키가 아니라, 프로젝트
    어디에서든 관측된 모든 라벨 키를 나열합니다. 고유 값 목록의 키는 그 라벨이지, 그것을
    실어 온 메트릭이 아니기 때문입니다.
  </p>

  <h2>다시 돌리지 않고 목록 새로 고치기</h2>
  <p>
    <code>GET /v1/api/deltas</code>는 커서 이후로 도착한 것을 오래된 것부터
    돌려줍니다. <code>traces</code>, <code>spans</code>, <code>logs</code>에 대해
    쓸 수 있습니다. 지난번 폴링에서 받은 커서를 들고 있다가 다시 보내고, 돌아온 행들을
    이미 들고 있는 목록에 반영하십시오.
  </p>
  <p>
    폴링은 페이징이 아니고, 두 커서는 일부러 서로 바꿔 쓸 수 없게 되어 있습니다. 페이징은
    고른 정렬로 고정된 결과 집합을 거슬러 걷습니다. 폴링은 도착 순서로 앞으로
    걸으며 끝나지 않습니다. 워터마크는 행의 도착 시각과 그 id를 함께 씁니다. 배치는 그
    안의 모든 행을 하나의 타임스탬프로 쓰기 때문에, "이 나노초 이후"밖에 말하지 못하는
    워터마크라면 배치 전체를 다시 재생하거나 그 나머지를 건너뛸 것입니다. 아무것도 없는
    폴링은 커서를 그대로 돌려줍니다. 커서를 앞으로 옮기면, 잠시 뒤에 더 이른 도착 시각을
    달고 들어오는 행을 놓치게 되기 때문입니다.
  </p>
  <p>
    점수와 피드백은 폴링할 수 없습니다. 호출자가 보낸 타임스탬프가 찍히고 서버가 정하는
    도착 시각이 없어서, 그 위의 워터마크는 늦게 온 행을 건너뛰거나 모든 행을 영원히
    반복하게 됩니다. <code>signal=scores</code>는 빈 페이지로 답하는 대신 거절됩니다.
  </p>

  <h2>이 배포가 할 수 있는 것</h2>
  <p>
    mcpd에는 저장소 트레이트가 하나 있고 그 뒤에 백엔드가 셋 있는데, 셋은 동등하지
    않습니다. ClickHouse에서는 삭제를 받아들인 뒤 호출이 돌아온 다음에 적용하므로,
    응답의 개수는 디스크에서 사라진 것이 아니라 일치한 것을 말합니다. SQLite와
    Postgres에서는 호출이 돌아왔을 때 행이 이미 사라져 있습니다.
    <code>GET /v1/api/capabilities</code>가 그것이 적혀 있는 곳입니다. 데몬 뒤에 어떤
    백엔드가 있는지, <code>q</code>가 무엇을 맞추는지, ASCII 밖에서도 대소문자를 뭉개는지,
    호출이 돌아왔을 때 삭제가 디스크에 반영되어 있는지, 그리고 디스커버리와 델타 폴링이
    답하기는 하는지가 있습니다.
  </p>
  <p>
    연결할 때 한 번 읽고, 그 배포가 답하는 것만 제공하십시오. 기능이 거짓인 엔드포인트는
    <code>501</code>과 함께 거절하며, 그 본문의 <code>capability</code> 필드는 기능
    목록이 발표하는 것과 같은 낱말을 씁니다. 그래서 둘이 어긋날 수 없고, 그 거절을 만난
    클라이언트는 절대 바뀌지 않을 것을 다시 시도하는 대신 찾아볼 수 있습니다.
  </p>
  <p>
    오늘 제공되는 백엔드 셋은 모두 디스커버리와 델타 폴링에 답하므로, 아래의 501은
    SQLite나 Postgres나 ClickHouse에서 보게 될 응답이 아니라 나중에 추가되는 백엔드가
    거절할 때의 모양입니다. 어느 쪽인지 말해 주는 것이 기능 목록이고, 지금도 읽어 둘
    가치가 있습니다. 셋은 호출이 돌아왔을 때 삭제가 디스크에 반영되어 있는지에서, 그리고
    보존을 어떻게 강제하는지에서 서로 다릅니다. ASCII 밖의 대소문자는 셋 모두
    뭉갭니다.
  </p>

  <CodeSwitcher class="not-prose my-6" samples={discovery} title="무엇으로 거를 수 있는가?" />

  <h2>시간 구간</h2>
  <p>
    <code>from</code>과 <code>to</code>는 RFC 3339 타임스탬프를 받거나, 상대적인 축약형을
    받습니다. 빼기 기호와 숫자, 그리고 <code>s</code>, <code>m</code>, <code>h</code>,
    <code>d</code> 중 하나입니다. <code>-15m</code>, <code>-1h</code>,
    <code>-7d</code> 모두 됩니다. 축약형이 있는 이유는, 지난 한 시간을 보려고 ISO
    타임스탬프를 손으로 치는 것은 아무도 치르지 않아야 할 마찰이기 때문입니다.
  </p>
  <p>
    <code>from</code>은 포함이고 <code>to</code>는 제외이며, 둘 다 실행이
    <em>시작한</em> 시각과 비교합니다. 지정한 구간 이전에 시작해 그 안에서도 계속 돌고
    있던 긴 실행은 돌아오지 않습니다. 09:00에 돌고 있던 무언가를 쫓고 있다면,
    <code>from</code>을 좁히지 말고 뒤로 넓히십시오.
  </p>
  <p>
    타임스탬프도 기간도 아닌 값은 무시되는 대신 이름을 밝혀 거절됩니다. 모든 목록
    엔드포인트의 모든 파라미터가 이렇게 실패합니다. 조용히 버려진 필터는 그럴듯한 오답을
    돌려주고, 그럴듯한 오답은 오류보다 나쁘기 때문입니다.
  </p>

  <CodeSwitcher class="not-prose my-6" samples={badParam} title="from=yesterday" />

  <h2>나쁜 답변을 찾아내는 쿼리</h2>
  <p>
    <code>has_score=answer_relevance&amp;score_below=0.5</code>는 그 스코어러가 0.5 아래로
    매긴 모든 실행을 돌려줍니다. 불만이 실패가 아니라 품질에 대한 것일 때 집어 들 것이
    이것입니다. 나쁜 답변은 대개 성공한 실행이기 때문입니다.
  </p>
  <p>
    <code>has_score</code>만 쓰면 그 스코어러가 본 모든 실행이 돌아옵니다.
    <code>score_below</code>만 쓰면 아무 일도 일어나지 않습니다. 스코어러가 붙지 않은
    임계값은 뜻이 없고, mcpd가 어느 스코어러를 말한 것인지 짐작해야 하기 때문입니다.
    mcpd는 짐작하지 않습니다. 그 값들이 어디에서 오는지는
    <a href={linkTo('/docs/evaluation')} class="link">점수와 피드백</a>이 다룹니다.
  </p>

  <h2>실행 대신 단계 검색하기</h2>
  <p>
    <code>GET /v1/api/spans</code>는 모든 실행을 가로질러 개별 단계를 한 번에
    검색합니다. 세션이 아니라 단계에 대한 질문에 쓰십시오. 어느 도구 호출이 느린가, 어느
    모델 호출이 오류를 냈는가, 검색 한 번에 얼마나 걸리는가 같은 것입니다.
  </p>
  <p>
    <code>q</code>, <code>kind</code>, <code>status</code>, <code>name</code>,
    <code>model</code>, <code>trace_id</code>, <code>from</code>, <code>to</code>,
    <code>min_duration_ms</code>, <code>sort</code>, <code>order</code>,
    <code>limit</code>, <code>cursor</code>를 같은 뜻과 같은 기본값으로 받습니다.
    여기에는 <code>tags</code>, <code>session_id</code>, <code>user_id</code> 필터가
    없습니다. 그것들은 실행에 속하는 것이고, 셋 모두 받아들여진 뒤 버려지는 대신 이름을
    밝혀 거절됩니다.
  </p>
  <p>
    <code>sort</code>는 실행 목록에서보다 받는 값이 적습니다. <code>start_time</code>,
    <code>duration</code>, <code>cost</code>뿐이고 그 밖에는 없습니다. 스팬은 스팬 개수도
    점수 롤업도 싣지 않으므로 <code>span_count</code>와 <code>score</code>는 정렬할 대상이
    없고, 무시되는 대신 이름을 밝혀 거절됩니다.
  </p>
  <p>
    실행에서 <code>model</code>은 어느 스팬이든 그 모델을 썼는지를 묻습니다. 스팬에서
    <code>model</code>은 그 스팬 자신의 모델입니다. 같은 낱말, 다른 두 질문입니다.
  </p>

  <CodeSwitcher class="not-prose my-6" samples={finding} title="찾아내기" />

  <h2>페이징, 그리고 커서가 불투명한 이유</h2>
  <p>
    목록은 최대 <code>limit</code>개의 행과 <code>page</code> 객체를 돌려줍니다. 더
    있으면 <code>page.next_cursor</code>가 있고, <code>page.has_more</code>가 같은 말을
    불리언으로 합니다.
  </p>
  <p>
    페이징은 오프셋이 아니라 키셋 방식입니다. 커서는 받은 마지막 행을 가리키고,
    다음 페이지는 그 뒤에서부터 엄격하게 시작합니다. 오프셋 페이징은 밀립니다. 트레이스는
    계속 도착하므로, 50번부터 99번 행을 달라고 할 때쯤이면 창이 발밑에서 옮겨 가 어떤
    실행은 두 번 읽히고 어떤 실행은 아예 나타나지 않습니다. 조사에서는 놓친 그 실행이
    바로 찾던 실행입니다.
  </p>
  <p>
    커서는 정렬 값과 행 id를 16진수로 인코딩한 쌍이며, 뜻이 없는 것으로 다루어야 합니다.
    불투명한 이유는 모든 호출자를 깨뜨리지 않고 인코딩을 바꿀 수 있어야 하기 때문이고,
    그 안의 값이 정렬마다 다른 양이기 때문입니다. <code>start_time</code>과
    <code>duration</code>에는 나노초, <code>cost</code>에는 배율을 곱한 정수,
    <code>span_count</code>에는 평범한 개수, <code>score</code>에는 그 실행의 가장 낮은
    점수입니다.
  </p>
  <p>
    거기에 규칙이 하나 붙습니다. <strong>커서는 그것을 만들어 낸 것과 같은 필터, 같은
    <code>sort</code>, 같은 <code>order</code>와 함께 돌려보내십시오.</strong> mcpd는
    그렇게 했는지 확인하지 않으며, 다른 정렬에 대고 다시 쓴 커서는 엉뚱한 열과 비교하여
    행을 건너뜁니다. 편집되었거나 잘린 커서는 <code>invalid_query</code>와
    <code>malformed cursor</code> 메시지로 거절됩니다.
  </p>
  <p>
    총계는 없습니다. <code>page.total</code>은 일치 개수를 싸게 셀 수 있는 백엔드를 위해
    남겨 둔 자리이고, 기본 제공되는 SQLite 저장소는 채우지 않습니다. 그러니 어떤 숫자를
    향해 세지 말고 <code>has_more</code>로 반복하십시오.
  </p>

  <CodeSwitcher class="not-prose my-6" samples={paging} title="페이지 넘기기" />

  <h2>실행을 찾은 뒤에</h2>
  <p>
    이 쿼리들에서 얻은 트레이스 id는
    <code>GET /v1/api/traces/{'{trace_id}'}</code>로 가져가면 됩니다. 그 실행과 그 안의
    모든 스팬을 돌려주며, 두 번째 요청 없이 워터폴이 그려지도록 이미 순서가 잡혀 있습니다.
    <code>include=logs,scores,feedback</code>을 붙이면 그것에 딸린 모든 것을 같은 응답으로
    받습니다.
  </p>
  <p>
    거기서부터,
    <a href={linkTo('/docs/cost')} class="link">비용 산정</a>이 각 단계의 수치를 설명하고,
    <a href={linkTo('/docs/reference/api')} class="link">HTTP API 레퍼런스</a>가 명세가
    선언한 대로 모든 엔드포인트와 필드를 나열합니다.
  </p>
</Doc>
