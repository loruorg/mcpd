---
import Doc from '@/layouts/Doc.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import TerminalCast from '@/components/TerminalCast.astro'
import { localeOf, urlFor } from '@/lib/i18n'

/* 영어 라우트를 이 언어에 맞게 다시 만듭니다. */
const code = localeOf(Astro.url.pathname)
const to = (route: string) => urlFor(route, code)

const composeEnv = `services:
  mcpd:
    image: ghcr.io/mcpd/mcpd
    ports: ['4317:4317']
    volumes: ['mcpd-data:/data']
    environment:
      MCPD_LISTEN: 0.0.0.0:4317
      MCPD_DATA: /data/mcpd.db
      MCPD_PROJECT: checkout
      MCPD_RETENTION_DAYS: '30'
      MCPD_INGEST_KEYS: write-key-one,write-key-two
      MCPD_READ_KEYS: read-key
      MCPD_REDACT_KEY: a-long-random-string
      MCPD_LOG_FORMAT: json
      MCPD_LOG: mcpd=info,mcpd_server=warn

volumes:
  mcpd-data:`
---

<Doc
  title="설정"
  description="mcpd의 모든 플래그와 환경 변수, 그리고 각각의 기본값. 리슨 주소, 데이터 경로, 프로젝트, 보존 기간, 수집 키와 읽기 키, 샘플링, 마스킹, 허용 오리진, 요청 기한, 로깅."
  lede="설정 하나는 플래그 하나이고, 모든 플래그에는 뜻이 같은 환경 변수가 있습니다. 명령줄에 담기에는 구조가 복잡한 몇 가지는 JSON 파일 하나에 들어 있습니다. 이 페이지는 그 전부입니다."
  og="docs"
>
  <h2>같은 것을 말하는 두 가지 방법</h2>
  <p>
    인자 없이 mcpd를 실행하면 그대로 동작합니다. <code>0.0.0.0:4317</code>에서
    듣고, 데이터를 <code>./mcpd.db</code>에 두고, 비밀 값을 마스킹하고,
    모든 트레이스를 영구히 보관합니다. 아래의 모든 항목은 그 결정 가운데
    하나를 바꿉니다.
  </p>
  <p>
    플래그는 언제나 대응하는 환경 변수를 이깁니다. 둘 다 전역이므로 하위 명령
    앞에 두든 뒤에 두든 받아들여집니다.
  </p>

