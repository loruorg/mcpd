---
import Base from '@/layouts/Base.astro'
import App from '@/components/app/App'
---

<Base
  title="Interface"
  description="The mcpd operator interface: search every run, read the log stream, follow a line back to the run that wrote it, see where the spend went, and watch a durable workflow's journal as it moves."
  og="app"
  noindex
>
  {/* The interface renders client-side, so without this the document has no
      heading at all: no outline for a screen reader, and nothing to announce
      on arrival. Visually hidden because the rail already names the page. */}
  <h1 class="sr-only">mcpd operator interface</h1>
  {/* Without JavaScript the island never mounts and the page was blank. The
      reader still needs to know what this page is and where the daemon is. */}
  <noscript>
    <div class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8">
      <p class="display text-[clamp(1.6rem,3.4vw,2.25rem)]">
        The interface needs JavaScript to read a daemon.
      </p>
      <p class="mt-4 max-w-[58ch] text-[0.9375rem] leading-relaxed text-ink-2">
        This page is a static bundle that talks to the mcpd you point it at,
        <span class="data text-ink">http://localhost:4317</span> unless you say
        otherwise. Turn JavaScript on for this site, and if no daemon is running
        yet start one with
        <span class="data text-ink">docker run -p 4317:4317 ghcr.io/mcpd/mcpd demo</span>.
      </p>
    </div>
  </noscript>
  <App client:only="react" />
</Base>

<style is:global>
  /* The live-tail pip. Slow, so it reads as a heartbeat rather than a flicker,
     and it stops entirely when motion is reduced. */
  .mcpd-tail-pip { animation: mcpd-tail 2s ease-in-out infinite; }
  @keyframes mcpd-tail {
    0%, 100% { opacity: 0.35; }
    50%      { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mcpd-tail-pip { animation: none; opacity: 1; }
  }

  /* A search hit inside a log line. The panel's own selection tint, so a marked
     word reads as the same gesture as selecting one, and the ink is untouched
     so a highlighted line is exactly as readable as an unhighlighted one. */
  .log-match {
    background: color-mix(in oklab, var(--color-amber) 22%, transparent);
    color: inherit;
    border-radius: 1px;
  }
</style>
