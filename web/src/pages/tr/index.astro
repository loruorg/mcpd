---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const title = 'Kalıp dayatmayan ajan gözlemevi'
const description =
  'Yapay zekâ ajanları için ücretsiz, açık kaynak gözlemlenebilirlik. Her framework, ' +
  'dil ve model sağlayıcı; OpenTelemetry veya altı SDK ile. ' +
  "Kendiniz barındırın veya mcpd.sh'de ücretsiz kullanın."

const copy: HomeCopy = {
  h1: 'Kalıp dayatmayan ajan gözlemevi.',
  lede:
    'Yayına aldığınız her ajanın her çalıştırmasını görün: her model çağrısı, araç ' +
    "çağrısı ve getirme; prompt'u, yanıtı ve maliyetiyle. Her framework, her dil, " +
    'her model sağlayıcı. Benimsemeniz gereken hiçbir şey yok.',
  startFree: 'Ücretsiz başlayın',
  selfHost: 'Kendiniz barındırın',
  heroNote: 'Tüm özellikleriyle ücretsiz barındırılan sürüm ya da kendi makinenizde tek bir açık kaynaklı ikili dosya.',

  worksTitle: 'Zaten kullandıklarınızla çalışır.',
  worksBody:
    'mcpd OpenTelemetry verisi alır ve model çağrıları için hem OpenTelemetry hem ' +
    'OpenInference kurallarını okur; yığınınız için var olan ölçümleme olduğu gibi ' +
    "çalışır. Ajanınız framework'ünü, siz de kodunuzu korursunuz.",
  otelLabel: "Herhangi bir OpenTelemetry dışa aktarıcısını mcpd'ye yöneltin",
  sdkLead: 'Ya da bir SDK ekleyin:',
  frameworksLegend: "Ajan framework'leri",
  providersLegend: 'Model sağlayıcılar',
  ownLoop: 'Kendi döngünüz',

  seeTitle: 'Her adım, kanıtıyla.',
  seeBody:
    'Bir çalıştırma, model çağrıları, araç çağrıları ve getirmelerden oluşan bir ağaçtır. ' +
    "Herhangi bir adımı açıp tam prompt'u ve yanıtı, kullandığı token'ları ve maliyetini " +
    'okuyun. Arama, bir çalıştırmayı modelin söylediklerinden bulur; her log satırı da ' +
    'onu yazan adıma bağlanır.',
  seeFacts: [
    'Her çalıştırmanın şelale görünümü, tek bir saatte',
    'Araç çağrıları dahil tüm konuşma',
    'Çalıştırma, model ve proje başına maliyet',
    "Trace id ile birleşen loglar, metrikler ve trace'ler",
  ],
  openInterface: 'Arayüzü açın',

  flowTitle: 'Çökmeye dayanan iş akışları.',
  flowBody:
    'Adımları kendi kodunuzla, altı dilden birinde yazın. Adımlar arasında çalıştırmayı ' +
    'mcpd tutar: yeniden denemeler, zamanlayıcılar ve bir hafta sürebilecek olay ' +
    'beklemeleri. Bir worker adımın ortasında ölürse adımı bir başkası devralır.',
  flowNotes: [
    ['Her adımı kodunuz çalıştırır', "Daemon hiçbir modeli, prompt'u veya kimlik bilgisini görmez. Worker'lar adımları tek tek üstlenir."],
    ['Beklemeler süreç tutmaz', 'Bir uyku ya da onay beklemesi, hiçbir süreç ayakta olmadan çalıştırmayı tutar; bir dağıtım boyunca da, bir hafta boyunca da.'],
    ["Her çalıştırma bir trace'tir", "Her adım girdisi, çıktısı ve maliyetiyle bir span'dir; böylece arama ve puanlama çalıştırmalarda da çalışır."],
  ],
  flowLink: 'İş akışlarını okuyun',

  evalTitle: 'Kalite düşünce haberiniz olsun.',
  evalBody:
    'Her çalıştırmayı on üç yerleşik puanlayıcıyla ya da yargıç olarak bir modelle ' +
    'puanlayın. Üretimdeki çalıştırmalardan veri kümeleri oluşturun ve deneyleri ' +
    'karşılaştırın. İzleyiciler hata oranını, gecikmeyi, maliyeti ve puanları izler; ' +
    "biri değişince webhook'unuzu çağırır.",
  evalLink: 'Değerlendirme',
  alertLink: 'İzleyiciler ve uyarılar',

  deployTitle: 'Her yerde çalıştırın.',
  deployBody:
    'Depolaması ve arayüzü yerleşik tek bir ikili dosya. Dizüstünde SQLite, ekip için ' +
    'Postgres ya da ClickHouse, üretimde Docker ya da Kubernetes. Telemetri yok, ' +
    'lisans sunucusu yok.',
  deployLink: 'Dağıtım kılavuzu',
  targets: [
    ['Barındırılan', "mcpd.sh'de tüm özellikleriyle ücretsiz. Kaydolun ve ilk trace'inizi gönderin."],
    ['Dizüstünüz', 'Tek süreç, tek SQLite dosyası. Kurulacak başka bir şey yok.'],
    ['Docker', 'Tek konteyner, tek birim, tek port.'],
    ['Kubernetes', 'Arkasında Postgres ya da ClickHouse olan, proje başına anahtarlı bir Helm chart.'],
  ],
  ownLabel: 'Kendiniz çalıştırın',
  fromSource: 'Kaynaktan',

  closeTitle: "Beş dakikada ilk trace'iniz.",
  closeBody: 'Ücretsiz kaydolun ya da kendi makinenizde çalıştırın. İki yolda da aynı ürün.',
}
---

<Base title={title} description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
