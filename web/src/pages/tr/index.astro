---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* İç bağlantılar İngilizce route olarak yazılır ve burada yerelleştirilir.
   Türkçesi henüz yazılmamış bir route, arkasında hiçbir şey olmayan bir Türkçe
   adrese değil, İngilizce sayfaya gider. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

/* Başlık, sayıyı test düzeneğinden okur; `spell` İngilizce yazdığı için sayının
   Türkçe karşılığı burada duruyor. */
const SAYILAR = [
  'Sıfır', 'Bir', 'İki', 'Üç', 'Dört', 'Beş', 'Altı', 'Yedi', 'Sekiz',
  'Dokuz', 'On', 'On bir', 'On iki',
]
const yaziyla = (n: number): string => SAYILAR[n] ?? String(n)

const aciklama =
  'Yapay zekâ ajanları için ücretsiz, açık kaynaklı bir daemon. Bir iş akışını adımlar ' +
  'arasında tutar, işi her adımın içinde kodunuz yapar ve her adımı maliyetiyle ' +
  'birlikte bir trace olarak kaydeder.'
---

<Base
  title="Ajanlar için kalıcı çalıştırma ve gözlemlenebilirlik, tek bir ikili dosyada"
  description={aciklama}
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">
          Ajanınızın attığı her adım, sonuna kadar tutulur ve kayda geçer.
        </h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">
          mcpd bir daemon, bir framework değil. Bir çalıştırmayı adımlar arasında
          tutar: yeniden denemeleri, zamanlayıcıları, bir onay için haftalarca
          süren beklemeyi. İşi her adımın içinde, istediğiniz dilde, sizin
          kodunuz yapar. Her adım, maliyetiyle birlikte bir trace'e düşer.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">Model gecikmesi</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">örnek trace</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="Derleyin ve çalıştırın"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">
          Sonra <span class="data text-ink">localhost:4317</span> adresini açın. Hesap
          yok, ayağa kaldırılacak veritabanı yok, imzalanacak bir şey yok. Henüz bir
          sürüm yok: imaj da paketler de ilk sürümle birlikte gelir.
          <a href={url('/docs/quickstart')} class="link ml-1"
            >Beş dakikalık hızlı başlangıcı okuyun</a
          >.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Okunabilir bir çalıştırma.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Başarısız olan bir ajan, hatadan söz eden log satırında başarısız
          olmaz. Üç adım önce, model yanlış aracı seçtiğinde ve sonra aynı aracı
          bir kez daha seçtiğinde başarısız olur.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          mcpd çalıştırmanın tamamını bir ağaç olarak yeniden kurar: her model
          çağrısı, her araç çağrısı, her getirme; her birine iliştirilmiş tam
          prompt ve tamamlama, her birinin gecikmesi ve her birinin maliyeti.
        </p>
        <p class="mt-6">
          <a href={url('/app')} class="link">Arayüzü açın</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Kendisini başlatan süreçten sonra da yaşayan bir çalıştırma.
      </h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">
        Adımlar arasında çalıştırmayı daemon tutar. Bir adımın içindeki her şey
        sizin sürecinize aittir ve hiçbir şey devredilmez: ne model, ne prompt,
        ne de bir kimlik bilgisi.
      </p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Grafik veridir, gövdeler sizindir</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Bir iş akışı kodda bir kez yazılır. Grafik, daemon'un doğruladığı ve
          sürümlediği bir tanım olarak ona gider. Adım gövdeleri altı dilden
          herhangi birinde sizin sürecinizde kalır ve bir worker onları sunar.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Yeniden denemeler, zamanlayıcılar ve beklemeler birer satırdır
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Geçici bir hata, adımın kendi bütçesiyle yeniden denenir. Bir uyku ya
          da bir onay beklemesi, ayakta hiçbir süreç olmadan çalıştırmayı tutar:
          bir dağıtım, bir çökme ya da bir hafta boyunca. Bir olay, beklemeyi ad
          ve anahtarla yanıtlar; tekrar gelen olay ikinci bir çalıştırma değil,
          bir yinelemedir.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Her çalıştırma bir trace'tir</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Her adım; girdisi, çıktısı ve bildirdiği kullanımıyla bir span'dir ve
          diğer bütün span'lerle aynı fiyat kitabından fiyatlandırılır. Adımın
          içindeki model çağrısı onun altında durur; böylece arama, maliyet ve
          puanlayıcılar bir çalıştırma üzerinde değişmeden çalışır.
        </p>
      </div>
    </div>
    <p class="mt-8">
      <a href={url('/docs/workflows')} class="link">İş akışlarını okuyun</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
          Zaten yazdığınız dilde ölçümleyin.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Altı SDK, tek bir davranış. Bir span kaydetmek asla bloklamaz, asla
          hata fırlatmaz ve sınırsızca büyümez: mcpd'ye ulaşılamıyorsa ajanınız
          bunu fark etmez; gözlemlenebilirliğin bozulabileceği tek kabul
          edilebilir biçim de budur. Her SDK bir worker da taşır, böylece kalıcı
          bir çalıştırmanın adımları onları kaydeden sürecin içinden sunulur.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          Hiçbiri zorunlu değil. <span class="data text-ink"
            >OTEL_EXPORTER_OTLP_ENDPOINT</span
          > değişkenini mcpd'ye yöneltin; zaten çalıştırdığınız bir OpenTelemetry SDK'sı,
          uygulamanızda bizim kodumuz olmadan ona ulaşır. Bu altısı bir HTTP yüzeyinin
          üzerindeki kolaylıktır, kaydedilmenin koşulu değil.
        </p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">
          Bir framework'ün içinde gelen gözlemlenebilirlik, yalnızca o
          framework'le yazılmış ajanları kaydedebilir. mcpd, OTLP endpoint'ine ne
          ulaşırsa onu alır: bir ajan framework'ü, kendi yazdığınız bir döngü ya
          da ikisinin çağırdığı servisler.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={url('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={url('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={url('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={url('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={url('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={url('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="bir çalıştırmayı ölçümleme" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Altı sinyal, onları üreten çalıştırmayla ilişkilendirilir.
    </h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">
      Çoğu araç trace'leri bir yerde, logları başka bir yerde verir ve zaman
      damgalarını gözünüzle eşleştirmeyi size bırakır. mcpd altı sinyalin hepsini
      aynı trace ve span kimlikleri altında saklar; böylece bir grafikteki sıçrama
      ona yol açan çalıştırmayı açar, bir çalıştırma da ürettiği log satırlarını
      gösterir.
    </p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      {yaziyla(CHANNELS.length)} dil, birbiriyle uyuşuyor.
    </h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Her SDK kendi başına test edilir; bu, her birinin yazarlarının istediği
        şeyi yaptığını kanıtlar ama birbirleriyle örtüşüp örtüşmediklerine dair
        hiçbir şey söylemez. Bu yüzden hepsi aynı çalıştırmayı tek bir daemon
        üzerine yazar, trace'ler geri okunur ve birbiriyle karşılaştırılır.
      </p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Bir dilde geçerli olup bir başkasında olmayan davranış yalnızca orada
        görünür. Her değişiklikte CI içinde çalışır.
        <a href={url('/docs/from-mastra')} class="link ml-1">Karşılaştırmayı okuyun</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Kimin neyi okuduğu, geri çevrilenler dahil.
      </h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">
        Bir güvenlik incelemesini belirleyen soru, verinin güvende olup olmadığı
        değildir. Sonradan, ona kimin eriştiğini gösterebilmenizdir.
      </p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Altı anahtar kapsamı</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Telemetri göndermek, prompt'ları okumak, saklanan veriyi değiştirmek,
          onu yok etmek, çalıştırma başlatmak ve adım talep etmek ayrı yetkilerdir.
          Tanımsız bir yazma listesi alım anahtarlarını, tanımsız bir yönetim
          listesi okuma anahtarlarını kabul eder. Tanımsız execute ve worker
          listeleri yazma anahtarlarını kabul eder. Yükseltme sizi dışarıda
          bırakmaz.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Proje bir sınırdır</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Anahtarlar, saklama ve örnekleme proje başınadır. Bir projenin altında
          listelenen anahtar yalnızca o projeye ulaşır ve daemon, bir veri
          kümesinden tek bir kayıt döndürmeden önce kümenin sahibini çözer.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Hiçbir şey merkeze bağlanmaz</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Daemon'un tamamında dışarı istek atan dört yer vardır ve hepsini siz
          yapılandırırsınız: iletici, iki webhook ve yargıç. Güncelleme denetimi
          yok, telemetri yok, lisans sunucusu yok.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Hangi anahtar, hangi kişi</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Defter anahtarın adını yazar. mcpd'ye ingress'inizin zaten koyduğu
          başlığı ve onu koymasına izin verilen adresleri verin, kişinin adını da
          yazsın. Başka bir yerden gelen başlık, herkesin öne sürebileceği bir
          iddiadır; satır bu yüzden tahmin taşımaktansa boş kalır.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Silme talebi tek bir çağrıdır</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Tek bir DELETE, bir kişiye karşı kaydedilmiş her çalıştırmayı, onlara
          bağlı span'ler, loglar, metrikler, puanlar ve geri bildirimlerle
          birlikte siler ve sinyal başına bir sayıyla yanıt verir. O anahtarın
          açamadığı bir projedeki satırlara ne dokunulur ne de sayılır.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Güvenmeden önce denetleyin</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          <span class="data text-ink">mcpd doctor</span> bir dağıtımı notlandırır:
          depo bir yazmayı alıp geri veriyor mu, bir kapsam açık mı bırakılmış,
          yapılandırılmış bir proje hiç span almış mı. Sizden bir şey yapmanızı
          istediği her maddede, onu düzelten seçeneğin adı yazar.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">
            İlk trace'inize beş dakika.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
            Daemon'u çalıştırın, ajanınızı ona yöneltin, arayüzü açın. Bundan
            uzun sürüyorsa bu bir hatadır ve bildirimini almak isteriz.
          </p>
        </div>
        <Command
          variant="floor"
          label="Başlayın"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
