---
import Doc from '@/layouts/Doc.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'
import { localeOf, urlFor } from '@/lib/i18n'

const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, code)

const destinations = `{
  "forward": [
    {
      "vendor": "langfuse",
      "region": "eu",
      "public_key": "\${LANGFUSE_PUBLIC_KEY}",
      "secret_key": "\${LANGFUSE_SECRET_KEY}",
      "filter": { "projects": ["checkout"], "sample": 0.25 },
      "redact": { "key_contains": ["email"] }
    },
    {
      "name": "honeycomb-prod",
      "vendor": "honeycomb",
      "api_key": "\${HONEYCOMB_API_KEY}",
      "dataset": "agents",
      "signals": { "traces": true, "logs": true, "metrics": false }
    },
    {
      "name": "collector",
      "endpoint": "https://otel.internal.example.com:4318",
      "protocol": "protobuf",
      "headers": { "Authorization": "Bearer \${COLLECTOR_TOKEN}" },
      "redact": { "drop_payloads": true }
    }
  ]
}`
---

<Doc
  title="转发"
  description="把 mcpd 存下的数据复制到一个或多个目的地：Langfuse、LangSmith、Braintrust、Arize、Phoenix、Datadog、Honeycomb、New Relic、Grafana、Sentry、Weave、Laminar、Helicone、Opik、Elastic、Dynatrace，或任何 OTLP 接收方。本地存储永远先发生，每一份副本都在它自己的暂存区里等待，直到目的地收下它。"
  lede="mcpd 在两个方向上都讲 OTLP。到达这里的东西，没有一样会被困在这里。"
  og="docs"
>
  <h2>一个存储，按需要发出多份副本</h2>
  <p>
    mcpd 接收 OTLP，也发出 OTLP。一个目的地就是配置文件里的一个条目：一个厂商名、
    一份凭据，以及可选的过滤规则、脱敏规则和它接收的信号。mcpd 知道每个厂商的
    端点、认证请求头和它读取的属性名，所以你写的是密钥，而不是一套集成代码。
  </p>
  <p>
    这同时意味着采用 mcpd 是可逆的。把它指向你之前在用的那个东西，两个星期里两边
    都跑，然后对着眼前的数据来决定，而不是靠一次撤不回来的迁移。
  </p>

  <h2>把它打开</h2>
  <p>
    只有一个 OTLP 接收方时，用参数就够了。请给基础 URL，不要给
    <code>/v1/traces</code>：每种信号的路径会被追加上去。
  </p>

  <Command
    class="not-prose my-6"
    title="存在本地，并向外复制一份"
    command="mcpd serve --forward-endpoint https://otlp.example.com"
    primaryLabel="OTLP"
    secondary={[
      {
        label: '带请求头',
        command: "mcpd serve --forward-endpoint https://otlp.example.com --forward-header 'Authorization: Bearer $TOKEN'",
      },
      {
        label: '指定厂商',
        command: "mcpd serve --forward-vendor honeycomb --forward-header 'x-honeycomb-team: $HONEYCOMB_API_KEY'",
      },
      {
        label: 'Protobuf',
        command: 'mcpd serve --forward-endpoint https://otlp.example.com --forward-protocol protobuf',
      },
    ]}
  />

  <p>
    <code>--forward-vendor</code> 选定一个厂商的端点和约定；凭据放在
    <code>--forward-header</code> 里。厂商有默认端点时，可以省略
    <code>--forward-endpoint</code>。<code>--forward-protocol</code> 取
    <code>json</code>、<code>protobuf</code> 或 <code>grpc</code>。用参数给出的
    目的地会取代文件里的 <code>forward</code> 块，所以可以把某一个实例指向别处，
    而不必去改一份共享的 ConfigMap。
  </p>

  <h2>多个目的地</h2>
  <p>
    配置文件里的 <code>forward</code> 块接受一个对象形式的目的地，这是早先版本
    读取的写法，现在仍然有效；也接受一个由多个目的地组成的数组。每个目的地有自己的
    副本、自己的暂存区和自己的重试，所以一个慢的厂商永远拖不住一个快的厂商。
  </p>

  <pre><code class="language-json">{destinations}</code></pre>

  <p>
    任何字符串都可以写成 <code>$&#123;ENV_NAME&#125;</code>。它在启动时从环境
    变量里读取一次。变量未设置时，启动会被拒绝，并写明是哪个变量，所以 Secret 里
    缺了一份凭据，会是你在部署时就看到的错误，而不是一周后才发现的 401。
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>字段</th><th>作用</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><code>name</code></td>
          <td>目的地的名字，用作它指标上的 <code>destination</code> 标签，也用作它的暂存目录名。可以是字母、数字、<code>-</code>、<code>_</code> 和 <code>.</code>。默认是厂商名</td>
        </tr>
        <tr>
          <td><code>vendor</code></td>
          <td>下面的预设之一。默认是 <code>otlp</code></td>
        </tr>
        <tr>
          <td><code>endpoint</code></td>
          <td>基础 URL，不带 <code>/v1/traces</code>。<code>otlp</code>、<code>otlp_grpc</code>、<code>elastic</code> 和 <code>dynatrace</code> 必须填写；对于有默认端点的厂商，它会取代那个默认值</td>
        </tr>
        <tr>
          <td><code>protocol</code></td>
          <td><code>json</code>、<code>protobuf</code> 或 <code>grpc</code>。<code>otlp</code> 默认用 JSON，<code>otlp_grpc</code> 默认用 gRPC，其他每个厂商默认用 protobuf。Dynatrace 不接受 JSON</td>
        </tr>
        <tr>
          <td><code>headers</code></td>
          <td>一个 <code>[name, value]</code> 对的列表，或一个对象。与预设设置的请求头同名时，会取代那个请求头</td>
        </tr>
        <tr>
          <td><code>enabled</code></td>
          <td>设为 <code>false</code> 时，条目留在文件里，但什么都不发送</td>
        </tr>
        <tr>
          <td><code>batch_size</code></td>
          <td>每个请求的 span 数。默认 256</td>
        </tr>
        <tr>
          <td><code>conventions</code></td>
          <td>副本使用的属性名：<code>gen_ai</code>、<code>gen_ai_messages</code>、<code>openinference</code>、<code>langfuse</code>、<code>langsmith</code>、<code>braintrust</code> 或 <code>laminar</code>。默认用厂商自己的约定</td>
        </tr>
        <tr>
          <td><code>region</code></td>
          <td>选择厂商的区域端点，列在下表中</td>
        </tr>
        <tr>
          <td><code>api_key</code>、<code>token</code>、<code>public_key</code>、<code>secret_key</code>、<code>instance_id</code>、<code>space_id</code></td>
          <td>凭据。每个厂商读取下表写明的那几项，并把它们转成自己的请求头</td>
        </tr>
        <tr>
          <td><code>project</code>、<code>workspace</code>、<code>dataset</code>、<code>dsn</code></td>
          <td>副本落在厂商那边的哪个位置</td>
        </tr>
        <tr>
          <td><code>filter</code></td>
          <td>这个目的地接收哪些数据。见下文</td>
        </tr>
        <tr>
          <td><code>redact</code></td>
          <td>这个目的地的副本略去哪些内容。见下文</td>
        </tr>
        <tr>
          <td><code>signals</code></td>
          <td><code>traces</code>、<code>logs</code> 和 <code>metrics</code>，各自为 true 或 false。默认是厂商接受的每一种信号</td>
        </tr>
        <tr>
          <td><code>spool_max_bytes</code></td>
          <td>这个目的地的暂存区最多能容纳的字节数。默认取 <code>--spool-max-bytes</code></td>
        </tr>
      </tbody>
    </table>
  </div>

