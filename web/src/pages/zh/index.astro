---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const title = '不设限的智能体观测台'
const description =
  '面向 AI 智能体的免费开源可观测性工具。任意框架、任意语言、任意模型提供商，' +
  '通过 OpenTelemetry 或六个 SDK 接入。自托管一个二进制文件，或在 mcpd.sh 免费使用。'

const copy: HomeCopy = {
  h1: '不设限的智能体观测台。',
  lede:
    '你交付的每个智能体，每次运行都看得见：每次模型调用、工具调用和检索，' +
    '连同它的提示词、回答和成本。任意框架、任意语言、任意模型提供商。' +
    '不必改用任何东西。',
  startFree: '免费开始',
  selfHost: '自托管',
  heroNote: '托管版免费且功能齐全，也可以在自己的机器上运行一个开源二进制文件。',

  worksTitle: '兼容你已经在用的一切。',
  worksBody:
    'mcpd 接收 OpenTelemetry 数据，并能读懂 OpenTelemetry 和 OpenInference 两套' +
    '模型调用约定，所以你的技术栈现有的埋点原样可用。智能体保留它的框架，' +
    '你保留你的代码。',
  otelLabel: '把任意 OpenTelemetry 导出器指向 mcpd',
  sdkLead: '或者加一个 SDK：',
  frameworksLegend: '智能体框架',
  providersLegend: '模型提供商',
  ownLoop: '你自己的循环',

  seeTitle: '每一步都有据可查。',
  seeBody:
    '一次运行是一棵由模型调用、工具调用和检索组成的树。打开任意一步，就能看到' +
    '确切的提示词和回答、用掉的 token 和花费。搜索能按模型说过的话找到运行，' +
    '每行日志都链接回写下它的那一步。',
  seeFacts: [
    '每次运行的瀑布图，共用一条时间轴',
    '完整对话，包括工具调用',
    '按运行、模型和项目统计成本',
    '日志、指标和 trace 按 trace id 关联',
  ],
  openInterface: '打开界面',

  flowTitle: '崩溃也打不断的工作流。',
  flowBody:
    '用你自己的代码编写步骤，六种语言任选。步骤之间由 mcpd 保存运行：重试、' +
    '定时器，以及可能要等一周的事件。worker 在步骤中途挂掉，另一个 worker ' +
    '会接手这一步。',
  flowNotes: [
    ['每一步都由你的代码执行', '守护进程从不接触模型、提示词或凭据。worker 每次认领一个步骤。'],
    ['等待不占用进程', '睡眠或等待审批时不需要任何进程存活，运行照样保住，跨过一次发布或一整周。'],
    ['每次运行都是一条 trace', '每个步骤都是一个 span，带着输入、输出和成本，所以搜索和评分同样适用于运行。'],
  ],
  flowLink: '了解工作流',

  evalTitle: '质量下滑，第一时间知道。',
  evalBody:
    '用十三个内置评分器，或让模型担任评判，为每次运行打分。把生产环境的运行' +
    '变成数据集，对比实验。监控器盯着错误率、延迟、成本和分数，任何一项' +
    '出现变化，就调用你的 webhook。',
  evalLink: '评估',
  alertLink: '监控与告警',

  deployTitle: '在哪儿都能跑。',
  deployBody:
    '一个二进制文件，内置存储和界面。笔记本上用 SQLite，团队用 Postgres 或 ' +
    'ClickHouse，生产环境用 Docker 或 Kubernetes。没有遥测，也没有许可证服务器。',
  deployLink: '部署指南',
  targets: [
    ['托管版', '在 mcpd.sh 免费使用，功能齐全。注册后即可发送第一条 trace。'],
    ['你的笔记本', '一个进程，一个 SQLite 文件。无需安装其他东西。'],
    ['Docker', '一个容器，一个卷，一个端口。'],
    ['Kubernetes', '一个 Helm chart，后端用 Postgres 或 ClickHouse，每个项目各有密钥。'],
  ],
  ownLabel: '自己运行',
  fromSource: '从源码构建',

  closeTitle: '五分钟内看到第一条 trace。',
  closeBody: '免费注册，或在自己的机器上运行。两种方式，同一个产品。',
}
---

<Base title={title} description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
