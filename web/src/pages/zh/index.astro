---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { localeOf, urlFor } from '@/lib/i18n'
import { CHANNELS } from '@/lib/conformance'

/* Every internal link is written as its English route and rebuilt for this
   locale, so no path on this page is spelled out by hand. */
const code = localeOf(Astro.url.pathname)
const to = (route: string) => urlFor(route, code)

/* Chinese prose is written one paragraph to a line on purpose. A newline
   between two Han characters is only removed by the segment-break rule in
   browsers that implement it; the rest render it as a space, and a stray space
   inside a Chinese sentence is visible. */
const description =
  '面向 AI 智能体的免费开源守护进程。它在步骤之间保存工作流，每个步骤内部的工作由你自己的' +
  '代码用任意语言完成，并把每一步记录成一条带成本的 trace。'
---

<Base
  title="面向智能体的持久化运行与可观测性，只需一个二进制文件"
  description={description}
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">智能体走的每一步，都保存到运行结束，并且留下记录。</h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">mcpd 是守护进程，不是框架。步骤之间的一切由它保存：重试、定时器、等待审批的那一整周；每个步骤内部的工作由你自己的代码完成，语言不限。每一步都会进入一条 trace，并带上它的成本。</p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">模型延迟</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">示例 trace</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="构建并运行"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">然后打开 <span class="data text-ink">localhost:4317</span>。无需账号，不用另外搭数据库，也不用签任何东西。目前还没有发布版本：镜像和软件包会随第一个版本一起发布。<a href={to('/docs/quickstart')} class="link ml-1">阅读五分钟快速开始</a>。</p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">一次读得懂的运行。</h2>
        <p class="prose mt-5 text-[0.9375rem]">智能体出错的地方，不是写着报错的那行日志。它在三步之前就错了：模型选错了工具，然后又选了一次。</p>
        <p class="prose mt-4 text-[0.9375rem]">mcpd 把整次运行还原成一棵树：每次模型调用、每次工具调用、每次检索，各自附上当时确切的提示词和补全、各自的延迟，以及各自的成本。</p>
        <p class="mt-6">
          <a href={to('/app')} class="link">打开界面</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">一次运行，比启动它的进程活得更久。</h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">步骤之间，这次运行归守护进程持有。步骤内部的一切归你的进程所有，什么也不用交出去：模型不用，提示词不用，凭据也不用。</p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">图是数据，步骤主体归你</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">工作流用代码写一次。图作为一份定义交给守护进程，由它校验并记录版本。步骤主体留在你的进程里，六种语言任选，交给一个 worker 来执行。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">重试、定时器和等待都是数据行</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">临时性失败会按该步骤自己的预算重试。睡眠或等待审批时不需要任何进程活着，这次运行照样保住，跨过一次发布、一次崩溃，或者一个星期。事件按名称和键回应等待，重复的事件算重复投递，不会变成第二次运行。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">每次运行都是一条 trace</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">每个步骤都是一个 span，带着它的输入、输出和上报的用量，用给其他 span 定价的同一份价目表计价。步骤内部的模型调用挂在它下面，所以搜索、成本和评分器面对一次运行时不用改动。</p>
      </div>
    </div>
    <p class="mt-8">
      <a href={to('/docs/workflows')} class="link">了解工作流</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">用你已经在写的语言接入。</h2>
        <p class="prose mt-5 text-[0.9375rem]">六个 SDK，一套行为。记录一个 span 不会阻塞、不会抛异常，也不会无限增长：mcpd 不可达时你的智能体察觉不到，而这是可观测性唯一可以接受的失败方式。每个 SDK 还自带一个 worker，所以持久化运行的各个步骤，由记录它们的同一个进程来执行。</p>
        <p class="prose mt-4 text-[0.9375rem]">它们都不是必需的。把 <span class="data text-ink">OTEL_EXPORTER_OTLP_ENDPOINT</span> 指向 mcpd，你已经在跑的 OpenTelemetry SDK 就能把数据送到，应用里不会有我们的一行代码。这六个 SDK 只是 HTTP 接口之上的便利封装，不是被记录的前提。</p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">跟着框架一起交付的可观测性，只能记录用那个框架写的智能体。mcpd 接收任何到达它 OTLP 端点的数据：一个智能体框架、你自己写的循环，或者两者调用的服务。</p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={to('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={to('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={to('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={to('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={to('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={to('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="接入一次运行" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">六种信号，由产生它们的那次运行关联起来。</h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">多数工具把 trace 放在一处，把日志放在另一处，剩下的时间戳留给你用眼睛对。mcpd 把六种信号都存在同一组 trace id 和 span id 上，所以图表上的一个尖峰能打开引发它的那次运行，一次运行也能列出它输出的日志行。</p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. Chinese opens on the digit, so the English speller
        is not used. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">{CHANNELS.length} 种语言，说法一致。</h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">每个 SDK 都单独测过，那只能证明它做到了作者的本意，说明不了几个 SDK 之间是否一致。所以让它们各自向同一个守护进程写入同一次运行，再把 trace 读回来相互比对。</p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">某个行为在一种语言里成立、在另一种语言里不成立，只有在这里才会暴露出来。每次改动都会在 CI 里跑一遍。<a href={to('/docs/from-mastra')} class="link ml-1">与现有方案的对比</a>。</p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">谁读了什么，包括谁被挡了回去。</h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">决定一次安全评审的问题，不是这些数据安不安全，而是事后你能不能拿出证据，说明谁访问过它。</p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">六种密钥权限</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">发送遥测数据、读取提示词、修改已存数据、销毁数据、启动运行和领取步骤，是不同的权限。不设置 write 时它接受 ingest 密钥，不设置 admin 时它接受 read 密钥。不设置 execute 和 worker 时，它们接受 write 密钥。升级不会把你挡在门外。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">项目就是边界</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">密钥、保留期和采样都按项目设置。列在某个项目下的密钥只能访问那个项目，守护进程会先确认一份数据归谁所有，然后才返回其中任何一条。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">不会向外回传</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">整个守护进程里只有四处会发出站请求，每一处都由你配置：转发器、两个 webhook 和裁判模型。没有更新检查，没有遥测，也没有许可证服务器。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">哪把密钥，哪个人</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">审计日志会写明是哪把密钥。把你的入口网关已经设置的请求头，以及允许设置它的地址交给 mcpd，它还会写明是哪个人。从其他地方发来的请求头，只是任何人都能提出的说法，所以那一栏宁可留空，也不写一个猜测。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">一次删除请求就是一次调用</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">一次 DELETE 会删除记在某个人名下的每一次运行，连同挂在它们下面的 span、日志、指标、评分和反馈，并按信号分别给出数量。该密钥打不开的项目里的数据，既不会被改动，也不会被计入。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">先检查，再信任</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2"><span class="data text-ink">mcpd doctor</span> 会给一套部署评级：存储能不能写进去再读回来，是否有权限被留在开放状态，配置过的项目是否收到过 span。任何需要你处理的问题，它都会指出修好它的那个参数。</p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">五分钟拿到第一条 trace。</h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">跑起守护进程，把智能体指向它，打开界面。如果用的时间比这更长，那就是一个缺陷，我们希望收到报告。</p>
        </div>
        <Command
          variant="floor"
          label="开始"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: '从源码构建', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
