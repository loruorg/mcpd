---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const description =
  'Observabilidade gratuita e open source para agentes de IA. Qualquer framework, ' +
  'linguagem ou provedor de modelos, via OpenTelemetry ou seis SDKs. Hospede um único ' +
  'binário ou use grátis em mcpd.sh.'

const copy: HomeCopy = {
  h1: 'O observatório de agentes sem amarras.',
  lede:
    'Veja cada execução de cada agente que você entrega: cada chamada de modelo, cada ' +
    'chamada de ferramenta e cada recuperação, com o prompt, a resposta e o custo. ' +
    'Qualquer framework, qualquer linguagem, qualquer provedor de modelos. Nada para adotar.',
  startFree: 'Comece grátis',
  selfHost: 'Hospede você mesmo',
  heroNote: 'Hospedado grátis com todos os recursos, ou um binário open source na sua própria máquina.',

  worksTitle: 'Funciona com o que você já usa.',
  worksBody:
    'O mcpd recebe OpenTelemetry e lê as convenções do OpenTelemetry e do OpenInference ' +
    'para chamadas de modelo, então a instrumentação que já existe para o seu stack ' +
    'funciona como está. O seu agente mantém o framework, e você mantém o seu código.',
  otelLabel: 'Aponte qualquer exportador do OpenTelemetry para o mcpd',
  sdkLead: 'Ou adicione um SDK:',
  frameworksLegend: 'Frameworks de agentes',
  providersLegend: 'Provedores de modelos',
  ownLoop: 'O seu próprio laço',

  seeTitle: 'Cada etapa, com as evidências.',
  seeBody:
    'Uma execução é uma árvore de chamadas de modelo, chamadas de ferramenta e ' +
    'recuperações. Abra qualquer etapa para ler o prompt e a resposta exatos, os tokens ' +
    'usados e quanto custou. A busca encontra uma execução pelo que o modelo disse, e cada ' +
    'linha de log aponta para a etapa que a escreveu.',
  seeFacts: [
    'Uma cascata de cada execução, em um único relógio',
    'A conversa completa, com as chamadas de ferramenta',
    'Custo por execução, por modelo e por projeto',
    'Logs, métricas e traces ligados pelo trace id',
  ],
  openInterface: 'Abra a interface',

  flowTitle: 'Workflows que sobrevivem a uma falha.',
  flowBody:
    'Escreva as etapas no seu próprio código, em qualquer uma das seis linguagens. O mcpd ' +
    'segura a execução entre elas: novas tentativas, timers e esperas por um evento que ' +
    'pode levar uma semana. Se um worker cai no meio de uma etapa, outro a assume.',
  flowNotes: [
    ['O seu código executa cada etapa', 'O daemon nunca vê um modelo, um prompt ou uma credencial. Os workers pegam uma etapa por vez.'],
    ['Esperar não prende processo', 'Um sleep ou uma espera por aprovação segura a execução sem nenhum processo vivo, durante um deploy ou por uma semana.'],
    ['Toda execução é um trace', 'Cada etapa é um span com entrada, saída e custo, então a busca e a avaliação também funcionam sobre as execuções.'],
  ],
  flowLink: 'Leia sobre workflows',

  evalTitle: 'Saiba quando a qualidade cai.',
  evalBody:
    'Avalie cada execução com treze avaliadores embutidos ou com um modelo como juiz. ' +
    'Transforme execuções de produção em datasets e compare experimentos. Os monitores ' +
    'acompanham taxa de erro, latência, custo e pontuações, e chamam o seu webhook quando ' +
    'um deles se move.',
  evalLink: 'Avaliação',
  alertLink: 'Monitores e alertas',

  deployTitle: 'Rode em qualquer lugar.',
  deployBody:
    'Um único binário com o armazenamento e a interface embutidos. SQLite em um notebook, ' +
    'Postgres ou ClickHouse para uma equipe, Docker ou Kubernetes em produção. Sem ' +
    'telemetria e sem servidor de licenças.',
  deployLink: 'Guia de implantação',
  targets: [
    ['Hospedado', 'Grátis em mcpd.sh com todos os recursos. Cadastre-se e envie o seu primeiro trace.'],
    ['O seu notebook', 'Um processo e um arquivo SQLite. Nada mais para instalar.'],
    ['Docker', 'Um container, um volume, uma porta.'],
    ['Kubernetes', 'Um chart do Helm, com Postgres ou ClickHouse por trás e chaves por projeto.'],
  ],
  ownLabel: 'Rode o seu',
  fromSource: 'A partir do código',

  closeTitle: 'O seu primeiro trace em cinco minutos.',
  closeBody: 'Cadastre-se grátis ou rode na sua própria máquina. O mesmo produto nos dois casos.',
}
---

<Base title="O observatório de agentes sem amarras" description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
