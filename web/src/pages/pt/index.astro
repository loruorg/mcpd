---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* Os links internos continuam escritos como rotas em inglês e são localizados
   aqui. Uma rota cuja página em português ainda não existe leva para a página
   em inglês, em vez de para um URL em português sem nada atrás. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

/* O título lê a contagem da bancada de conformidade, então o número precisa ser
   escrito por extenso em português: `spell` escreve palavras em inglês. As
   formas são femininas porque acompanham "linguagens". */
const PALAVRAS = [
  'Nenhuma', 'Uma', 'Duas', 'Três', 'Quatro', 'Cinco', 'Seis', 'Sete', 'Oito',
  'Nove', 'Dez', 'Onze', 'Doze',
]
const porExtenso = (n: number): string => PALAVRAS[n] ?? String(n)

const descricao =
  'Um daemon gratuito e open source para agentes de IA. Ele mantém um workflow entre as ' +
  'etapas, o seu código trabalha dentro de cada uma em qualquer linguagem, e cada etapa ' +
  'vira um trace com o custo.'
---

<Base
  title="Execuções duráveis e observabilidade para agentes, em um único binário"
  description={descricao}
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">
          Cada etapa que o seu agente dá, mantida até o fim e registrada.
        </h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">
          O mcpd é um daemon, não um framework. Ele segura uma execução entre as
          etapas: as repetições, os temporizadores, a semana de espera por uma
          aprovação, enquanto o seu próprio código faz o trabalho dentro de cada
          etapa, em qualquer linguagem. Cada etapa cai em um trace com o que
          custou.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">Latência do modelo</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">trace de exemplo</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="Compile e execute"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">
          Depois abra <span class="data text-ink">localhost:4317</span>. Sem conta,
          sem banco de dados para subir, nada para assinar. Ainda não há release: a
          imagem e os pacotes chegam junto com a primeira.
          <a href={url('/docs/quickstart')} class="link ml-1"
            >Leia o início rápido de cinco minutos</a
          >.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Uma execução que dá para ler.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Um agente que falha não falha na linha de log que menciona o erro. Ele
          falha três etapas antes, quando o modelo escolheu a ferramenta errada e
          depois escolheu de novo.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          O mcpd reconstrói a execução inteira como uma árvore: cada chamada de
          modelo, cada chamada de ferramenta, cada recuperação, com o prompt e a
          resposta exatos anexados a cada uma, a latência de cada uma e quanto
          cada uma custou.
        </p>
        <p class="mt-6">
          <a href={url('/app')} class="link">Abra a interface</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Uma execução que sobrevive ao processo que a iniciou.
      </h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">
        O daemon é dono da execução entre as etapas. O seu processo é dono de
        tudo que acontece dentro de uma etapa, e não entrega nada: nem o modelo,
        nem o prompt, nem uma credencial.
      </p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">O grafo é dado, os corpos são seus</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Um workflow é escrito uma vez, em código. O grafo vai para o daemon
          como uma definição que ele valida e versiona. Os corpos das etapas
          ficam no seu processo, em qualquer uma das seis linguagens, para um
          worker servir.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Repetições, temporizadores e esperas são linhas</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Uma falha transitória é repetida dentro do orçamento da própria etapa.
          Um sleep ou uma espera por aprovação segura a execução sem nenhum
          processo vivo, atravessando uma implantação, uma queda ou uma semana.
          Um evento responde à espera por nome e por chave, e um evento que
          chega duas vezes é uma duplicata, não uma segunda execução.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Toda execução é um trace</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Cada etapa é um span com a sua entrada, a sua saída e o uso que ela
          reportou, precificado com a mesma tabela que precifica todos os outros
          spans. A chamada de modelo dentro de uma etapa fica abaixo dela, então
          a busca, o custo e os avaliadores funcionam sobre uma execução sem
          nenhuma mudança.
        </p>
      </div>
    </div>
    <p class="mt-8">
      <a href={url('/docs/workflows')} class="link">Leia sobre workflows</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
          Instrumente na linguagem que você já escreve.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Seis SDKs, um comportamento. Registrar um span nunca bloqueia, nunca
          lança uma exceção e nunca cresce sem limite: se o mcpd estiver
          inacessível, o seu agente não percebe, que é a única maneira aceitável
          de a observabilidade falhar. Cada um também traz um worker, então as
          etapas de uma execução durável são servidas pelo mesmo processo que as
          registra.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          Nenhum deles é obrigatório. Aponte <span class="data text-ink"
            >OTEL_EXPORTER_OTLP_ENDPOINT</span
          > para o mcpd e um SDK do OpenTelemetry que você já executa chega até ele,
          sem nenhum código nosso dentro da sua aplicação. Os seis são uma conveniência
          sobre uma superfície HTTP, não uma condição para ser registrado.
        </p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">
          A observabilidade que vem presa a um framework só consegue registrar
          agentes construídos com aquele framework. O mcpd aceita o que chegar ao
          seu endpoint OTLP: um framework de agentes, um laço que você mesmo
          escreveu, ou os serviços que qualquer um dos dois chama.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={url('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={url('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={url('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={url('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={url('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={url('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="instrumente uma execução" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Seis sinais, correlacionados pela execução que os produziu.
    </h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">
      A maioria das ferramentas dá os traces em um lugar e os logs em outro, e
      deixa você casar os horários no olho. O mcpd guarda os seis sinais sob os
      mesmos ids de trace e de span, então um pico em um gráfico abre a execução
      que o causou, e uma execução mostra as linhas de log que emitiu.
    </p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      {porExtenso(CHANNELS.length)} linguagens que concordam entre si.
    </h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Cada SDK é testado por conta própria, o que prova que cada um faz o que
        os seus autores quiseram e não prova nada sobre eles combinarem entre si.
        Por isso cada um escreve a mesma execução contra um único daemon, e os
        traces são lidos de volta e comparados uns com os outros.
      </p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Um comportamento que vale em uma linguagem e não vale em outra aparece
        ali e em nenhum outro lugar. Roda no CI a cada mudança.
        <a href={url('/docs/from-mastra')} class="link ml-1">Como isso se compara</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Quem leu o quê, inclusive quem foi barrado.
      </h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">
        A pergunta que decide uma revisão de segurança não é se os dados estão
        seguros. É se você consegue mostrar, depois, quem chegou até eles.
      </p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Seis escopos de chave</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Emitir telemetria, ler prompts, alterar dados guardados, destruí-los,
          iniciar execuções e reivindicar etapas são privilégios diferentes. Uma
          lista write sem definir aceita as chaves de ingestão, e uma lista admin
          sem definir aceita as chaves de leitura. Listas execute e worker sem
          definir aceitam as chaves de escrita. Atualizar não tranca você do lado
          de fora.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Um projeto é uma fronteira</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Chaves, retenção e amostragem são todas por projeto. Uma chave listada
          em um projeto alcança aquele projeto, e o daemon resolve de quem é um
          dataset antes de devolver um único caso dele.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Nada telefona para casa</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Existem quatro pontos de requisição para fora no daemon inteiro, e você
          configura cada um deles: o encaminhador, dois webhooks e o juiz. Não há
          verificação de atualização, telemetria nem servidor de licença.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Qual chave, e qual pessoa</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          O registro nomeia a chave. Dê ao mcpd o cabeçalho que o seu ingress já
          define, e os endereços autorizados a defini-lo, e ele nomeia também a
          pessoa. Vindo de qualquer outro lugar, um cabeçalho é uma afirmação que
          qualquer um poderia fazer, então a linha fica vazia em vez de carregar
          um palpite.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Um pedido de exclusão é uma chamada</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Um DELETE remove todas as execuções registradas para uma pessoa, com os
          spans, os logs, as métricas, as notas e os feedbacks pendurados nelas, e
          responde com uma contagem por sinal. Linhas de um projeto que aquela
          chave não pode abrir não são tocadas nem contadas.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Confira antes de confiar</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          <span class="data text-ink">mcpd doctor</span> avalia uma implantação:
          se o armazenamento aceita uma escrita e a devolve, se um escopo ficou
          aberto, se um projeto configurado já recebeu algum span. Tudo que ele
          quer que você resolva vem com o nome da opção que corrige.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">
            Cinco minutos até o seu primeiro trace.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
            Execute o daemon, aponte o seu agente para ele, abra a interface. Se
            demorar mais do que isso, é um defeito e nós queremos o relato.
          </p>
        </div>
        <Command
          variant="floor"
          label="Começar"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: 'A partir do código', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
