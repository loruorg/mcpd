---
import Doc from '@/layouts/Doc.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* Os links internos continuam escritos como rotas em inglês e são localizados
   aqui. Uma rota cuja página em português ainda não existe leva para a página
   em inglês, em vez de para um URL em português sem nada atrás. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

const exporterEnv = `# O URL base. O próprio exportador acrescenta /v1/traces.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# http/protobuf, http/json e grpc funcionam todos nesta mesma porta.
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Opcional. Mande gzip se os seus payloads forem grandes.
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Só quando o mcpd roda com --ingest-key.
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer YOUR_INGEST_KEY"`

const rawPost = `curl -X POST http://localhost:4317/v1/traces \\
  -H 'content-type: application/json' \\
  -d '{
  "resourceSpans": [{
    "resource": { "attributes": [
      { "key": "service.name", "value": { "stringValue": "checkout-agent" } }
    ]},
    "scopeSpans": [{
      "spans": [{
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "name": "chat gpt-4o",
        "startTimeUnixNano": "1700000000000000000",
        "endTimeUnixNano": "1700000001500000000",
        "status": { "code": 1 },
        "attributes": [
          { "key": "gen_ai.system", "value": { "stringValue": "openai" } },
          { "key": "gen_ai.request.model", "value": { "stringValue": "gpt-4o" } },
          { "key": "gen_ai.operation.name", "value": { "stringValue": "chat" } },
          { "key": "gen_ai.usage.input_tokens", "value": { "intValue": "1200" } },
          { "key": "gen_ai.usage.output_tokens", "value": { "intValue": "350" } }
        ]
      }]
    }]
  }]
}'

# {"partialSuccess":{"rejectedSpans":0,"errorMessage":""}}`

const grpcEnv = `# gRPC na mesma porta. Sem caminho: o exportador nomeia o serviço.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Só quando o mcpd roda com --ingest-key. As chaves de metadata do gRPC são minúsculas.
export OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer YOUR_INGEST_KEY"`

const collectorYaml = `# Um OpenTelemetry Collector que repassa tudo ao mcpd por gRPC.
receivers:
  otlp:
    protocols: { grpc: {}, http: {} }

exporters:
  otlp:
    endpoint: mcpd.internal:4317
    compression: gzip
    tls:
      insecure: true # o mcpd serve em texto claro; termine o TLS na frente dele
    headers:
      authorization: Bearer \${env:MCPD_INGEST_KEY}

service:
  pipelines:
    traces: { receivers: [otlp], exporters: [otlp] }
    logs: { receivers: [otlp], exporters: [otlp] }
    metrics: { receivers: [otlp], exporters: [otlp] }`

const zipkinEnv = `# Um SDK do OpenTelemetry, exportando no formato do Zipkin.
export OTEL_TRACES_EXPORTER=zipkin
export OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:4317/api/v2/spans

# Um reporter do Zipkin recebe o mesmo URL como endpoint, por exemplo
#   URLConnectionSender.create("http://localhost:4317/api/v2/spans")`

const zipkinPost = `curl -X POST http://localhost:4317/api/v2/spans \\
  -H 'content-type: application/json' \\
  -d '[{
  "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
  "id": "00f067aa0ba902b7",
  "kind": "CLIENT",
  "name": "chat gpt-4o",
  "timestamp": 1700000000000000,
  "duration": 1500000,
  "localEndpoint": { "serviceName": "checkout-agent" },
  "tags": { "gen_ai.system": "openai", "gen_ai.request.model": "gpt-4o" }
}]'

# HTTP 202 {"accepted":1,"rejected":0,"duplicate":0}`

const jaegerEnv = `# Uma biblioteca cliente do Jaeger, mandando Thrift por HTTP.
export JAEGER_ENDPOINT=http://localhost:4317/api/traces

# Qualquer coisa que fale a API gRPC de coletor do Jaeger, como o jaeger-agent.
jaeger-agent --reporter.grpc.host-port=localhost:4317`
---

<Doc
  title="OpenTelemetry"
  description="O mcpd aceita OTLP sobre HTTP e gRPC, Zipkin v2 e Jaeger numa porta só, e lê as convenções gen_ai.* do OpenTelemetry e llm.* do OpenInference. Nenhum código específico do mcpd."
  lede="Se o seu agente já emite OpenTelemetry, Zipkin ou Jaeger, o mcpd é uma troca de endpoint. Esta página é o caminho inteiro: os endpoints, as codificações, e cada atributo que o mcpd lê."
  og="docs"
>
  <h2>Os endpoints</h2>
  <p>
    O mcpd serve OTLP sobre HTTP e sobre gRPC, Zipkin e Jaeger na mesma porta
    da sua API de consulta e da sua interface. Não há coletor para rodar na
    frente dele, nem um segundo contêiner, nem uma porta de recepção separada.
    A porta aceita HTTP/1.1 e HTTP/2 em texto claro lado a lado, e uma chamada
    gRPC é uma requisição HTTP/2, então um endereço só serve todos os
    protocolos abaixo.
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Endpoint</th>
          <th>Aceita</th>
          <th>Responde com</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>POST /v1/traces</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partialSuccess.rejectedSpans</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/logs</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedLogRecords</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/metrics</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedDataPoints</code></td>
        </tr>
        <tr>
          <td>gRPC <code>TraceService/Export</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partial_success.rejected_spans</code></td>
        </tr>
        <tr>
          <td>gRPC <code>LogsService/Export</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partial_success.rejected_log_records</code></td>
        </tr>
        <tr>
          <td>gRPC <code>MetricsService/Export</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partial_success.rejected_data_points</code></td>
        </tr>
        <tr>
          <td><code>POST /api/v2/spans</code></td>
          <td>spans Zipkin v2, em JSON ou proto3</td>
          <td><code>202</code> com <code>accepted</code> e <code>rejected</code></td>
        </tr>
        <tr>
          <td><code>POST /api/traces</code></td>
          <td>um lote Jaeger em Thrift binário</td>
          <td><code>202</code> com <code>accepted</code> e <code>rejected</code></td>
        </tr>
        <tr>
          <td>gRPC <code>jaeger.api_v2.CollectorService/PostSpans</code></td>
          <td><code>PostSpansRequest</code></td>
          <td><code>PostSpansResponse</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Toda exportação OTLP bem-sucedida responde com o próprio formato
    <code>partialSuccess</code> do OTLP. Quando algo foi recusado, ele carrega a
    contagem e o motivo. É assim que um coletor avisa a quem enviou que
    descartou alguma coisa, e os exportadores leem esse campo. A resposta vem
    na codificação em que a exportação chegou: protobuf para protobuf, JSON
    para JSON.
  </p>

  <h2>Aponte um exportador para ele</h2>
  <p>
    Duas variáveis fazem o trabalho. Defina as duas no ambiente do processo que
    roda o seu agente, e nada mais muda.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exportador"
    samples={[{ lang: 'curl', label: 'Ambiente', shiki: 'bash', code: exporterEnv }]}
  />

  <p>
    Vale saber de dois detalhes antes de você depurar um silêncio. Primeiro,
    <code>OTEL_EXPORTER_OTLP_ENDPOINT</code> é um URL base e o exportador
    acrescenta o caminho do sinal a ele. Defina
    <code>OTEL_EXPORTER_OTLP_TRACES_ENDPOINT</code> se quiser dar o URL
    completo, caminho incluído. Segundo, a porta 4317 é por convenção a porta
    gRPC no OpenTelemetry, e a 4318 é a de HTTP. O mcpd serve as duas na 4317,
    porque serve tudo numa porta só. Um exportador definido como
    <code>grpc</code> o encontra na porta padrão; um exportador HTTP deixado na
    porta padrão manda para a 4318, então nomeie a porta.
  </p>

  <h2>OTLP sobre gRPC</h2>
  <p>
    Os três serviços de coletor do OTLP são servidos na mesma porta:
    <code>opentelemetry.proto.collector.trace.v1.TraceService</code>,
    <code>logs.v1.LogsService</code> e <code>metrics.v1.MetricsService</code>.
    Defina o protocolo do exportador como <code>grpc</code> e mantenha o
    endpoint:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exportador grpc"
    samples={[{ lang: 'curl', label: 'Ambiente', shiki: 'bash', code: grpcEnv }]}
  />

  <p>
    Uma chamada gRPC segue exatamente o caminho da porta HTTP correspondente: a
    mesma verificação de chave, o mesmo projeto para a chave de uma conta, os
    mesmos tetos, amostragem, redação e precificação, e o mesmo reconhecimento
    de uma exportação reenviada. A chave vai nos metadados da chamada como
    <code>authorization: Bearer</code>, ou como <code>x-mcpd-key</code>. Uma
    chamada recusada termina com o status gRPC sobre o qual um exportador age:
    <code>UNAUTHENTICATED</code> para uma chave ausente ou desconhecida,
    <code>PERMISSION_DENIED</code> para uma chave sem o escopo de ingestão,
    <code>INVALID_ARGUMENT</code> para uma mensagem que não decodifica,
    <code>RESOURCE_EXHAUSTED</code> além de um limite, e
    <code>UNAVAILABLE</code> quando o armazenamento não consegue aceitar a
    escrita, que os exportadores tentam de novo. Um método que o mcpd não serve
    responde <code>UNIMPLEMENTED</code>.
  </p>
  <p>
    As mensagens podem vir comprimidas com gzip
    (<code>grpc-encoding: gzip</code>). O listener fala HTTP/2 em texto claro.
    Para servir gRPC sobre TLS, termine o TLS num proxy e repasse HTTP/2 para o
    mcpd; o proxy precisa manter HTTP/2 no salto até o daemon, porque o gRPC
    não roda sobre HTTP/1.1.
  </p>
  <p>
    Um OpenTelemetry Collector repassa para o mcpd com o seu exportador OTLP:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="coletor"
    samples={[{ lang: 'curl', label: 'YAML', shiki: 'yaml', code: collectorYaml }]}
  />

  <h2>As duas codificações, para todo sinal</h2>
  <p>
    <code>/v1/traces</code>, <code>/v1/logs</code> e <code>/v1/metrics</code>
    leem o cabeçalho <code>content-type</code> e aceitam qualquer uma das duas
    codificações: OTLP/protobuf quando ele contém <code>protobuf</code>, e
    OTLP/JSON caso contrário. Protobuf é o padrão do OpenTelemetry, então um
    SDK sem modificação nenhuma apontado para o mcpd manda os três sinais e
    eles chegam sem configuração alguma. A mesma exportação guarda os mesmos
    registros em qualquer uma das codificações, até os ids pelos quais um
    reenvio é reconhecido.
  </p>

  <p>
    Quando nenhum <code>content-type</code> é mandado, o mcpd assume
    <code>application/json</code>.
  </p>

  <h2>Compressão e tamanho</h2>
  <p>
    O corpo de uma requisição pode chegar com <code>content-encoding: gzip</code>,
    com <code>identity</code>, ou sem cabeçalho de codificação. Qualquer outra
    coisa é recusada pelo nome: <code>content-encoding "br" is not supported; use gzip or send the
    body uncompressed</code>. As respostas são comprimidas
    por negociação de conteúdo, então um trace grande lido de volta por uma
    conexão lenta também vem comprimido.
  </p>
  <p>
    Dois limites valem para uma requisição. O limite de corpo é 32 MiB e é
    medido sobre o que chega, então gzip compra espaço para você. O limite de
    lote é 10.000 sinais, contados depois da decodificação em toda porta de
    ingestão: spans em <code>/v1/traces</code>, <code>/api/v2/spans</code>,
    <code>/api/traces</code> e nos seus serviços gRPC, registros em
    <code>/v1/logs</code>, pontos de dados em <code>/v1/metrics</code> e tudo
    que vem na requisição em <code>/v1/ingest</code>. Um corpo ou uma mensagem
    em gzip também é medido contra o limite de corpo depois de descomprimido.
    Um lote maior é recusado com <code>413 payload_too_large</code> nomeando os
    dois números. Os dois limites são ajustáveis:
    <code>--max-body-bytes</code> e <code>--max-batch-signals</code>, descritos
    em <a href={url('/docs/configuration')} class="link">Configuração</a>.
  </p>

  <h2>Zipkin</h2>
  <p>
    <code>POST /api/v2/spans</code> é o endpoint de spans v2 do Zipkin. Ele
    aceita um array JSON de spans, ou um <code>ListOfSpans</code> em proto3
    quando o <code>content-type</code> contém <code>protobuf</code>, com ou sem
    gzip, e responde <code>202</code>. Aponte para ele um reporter do Zipkin ou
    o exportador Zipkin de um SDK do OpenTelemetry:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exportador zipkin"
    samples={[{ lang: 'curl', label: 'Ambiente', shiki: 'bash', code: zipkinEnv }]}
  />

  <CodeSwitcher
    class="not-prose my-6"
    title="JSON do Zipkin cru"
    samples={[{ lang: 'curl', label: 'Shell', shiki: 'bash', code: zipkinPost }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Campo do Zipkin</th>
          <th>Vira</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>localEndpoint.serviceName</code></td><td>o serviço, o <code>service.name</code> do recurso</td></tr>
        <tr><td><code>tags</code></td><td>atributos do span, então as tags <code>gen_ai.*</code> e <code>llm.*</code> são lidas como no OTLP</td></tr>
        <tr><td><code>kind</code></td><td>o atributo <code>span.kind</code>, em minúsculas</td></tr>
        <tr><td><code>annotations</code></td><td>eventos do span, cada um nomeado pelo seu valor</td></tr>
        <tr><td><code>remoteEndpoint</code></td><td><code>peer.service</code>, <code>network.peer.address</code>, <code>network.peer.port</code></td></tr>
        <tr><td>tag <code>error</code>, ou <code>otel.status_code</code></td><td>o status, com o valor da tag como mensagem</td></tr>
        <tr><td><code>timestamp</code>, <code>duration</code></td><td>início e fim; um span sem duração não terminou</td></tr>
        <tr><td><code>debug</code></td><td>o bit de amostragem, então o amostrador mantém o trace</td></tr>
        <tr><td><code>parentId</code></td><td>o pai</td></tr>
        <tr><td><code>shared</code></td><td>uma metade servidor, guardada ao lado da sua metade cliente</td></tr>
      </tbody>
    </table>
  </div>

  <p>
    Um id de trace de 64 bits é completado até 128 bits com zeros à esquerda,
    que é o id que o OpenTelemetry dá ao mesmo trace. Um span servidor
    compartilhado reutiliza o id de span do seu cliente; o mcpd identifica um
    span pelo seu id, então a metade servidor é guardada sob um id derivado do
    compartilhado e tem ele como pai, e as duas metades são mantidas. Um span
    reenviado cai na mesma linha.
  </p>

  <h2>Jaeger</h2>
  <p>
    Duas portas de coletor do Jaeger são servidas: <code>POST /api/traces</code>,
    que aceita um <code>jaeger.Batch</code> no protocolo binário do Thrift
    (<code>application/x-thrift</code>) e responde <code>202</code>, e o
    serviço gRPC <code>jaeger.api_v2.CollectorService/PostSpans</code>. As duas
    mapeiam um span do mesmo jeito.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="jaeger"
    samples={[{ lang: 'curl', label: 'Ambiente', shiki: 'bash', code: jaegerEnv }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Campo do Jaeger</th>
          <th>Vira</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>serviceName</code> do processo</td><td>o serviço, o <code>service.name</code> do recurso</td></tr>
        <tr><td>tags do processo</td><td>atributos do recurso</td></tr>
        <tr><td>tags do span</td><td>atributos do span, com os tipos que o Jaeger deu</td></tr>
        <tr><td>logs</td><td>eventos do span, nomeados pelo campo <code>event</code></td></tr>
        <tr><td><code>parentSpanId</code>, ou o primeiro <code>CHILD_OF</code> no mesmo trace</td><td>o pai</td></tr>
        <tr><td>qualquer outra referência</td><td>um link de span, do tipo <code>child_of</code> ou <code>follows_from</code></td></tr>
        <tr><td>tag <code>error</code>, ou <code>otel.status_code</code></td><td>o status</td></tr>
        <tr><td>flag de amostragem ou de debug</td><td>o bit de amostragem</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Links de span</h2>
  <p>
    Um link diz que um span se relaciona com outro span, neste trace ou em
    outro, sem ser filho dele. O mcpd guarda os links de toda porta: os
    <code>links</code> de um span OTLP em qualquer codificação e por qualquer
    transporte, os <code>links</code> de um span nativo, e as referências de um
    span Jaeger que não são o seu pai. O tipo de um link vem do seu atributo
    <code>mcpd.link.kind</code>, ou de <code>opentracing.ref_type</code>, que é
    no que uma referência do Jaeger se transforma. Todo link é guardado com o
    span e devolvido com o trace.
  </p>

  <h2>O que acontece entre chegar e ficar guardado</h2>
  <p>
    Um span OTLP, um span Zipkin ou Jaeger e um span nativo seguem o mesmo
    caminho. É esse o sentido de o pipeline ser compartilhado: a ordem abaixo
    não pode divergir entre as portas.
  </p>

  <PipelineDiagram class="not-prose my-8" />

  <p>
    Precificar na ingestão é o motivo de um span OTLP receber um número de custo
    para começo de conversa. O mcpd o precifica com a tabela de preços com que
    este servidor está rodando, no instante em que ele chega, então mudar as
    suas tarifas depois não pode reescrever em silêncio o que o mês passado
    custou. Veja <a href={url('/docs/cost')} class="link">Apuração de custos</a>.
  </p>

  <h2>As duas convenções semânticas</h2>
  <p>
    Há dois conjuntos concorrentes de nomes de atributo em uso para spans de IA:
    o <code>gen_ai.*</code> do próprio OpenTelemetry e o <code>llm.*</code> do
    OpenInference, com <code>openinference.span.kind</code>. O mcpd lê os dois,
    e por cima deles os seus próprios nomes <code>mcpd.*</code>. Você não
    renomeia nada.
  </p>
  <p>
    Cada linha abaixo é lida em ordem, e a primeira que casar vence. Um atributo
    que nenhuma linha nomeia continua guardado: o mapa de atributos inteiro,
    achatado, fica no span, então nada do que você manda se perde por não ter
    sido mapeado.
  </p>

  <h3>Modelo, conteúdo e uso</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Campo do mcpd</th>
          <th>Lido de, nesta ordem</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>model</code></td>
          <td><code>gen_ai.request.model</code>, <code>gen_ai.response.model</code>, <code>llm.model_name</code>, <code>mcpd.model</code></td>
        </tr>
        <tr>
          <td><code>provider</code></td>
          <td><code>gen_ai.system</code>, <code>llm.provider</code>, <code>mcpd.provider</code></td>
        </tr>
        <tr>
          <td><code>input</code></td>
          <td><code>input.value</code>, <code>gen_ai.prompt</code>, <code>mcpd.input</code></td>
        </tr>
        <tr>
          <td><code>output</code></td>
          <td><code>output.value</code>, <code>gen_ai.completion</code>, <code>mcpd.output</code></td>
        </tr>
        <tr>
          <td><code>entity_name</code></td>
          <td><code>gen_ai.agent.name</code>, <code>mcpd.entity.name</code></td>
        </tr>
        <tr>
          <td><code>usage.input_tokens</code></td>
          <td><code>gen_ai.usage.input_tokens</code>, <code>gen_ai.usage.prompt_tokens</code>, <code>llm.token_count.prompt</code>, <code>mcpd.usage.input_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.output_tokens</code></td>
          <td><code>gen_ai.usage.output_tokens</code>, <code>gen_ai.usage.completion_tokens</code>, <code>llm.token_count.completion</code>, <code>mcpd.usage.output_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.total_tokens</code></td>
          <td><code>llm.token_count.total</code>, <code>gen_ai.usage.total_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_read</code></td>
          <td><code>gen_ai.usage.cache_read_input_tokens</code>, <code>llm.token_count.prompt_details.cache_read</code>, <code>mcpd.usage.cache_read_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_write</code></td>
          <td><code>gen_ai.usage.cache_creation_input_tokens</code>, <code>llm.token_count.prompt_details.cache_write</code>, <code>mcpd.usage.cache_write_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.audio</code></td>
          <td><code>llm.token_count.prompt_details.audio</code></td>
        </tr>
        <tr>
          <td><code>output_details.reasoning</code></td>
          <td><code>llm.token_count.completion_details.reasoning</code>, <code>gen_ai.usage.reasoning_tokens</code></td>
        </tr>
        <tr>
          <td><code>output_details.audio</code></td>
          <td><code>llm.token_count.completion_details.audio</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Um span sem nenhuma das três contagens de token não carrega objeto de uso
    nenhum, em vez de carregar um cheio de zeros. Zero tokens de entrada e
    tokens de entrada desconhecidos são fatos diferentes, e um relatório de
    custo construído sobre o primeiro quando queria dizer o segundo está errado
    de um jeito que ninguém percebe.
  </p>

  <h3>Correlação</h3>
