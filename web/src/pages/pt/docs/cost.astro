      <tr><td><code>o4-mini</code></td><td>1.10</td><td>4.40</td><td>0.275</td><td>como input</td><td>como input</td></tr>
      <tr><td><code>gemini-2.5-pro</code></td><td>1.25</td><td>10.00</td><td>0.31</td><td>como input</td><td>como input</td></tr>
      <tr><td><code>gemini-2.5-flash</code></td><td>0.30</td><td>2.50</td><td>0.075</td><td>como input</td><td>como input</td></tr>
      <tr><td><code>text-embedding-3-small</code></td><td>0.02</td><td>0.00</td><td>como input</td><td>como input</td><td>como input</td></tr>
      <tr><td><code>text-embedding-3-large</code></td><td>0.13</td><td>0.00</td><td>como input</td><td>como input</td><td>como input</td></tr>
