import Doc from '@/layouts/Doc.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import Waterfall from '@/components/Waterfall.astro'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* Os links internos continuam escritos como rotas em inglês e são localizados
   aqui. Uma rota cuja página em português ainda não existe leva para a página
   em inglês, em vez de para um URL em português sem nada atrás. */
const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

const scoped = `# Sync and async are the same object. Both end the span on the way out and
# record the exception if the block raised.
with mcpd.trace("nightly_summariser") as run:
    with mcpd.span("fetch", kind=SpanKind.TOOL_CALL) as step:
        step.set_output({"documents": 42})

async with mcpd.trace("agent") as run:
    async with mcpd.span("generate", kind=SpanKind.MODEL_GENERATION) as generation:
        generation.set_output(await model.complete(prompt))
    await mcpd.aflush()`

const nesting = `def draft(question: str) -> str:
    # Nothing was passed in. The span still lands under the run, because the
    # active span is a contextvars.ContextVar and this call is inside the block.
    with mcpd.span("draft", kind=SpanKind.MODEL_GENERATION) as generation:
        generation.set_input(question)
        return "..."


with mcpd.trace("support_agent") as run:
    run.set_output(draft("where is my order?"))`

const propagation = `# Outbound: hand the active span to the next service.
requests.post(url, headers={"traceparent": mcpd.traceparent()}, json=payload)

# Inbound: continue that trace rather than starting a new one.
with mcpd.trace("handler", traceparent=request.headers.get("traceparent")) as run:
    ...`

const payload = `generation.set_model("gpt-4o-mini", provider="openai")
generation.set_usage(input_tokens=812, output_tokens=96, cache_read=128)

# How the model was called. Settings, not payload: kept with capture off.
generation.set_model_parameters(temperature=0, seed=0, max_tokens=1024)

# A failure you caught and decided about yourself.
generation.set_error("the provider timed out", kind="TimeoutError", retryable=True)

# A point in time inside the span, with no duration of its own.
generation.event("first_token")`

const sinks = `from mcpd import Mcpd, RecordingSink

sink = RecordingSink()
mcpd = Mcpd(sink=sink)
with mcpd.trace("answer") as run:
    run.set_usage(input_tokens=12)
mcpd.flush()
assert sink.spans[0].usage.input_tokens == 12
print(mcpd.stats())  # queued, dropped, capacity, exported, failed, rejected`

const serverless = `def handler(event, context):
    with mcpd.trace("answer") as run:
        run.set_input(event["body"])
        answer = agent(event["body"])
        run.set_output(answer)

    # The batch is still in memory here. The runtime freezes this process the
    # moment the handler returns, and the worker thread never runs again.
    mcpd.flush()
    return {"statusCode": 200, "body": answer}`
---

<Doc
  title="Python"
  description="O SDK do mcpd para Python: context managers síncronos e assíncronos, propagação por contextvars, nenhuma dependência obrigatória e instrumentação que nunca levanta exceção."
  lede="Context managers para código síncrono e assíncrono, um span ativo guardado em contextvars, e nenhuma dependência obrigatória."
  og="docs"
>
  <h2>Instalação</h2>
  <p>
    Python 3.9 ou mais novo. Não há nenhuma dependência obrigatória, e isso é
    deliberado: o exportador roda sobre <code>urllib</code> e <code>gzip</code>
    da biblioteca padrão, então instalar o mcpd não acrescenta nada ao lockfile
    e não pode conflitar com aquilo de que o seu agente já depende.
  </p>

  <Command
    command="pip install mcpd"
    primaryLabel="Só a biblioteca padrão"
    secondary={[{ label: 'Com o extra httpx', command: 'pip install "mcpd[httpx]"' }]}
  />

  <p>
    O extra <code>httpx</code> acrescenta reúso de conexão e mais nada. O SDK se
    comporta de forma idêntica sem ele.
  </p>

  <h2>Construir o cliente</h2>
  <p>
    Um cliente por processo. Todo argumento também lê uma variável de ambiente,
    então o mesmo código roda em desenvolvimento e em produção sem nenhuma
    edição. <code>Mcpd()</code> sem argumento nenhum fala com um daemon em
    <code>http://localhost:4317</code>.
  </p>

  <CodeSwitcher class="not-prose my-6" only={['python']} region="init" title="conectar" />

  <p>O código vence o ambiente, e o ambiente vence o padrão.</p>

  <table>
    <thead>
      <tr><th>Argumento</th><th>Ambiente</th><th>Padrão</th></tr>
    </thead>
    <tbody>
      <tr><td><code>endpoint</code></td><td><code>MCPD_ENDPOINT</code></td><td><code>http://localhost:4317</code></td></tr>
      <tr><td><code>api_key</code></td><td><code>MCPD_API_KEY</code></td><td>nenhum</td></tr>
      <tr><td><code>project</code></td><td><code>MCPD_PROJECT</code></td><td><code>default</code></td></tr>
      <tr><td><code>environment</code></td><td><code>MCPD_ENVIRONMENT</code></td><td>nenhum</td></tr>
      <tr><td><code>service_name</code></td><td><code>MCPD_SERVICE_NAME</code></td><td>nenhum</td></tr>
      <tr><td><code>service_version</code></td><td><code>MCPD_SERVICE_VERSION</code></td><td>nenhum</td></tr>
      <tr><td><code>sample</code></td><td><code>MCPD_SAMPLE</code></td><td><code>1.0</code></td></tr>
      <tr><td><code>enabled</code></td><td><code>MCPD_ENABLED</code></td><td><code>true</code></td></tr>
      <tr><td><code>capture_payloads</code></td><td><code>MCPD_CAPTURE_PAYLOADS</code></td><td><code>true</code></td></tr>
      <tr><td><code>log_level</code></td><td><code>MCPD_LOG_LEVEL</code></td><td><code>debug</code></td></tr>
      <tr><td><code>batch_size</code></td><td><code>MCPD_BATCH_SIZE</code></td><td><code>128</code></td></tr>
      <tr><td><code>flush_interval</code></td><td><code>MCPD_FLUSH_INTERVAL_MS</code></td><td><code>2.0</code> segundos</td></tr>
      <tr><td><code>max_queue</code></td><td><code>MCPD_MAX_QUEUE</code></td><td><code>8192</code></td></tr>
      <tr><td><code>timeout</code></td><td><code>MCPD_TIMEOUT_MS</code></td><td><code>10.0</code> segundos</td></tr>
    </tbody>
  </table>

  <p>
    <code>enabled=False</code> transforma toda chamada de registro em uma
    operação vazia que ainda devolve objetos válidos, então você pode desligar o
    mcpd nos testes sem mudar o código que está sendo testado.
    <code>capture_payloads=False</code> mantém prompts e respostas dentro do
    processo: os spans continuam sendo registrados com o seu tempo, o seu
    status, o seu uso, o seu modelo, os parâmetros do modelo, a sua correlação
    e os seus erros, e
    <code>input</code> e <code>output</code> são descartados antes de chegar à
    fila. Um span pode dizer o contrário para si mesmo com
    <code>capture_payloads=True</code> nos seus campos de início, e no sentido
    inverso também.
  </p>

  <h2>Registrar uma execução</h2>
  <p>
    <code>mcpd.trace(name)</code> começa uma execução e
    <code>mcpd.span(name)</code> começa uma etapa abaixo do que estiver ativo no
    momento. Os dois são context managers: o bloco encerra o span na saída e
    registra a exceção, se o bloco levantou alguma, e depois deixa essa exceção
    passar sem alteração. O seu próprio tratamento de erros não muda por estar
    sendo observado.
  </p>

  <CodeSwitcher class="not-prose my-6" only={['python']} region="trace" title="registrar uma execução" />

  <p>
    Sem um bloco <code>with</code>, chame <code>run.end()</code> você mesmo. De
    um jeito ou de outro o span é exportado quando começa, então um span que
    nunca termina fica visível como um span que nunca terminou, que costuma ser
    exatamente o que você está procurando.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="síncrono e assíncrono"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: scoped }]}
  />

  <h2>Contexto</h2>
  <p>
    O span ativo é uma <code>contextvars.ContextVar</code>. Ele acompanha um
    <code>await</code> para dentro de uma task e não vaza entre threads, então
    uma função auxiliar três quadros abaixo abre um filho do pai certo sem que
    nenhum chamador precise passar um argumento por todo o caminho.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="aninhamento"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: nesting }]}
  />

  <p>O que sai disso é a árvore, com os tempos e os payloads anexados.</p>

  <Waterfall class="not-prose my-8" />

  <p>
    Entre serviços, o contexto viaja em um cabeçalho <code>traceparent</code> do
    W3C. Um cabeçalho malformado começa um trace novo em vez de falhar a
    requisição que o carregou. Uma decisão de não amostrar que chega de fora é
    obedecida, porque um trace que alguns serviços guardam e outros descartam
    não é um trace.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="através de uma fronteira de serviço"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: propagation }]}
  />

  <h2>Modelo, uso e erros</h2>
  <p>
    As contagens de tokens são o que o mcpd precifica na ingestão, então o custo
    no trace é o custo que foi cobrado de você. Informe o que o provedor relatou. <code>set_error</code> aceita uma string ou uma exceção, coloca o
    <code>status</code> em <code>error</code> no mesmo movimento, e sempre
    preenche uma mensagem: "alguma coisa falhou" não dá para agir em cima.
  </p>

  <p>
    <code>set_model_parameters</code> registra os ajustes com que a chamada foi
    feita: <code>temperature</code>, <code>top_p</code>, <code>top_k</code>,
    <code>max_tokens</code>, <code>seed</code>, <code>stop_sequences</code> e
    <code>has_response_format</code>. São ajustes, e não payload, então eles
    sobrevivem a <code>capture_payloads=False</code>, que é o caso que importa:
    são eles que alguém reproduzindo a execução precisa igualar. Um argumento
    que você omite fica ausente e um que você passa é mantido seja qual for o
    valor, então <code>seed=0</code> é uma seed. O schema por trás de
    <code>has_response_format</code> não é registrado, só se havia um em vigor.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="o que um span carrega"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: payload }]}
  />

  <p>
    Os outros setters são <code>set_input</code>, <code>set_output</code>,
    <code>set_metadata</code>, <code>set_attributes</code>,
    <code>set_tags</code>, <code>set_entity</code>, <code>set_cost</code>,
    <code>set_status</code> e <code>add_link</code>. Todos devolvem o span, e
    qualquer um deles também pode ser passado como palavra-chave quando o span
    começa. <code>external_parent_span_id=</code> nomeia um pai de um sistema de
    tracing que não é o mcpd, carregado para correlação e nunca usado para
    definir a árvore.
  </p>

  <h3>Chamadas em streaming</h3>
  <p>
    Passe o stream do provedor para <code>span.record_stream</code> e leia o
    wrapper no lugar dele: um gerador para um iterador, um gerador assíncrono
    para um iterador assíncrono. Ele aceita chunks de chat completion da OpenAI
    e eventos de mensagem da Anthropic, como dicts ou como os objetos do
    próprio SDK do provedor, e todo chunk passa sem alteração. O primeiro chunk
    com texto ou com uma chamada de ferramenta marca o tempo até o primeiro
    token. Quando o stream termina, levanta uma exceção ou é deixado com um
    <code>break</code>, o span recebe o que <code>record_response</code> teria
    registrado para a mesma chamada sem streaming, o texto como saída, e
    termina. Um erro do stream marca o span e chega até você sem alteração. O
    texto guardado tem um teto de 32.768 caracteres, e
    <code>mcpd.stream.truncated</code> é definido quando o teto foi atingido.
  </p>

  <CodeSwitcher class="not-prose my-6" only={['python']} region="stream" title="uma chamada em streaming" />

  <h2>Payloads, sinks e spans já concluídos</h2>
  <p>
    Um sink é para onde vai um lote drenado. O transporte HTTP é o padrão. Um
    <code>RecordingSink</code> guarda todo lote em memória, então um teste
    verifica o que a instrumentação registrou sem nenhum servidor; um
    <code>ConsoleSink</code> imprime uma linha JSON por sinal no stderr. Um sink
    que levanta exceção é um lote falho, contado e reportado, nunca uma exceção
    no seu código. <code>stats()</code> responde o que o cliente fez desde que
    foi construído.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="verificar o que foi registrado"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: sinks }]}
  />

  <p>
    <code>TestClient</code>, de <code>mcpd.testing</code>, é um
    <code>Mcpd</code> que grava em memória. Passe-o onde quer que o seu código
    receba um cliente e leia de volta o que ele gravou: <code>spans()</code>
    por nome ou tipo, <code>recorded_span(name)</code> para o span que tem de
    existir, <code>trees()</code> para cada execução como uma árvore,
    <code>logs()</code>, <code>metrics()</code>, <code>scores()</code>,
    <code>recorded_feedback()</code> e <code>reset()</code>. Cada acessor faz
    flush antes. O que ele guarda passou pela amostragem, pela captura de
    payload e pelo <code>redact</code> como passaria a caminho de um daemon, e
    ele continua ligado quando <code>MCPD_ENABLED=false</code> está definido
    para a rodada de testes. <code>recorded_span</code> levanta
    <code>AssertionError</code>, então um span que falta faz o teste falhar com
    os nomes que ele viu.
  </p>

  <CodeSwitcher class="not-prose my-6" only={['python']} region="testing" title="um teste de unidade" />

  <p>
    <code>mcpd.record(span)</code> enfileira um <code>SpanRecord</code> que já
    terminou, com os ids, o pai e os tempos como você os tem: o que um adaptador
    para outro sistema de tracing ou uma importação em lote já carrega. Ele
    nunca é reaninhado, nunca tem os tempos refeitos nem é reamostrado, e um
    registro malformado é descartado e contado em <code>stats().rejected</code>,
    nunca levantado como exceção.
  </p>

  <h2>Execuções duráveis</h2>
  <p>
    O mesmo cliente serve as execuções duráveis do daemon.
    <code>workflow()</code> constrói a definição e guarda os corpos das etapas,
    como chamadas ou como decoradores; um <code>Worker</code> a registra, faz
    long polling por leases em um pool de threads e serve cada um, e
    <code>mcpd.runs</code>, <code>mcpd.events</code> e
    <code>mcpd.definitions</code> espelham a superfície de execuções uma a uma.
    Um corpo levanta <code>StepFailure</code> com
    <code>class_="retryable"</code> para ser repetido dentro do orçamento da
    etapa, e registra spans abaixo da sua etapa através do
    <code>StepContext</code>. O que esses spans gastam é o uso da etapa: os
    tokens são somados conforme cada span termina e o último modelo visto vence,
    então o daemon precifica a etapa a partir do que o trace mostra;
    <code>ctx.set_usage</code> sobrescreve isso campo a campo. O
    <code>Worker</code> aceita quatro hooks além de <code>on_error</code>
    (<code>on_lease</code>, <code>on_step_start</code>,
    <code>on_step_end</code>, <code>on_conflict</code>), e
    <code>worker.stats()</code> conta leases tomados, corpos em andamento,
    concluídos, falhas por classe, conflitos por motivo e leases que não puderam
    ser servidos.
  </p>
  <CodeSwitcher class="not-prose my-6" only={['python']} example="workflow" region="workflow" title="um workflow" />
  <p>
    O que cada construção faz, o protocolo de lease e a API de execuções estão
    em <a href={linkTo('/docs/workflows')} class="link">Workflows</a>,
    <a href={linkTo('/docs/workers')} class="link">Workers</a> e
    <a href={linkTo('/docs/runs')} class="link">Execuções</a>.
  </p>

  <h2>Notas e feedback</h2>
  <p>
    <code>min</code> e <code>max</code> são só por palavra-chave e não têm
    padrão. Um número solto, sem escala declarada, não pode ser comparado com
    nada, então a escala é exigida no ponto da chamada em vez de ser adivinhada
    depois. O feedback é o julgamento de uma pessoa e fica separado de uma nota:
    os dois respondem perguntas diferentes e nunca devem entrar na mesma média.
  </p>

  <CodeSwitcher class="not-prose my-6" only={['python']} region="score" title="nota e feedback" />

  <p>
    Os dois se ligam ao trace do span ativo quando você não nomeia nenhum. Os
    logs e as métricas fazem o mesmo, então um pico em um gráfico abre a
    execução que o causou.
  </p>

  <h2>Flush e encerramento</h2>
  <p>
    Registrar acrescenta a uma fila em memória e retorna; uma thread daemon faz
    o HTTP. <code>flush()</code> envia o que está esperando e devolve
    <code>False</code> se não conseguiu fazer isso dentro do seu tempo limite.
    <code>shutdown()</code> faz o flush, para o worker e libera o transporte. Os
    dois são idempotentes. Dentro de um event loop chame <code>aflush()</code> e
    <code>ashutdown()</code>, que fazem o mesmo trabalho sem bloquear o loop.
  </p>
  <p>
    Em uma função serverless isso importa mais do que em qualquer outro lugar. O
    runtime congela o processo no instante em que o seu handler retorna, e a
    thread do worker nunca mais roda, então um lote que ainda estava na fila se
    perde.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="um handler serverless"
    samples={[{ lang: 'python', label: 'Python', shiki: 'python', code: serverless }]}
  />

  <p>
    O cliente também registra um hook <code>atexit</code>, então um script comum
    que esquece de encerrar ainda recebe o seu último lote. Esse hook não roda
    em um <code>os._exit()</code> nem em um sinal fatal, então ele é uma rede de
    segurança e não um substituto.
  </p>

  <h2>Com o que você pode contar</h2>
  <ul>
    <li>
      A instrumentação nunca levanta exceção. Toda chamada de registro é
      protegida; uma falha é logada no máximo uma vez por intervalo e engolida.
      A observabilidade nunca pode derrubar aquilo que ela observa. As chamadas
      de leitura são a exceção e levantam mesmo, porque uma consulta pela qual
      você está esperando é outra coisa.
    </li>
    <li>
      Registrar não bloqueia. A latência do seu agente nunca depende de o mcpd
      ser rápido, nem de estar no ar.
    </li>
    <li>
      A memória é limitada. São <code>max_queue</code> sinais, 8192 por padrão.
      Quando ela enche, os mais antigos são descartados,
      <code>mcpd.dropped</code> conta cada um e um aviso é logado por intervalo. Um
      buffer sem limite transforma uma queda de rede em uma morte por falta de
      memória.
    </li>
    <li>
      A decisão de amostragem é tomada uma vez, na raiz, a partir do id do
      trace, e herdada por todo filho. Um <code>traceparent</code> que chega de
      fora sempre vence.
    </li>
    <li>
      Um span é exportado quando começa e atualizado quando termina, então uma
      execução que quebra no meio do caminho continua visível.
    </li>
    <li>
      Os horários vêm de <code>time.time_ns()</code> e vão para a rede em UTC
      com nove dígitos. Horário local deixa um trace distribuído ilegível.
    </li>
  </ul>

  <h2>Ler de volta</h2>
  <p>
    Os métodos de leitura espelham a API HTTP e devolvem os tipos gerados. Eles
    são síncronos e levantam <code>McpdError</code> em caso de falha.
    <code>from_</code> e <code>to</code> aceitam um <code>datetime</code> ou uma
    forma abreviada como <code>-15m</code>, <code>-1h</code> ou
    <code>-7d</code>. Em código assíncrono, rode-os fora do loop com
    <code>asyncio.to_thread</code>.
  </p>

