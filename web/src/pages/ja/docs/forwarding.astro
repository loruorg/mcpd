---
import Doc from '@/layouts/Doc.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'
import { localeOf, urlFor } from '@/lib/i18n'

const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, code)

const destinations = `{
  "forward": [
    {
      "vendor": "langfuse",
      "region": "eu",
      "public_key": "\${LANGFUSE_PUBLIC_KEY}",
      "secret_key": "\${LANGFUSE_SECRET_KEY}",
      "filter": { "projects": ["checkout"], "sample": 0.25 },
      "redact": { "key_contains": ["email"] }
    },
    {
      "name": "honeycomb-prod",
      "vendor": "honeycomb",
      "api_key": "\${HONEYCOMB_API_KEY}",
      "dataset": "agents",
      "signals": { "traces": true, "logs": true, "metrics": false }
    },
    {
      "name": "collector",
      "endpoint": "https://otel.internal.example.com:4318",
      "protocol": "protobuf",
      "headers": { "Authorization": "Bearer \${COLLECTOR_TOKEN}" },
      "redact": { "drop_payloads": true }
    }
  ]
}`
---

<Doc
  title="転送"
  description="mcpd が保存したものを Langfuse、Datadog、Honeycomb など 18 の送信先へ同時に複製します。送信先ごとにフィルターとスプールを持ちます。"
  lede="mcpd は OTLP を両方向に話します。ここに届いたものが、ここに閉じ込められることはありません。"
  og="docs"
>
  <h2>ストアは 1 つ、コピーは必要なだけ</h2>
  <p>
    mcpd は OTLP を受け取り、OTLP を送ります。送信先は設定ファイルの 1 つの
    エントリーです。ベンダー名と資格情報を書き、必要ならフィルター、秘匿化の
    ルール、受け取るシグナルを足します。各ベンダーのエンドポイント、認証
    ヘッダー、読む属性名は mcpd が知っているので、あなたが書くのはキーだけで、
    連携の実装ではありません。
  </p>
  <p>
    これは、mcpd の採用が取り消せるということでもあります。これまで使っていた
    ものに向けて転送し、2 週間ほど両方を動かし、取り消せない移行に賭けるので
    はなく、目の前のデータを見て決めてください。
  </p>

  <h2>有効にする</h2>
  <p>
    OTLP の受信側が 1 つなら、フラグで足ります。<code>/v1/traces</code> では
    なくベースの URL を渡してください。各シグナルのパスは自動で付け足されます。
  </p>

  <Command
    class="not-prose my-6"
    title="ローカルに保存し、先へ複製する"
    command="mcpd serve --forward-endpoint https://otlp.example.com"
    primaryLabel="OTLP"
    secondary={[
      {
        label: 'ヘッダー付き',
        command: "mcpd serve --forward-endpoint https://otlp.example.com --forward-header 'Authorization: Bearer $TOKEN'",
      },
      {
        label: 'ベンダー',
        command: "mcpd serve --forward-vendor honeycomb --forward-header 'x-honeycomb-team: $HONEYCOMB_API_KEY'",
      },
      {
        label: 'Protobuf',
        command: 'mcpd serve --forward-endpoint https://otlp.example.com --forward-protocol protobuf',
      },
    ]}
  />

  <p>
    <code>--forward-vendor</code> はベンダーのエンドポイントと規約を選び、
    資格情報は <code>--forward-header</code> に書きます。既定のエンドポイントを
    持つベンダーなら、<code>--forward-endpoint</code> は省けます。
    <code>--forward-protocol</code> は <code>json</code>、
    <code>protobuf</code>、<code>grpc</code> のどれかを取ります。フラグで
    与えた送信先はファイルの <code>forward</code> ブロックを置き換えるので、
    共有の ConfigMap を編集せずに、1 つのインスタンスだけ別の宛先へ向けられます。
  </p>

  <h2>複数の送信先</h2>
  <p>
    設定ファイルの <code>forward</code> ブロックは、送信先 1 つをオブジェクトで
    受け取ります。これは以前のリリースが読んでいた形で、今も使えます。複数の
    送信先を配列で渡すこともできます。各送信先は自分のコピー、自分のスプール、
    自分の再試行を持つので、遅いベンダーが速いベンダーを引き止めることは
    ありません。
  </p>

  <pre><code class="language-json">{destinations}</code></pre>

  <p>
    どの文字列も <code>$&#123;ENV_NAME&#125;</code> と書けます。値は起動時に
    1 度だけ環境変数から読まれます。設定されていない変数があると起動は拒否
    され、その変数の名前が示されます。Secret から抜けた資格情報は、1 週間後に
    見つかる 401 ではなく、デプロイの時点で目に入るエラーになります。
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>フィールド</th><th>役割</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><code>name</code></td>
          <td>送信先の名前です。メトリクスの <code>destination</code> ラベルと、スプールのディレクトリー名に使われます。英字、数字、<code>-</code>、<code>_</code>、<code>.</code> が使えます。既定はベンダー名です</td>
        </tr>
        <tr>
          <td><code>vendor</code></td>
          <td>下に挙げるプリセットのどれかです。既定は <code>otlp</code></td>
        </tr>
        <tr>
          <td><code>endpoint</code></td>
          <td><code>/v1/traces</code> を付けないベース URL です。<code>otlp</code>、<code>otlp_grpc</code>、<code>elastic</code>、<code>dynatrace</code> では必須です。既定を持つベンダーでは、その既定を置き換えます</td>
        </tr>
        <tr>
          <td><code>protocol</code></td>
          <td><code>json</code>、<code>protobuf</code>、<code>grpc</code> のどれかです。既定は <code>otlp</code> が JSON、<code>otlp_grpc</code> が gRPC、それ以外のベンダーは protobuf です。Dynatrace は JSON を拒否します</td>
        </tr>
        <tr>
          <td><code>headers</code></td>
          <td><code>[name, value]</code> の組のリスト、またはオブジェクトです。プリセットが設定するヘッダーと同じ名前のヘッダーは、それを置き換えます</td>
        </tr>
        <tr>
          <td><code>enabled</code></td>
          <td><code>false</code> にすると、エントリーをファイルに残したまま何も送りません</td>
        </tr>
        <tr>
          <td><code>batch_size</code></td>
          <td>1 リクエストあたりのスパン数です。既定は 256</td>
        </tr>
        <tr>
          <td><code>conventions</code></td>
          <td>コピーを書くときの属性名です。<code>gen_ai</code>、<code>gen_ai_messages</code>、<code>openinference</code>、<code>langfuse</code>、<code>langsmith</code>、<code>braintrust</code>、<code>laminar</code> のどれかです。既定はベンダー自身のものです</td>
        </tr>
        <tr>
          <td><code>region</code></td>
          <td>ベンダーのリージョン別エンドポイントを選びます。一覧は下の表にあります</td>
        </tr>
        <tr>
          <td><code>api_key</code>、<code>token</code>、<code>public_key</code>、<code>secret_key</code>、<code>instance_id</code>、<code>space_id</code></td>
          <td>資格情報です。各ベンダーは表に書かれたものを読み、自分のヘッダーに変えます</td>
        </tr>
        <tr>
          <td><code>project</code>、<code>workspace</code>、<code>dataset</code>、<code>dsn</code></td>
          <td>ベンダーの中で、コピーが届く場所です</td>
        </tr>
        <tr>
          <td><code>filter</code></td>
          <td>この送信先が受け取るデータです。下を参照してください</td>
        </tr>
        <tr>
          <td><code>redact</code></td>
          <td>この送信先のコピーから外すものです。下を参照してください</td>
        </tr>
        <tr>
          <td><code>signals</code></td>
          <td><code>traces</code>、<code>logs</code>、<code>metrics</code> を、それぞれ true か false で指定します。既定は、そのベンダーが受け付けるすべてのシグナルです</td>
        </tr>
        <tr>
          <td><code>spool_max_bytes</code></td>
          <td>この送信先のスプールが持てる最大量です。既定は <code>--spool-max-bytes</code></td>
        </tr>
      </tbody>
    </table>
  </div>

