---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* Internal links stay written as English routes and are localised here. A
   route whose Japanese page is not written yet resolves to the English page
   rather than to a Japanese URL with nothing behind it. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

/* Japanese prose is written one paragraph to a line on purpose. A newline
   between two Japanese characters is only removed by the segment-break rule in
   browsers that implement it; the rest render it as a space, and a stray space
   inside a Japanese sentence is visible. */
const description =
  'AI エージェントのための無料・オープンソースのデーモン。ステップ間はワークフローを保持し、' +
  '各ステップの中身は任意の言語のあなたのコードが担当します。' +
  '各ステップをコスト付きのトレースとして記録します。'
---

<Base
  title="エージェントのための永続実行と可観測性を、1 つのバイナリで"
  description={description}
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">エージェントが踏むすべてのステップを、最後まで保持し、記録に残す。</h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">mcpd はデーモンであって、フレームワークではありません。ステップ間の実行を保持するのは mcpd です。リトライも、タイマーも、承認を待つ 1 週間もそこに含まれます。ステップの中身は、あなた自身のコードがどの言語でも担当します。すべてのステップは、かかったコストとともにトレースに残ります。</p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">モデルのレイテンシ</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">見本のトレース</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="ビルドして実行"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">あとは <span class="data text-ink">localhost:4317</span> を開くだけです。アカウントも、立ち上げるデータベースも、署名するものもありません。リリースはまだありません。イメージとパッケージは最初のリリースと同時に公開します。<a href={url('/docs/quickstart')} class="link ml-1">5 分のクイックスタートを読む</a>。</p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">読み解ける実行。</h2>
        <p class="prose mt-5 text-[0.9375rem]">エージェントが失敗する場所は、エラーが書かれたログ行ではありません。失敗はその 3 ステップ前、モデルが誤ったツールを選び、もう一度同じツールを選んだところにあります。</p>
        <p class="prose mt-4 text-[0.9375rem]">mcpd は実行全体をツリーとして復元します。モデル呼び出し、ツール呼び出し、検索の一つひとつに、そのときのプロンプトと補完、それぞれのレイテンシ、そしてそれぞれのコストが付きます。</p>
        <p class="mt-6">
          <a href={url('/app')} class="link">インターフェースを開く</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">起動したプロセスより長く生きる実行。</h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">ステップ間の実行はデーモンが持ちます。ステップの中身はすべてあなたのプロセスが持ち、何も渡しません。モデルも、プロンプトも、資格情報もです。</p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">グラフはデータ、本体はあなたのもの</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">ワークフローはコードで一度だけ書きます。グラフは定義としてデーモンに渡り、そこで検証されてバージョンが付きます。ステップの本体は 6 言語のいずれかであなたのプロセスに残り、ワーカーがそれを実行します。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">リトライ、タイマー、待機は、すべてストアの行</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">一時的な失敗は、そのステップ自身の予算でリトライします。スリープや承認待ちの間はプロセスが 1 つも生きていなくても実行が保たれ、デプロイも、クラッシュも、1 週間も越えられます。イベントは名前とキーで待機に応え、同じイベントが再び届いても重複であって、2 回目の実行にはなりません。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">すべての実行がトレース</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">各ステップは、入力、出力、報告された使用量を持つスパンです。価格は、ほかのスパンに付けるのと同じ料金表で付きます。ステップ内部のモデル呼び出しはその下にぶら下がるので、検索もコストもスコアラーも、実行をそのまま扱えます。</p>
      </div>
    </div>
    <p class="mt-8">
      <a href={url('/docs/workflows')} class="link">ワークフローについて読む</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">すでに使っている言語で計装。</h2>
        <p class="prose mt-5 text-[0.9375rem]">6 つの SDK、振る舞いは 1 つです。スパンの記録がブロックすることも、例外を投げることも、際限なく増えることもありません。mcpd に届かなくても、あなたのエージェントは気づきません。可観測性の失敗の仕方として、許されるのはそれだけです。どの SDK もワーカーを備えているので、永続実行のステップは、それを記録するのと同じプロセスから提供されます。</p>
        <p class="prose mt-4 text-[0.9375rem]">どれも必須ではありません。<span class="data text-ink">OTEL_EXPORTER_OTLP_ENDPOINT</span> を mcpd に向ければ、すでに動かしている OpenTelemetry SDK がそのまま届きます。あなたのアプリケーションに私たちのコードは 1 行も入りません。6 つの SDK は HTTP の面の上に置いた便利な層であって、記録される条件ではありません。</p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">フレームワークに付属してくる可観測性が記録できるのは、そのフレームワークで作ったエージェントだけです。mcpd は OTLP エンドポイントに届いたものを何でも受け取ります。エージェントフレームワークでも、自分で書いたループでも、そのどちらかが呼び出すサービスでもかまいません。</p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={url('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={url('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={url('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={url('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={url('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={url('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="実行を計装する" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">6 つのシグナル、結び付けるのはそれを生んだ実行。</h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">多くのツールはトレースをここに、ログを別のどこかに置き、タイムスタンプの突き合わせは目視に任せます。mcpd は 6 つのシグナルすべてを同じ trace id と span id に対して保存します。だからグラフ上のスパイクからは、それを起こした実行が開き、実行からは、そこで出力されたログ行が見えます。</p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. Japanese opens on the digit, so the English speller
        is not used. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">振る舞いが一致する {CHANNELS.length} 言語。</h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">どの SDK も単体でテストしていますが、それで分かるのは作者が意図したとおりに動くことだけで、互いに一致するかどうかは何も分かりません。そこで、各 SDK が 1 つのデーモンに対して同じ実行を書き込み、そのトレースを読み戻して互いに比較します。</p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">ある言語で成り立ち、別の言語で成り立たない振る舞いは、そこでしか表に出ません。変更のたびに CI で実行します。<a href={url('/docs/from-mastra')} class="link ml-1">他の選択肢との比較</a>。</p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">誰が何を読んだか、断られた人も含めて。</h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">セキュリティレビューを決めるのは、そのデータが安全かどうかという問いではありません。あとから、誰がそこに届いたかを示せるかどうかです。</p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">6 つのキースコープ</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">テレメトリーを送ること、プロンプトを読むこと、保存済みのデータを変えること、それを破棄すること、実行を開始すること、ステップを取得することは、別々の権限です。write を設定しなければ ingest キーを受け付け、admin を設定しなければ read キーを受け付けます。execute と worker を設定しなければ write キーを受け付けます。アップグレードで締め出されることはありません。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">プロジェクトが境界</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">キーも保持期間もサンプリングも、すべてプロジェクト単位です。あるプロジェクトに登録されたキーが届くのはそのプロジェクトだけで、デーモンはデータの持ち主を確かめてから、その中の 1 件を返します。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">外部への自動通信はなし</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">デーモン全体で外向きのリクエストを出す箇所は 4 つだけで、そのすべてをあなたが設定します。フォワーダー、2 つの webhook、そしてジャッジです。更新チェックも、テレメトリーも、ライセンスサーバーもありません。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">どのキーで、どの人物か</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">監査台帳にはキーが残ります。前段のイングレスがすでに付けているヘッダーと、それを付けてよいアドレスを mcpd に伝えれば、人物も残ります。それ以外の場所から送られたヘッダーは誰でも名乗れる主張にすぎないので、その欄は推測を書かずに空のままにします。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">削除の依頼は 1 回の呼び出し</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">1 回の DELETE で、ある人物に対して記録された実行がすべて消え、そこにぶら下がるスパン、ログ、メトリクス、スコア、フィードバックも一緒に消えます。応答はシグナルごとの件数です。そのキーで開けないプロジェクトの行は、触られることも、数に入ることもありません。</p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">信頼する前に点検</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2"><span class="data text-ink">mcpd doctor</span> は動いている構成を採点します。ストレージが書き込みを受け取って返せるか、開いたままのスコープがないか、設定済みのプロジェクトがスパンを一度でも受け取ったか。対処が必要な項目には、それを直すフラグの名前が付きます。</p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">最初のトレースまで 5 分。</h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">デーモンを起動し、エージェントをそこへ向け、インターフェースを開きます。それより時間がかかるなら不具合です。報告をお待ちしています。</p>
        </div>
        <Command
          variant="floor"
          label="起動"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: 'ソースから', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
