---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const title = 'フレームワークを問わないエージェント観測所'
const description =
  'AI エージェント向けの無料・オープンソース可観測性。フレームワーク、言語、' +
  'モデルを問わず、OpenTelemetry か 6 つの SDK で使えます。' +
  'バイナリ 1 つでセルフホストするか、mcpd.sh で無料で使えます。'

const copy: HomeCopy = {
  h1: 'フレームワークを問わないエージェント観測所。',
  lede:
    'リリースしたすべてのエージェントの、すべての実行が見えます。モデル呼び出し、' +
    'ツール呼び出し、検索の一つひとつを、プロンプト、回答、コストとともに確認できます。' +
    'フレームワークも言語もモデルプロバイダーも問いません。新たに採用するものはありません。',
  startFree: '無料で始める',
  selfHost: 'セルフホスト',
  heroNote:
    'ホスト版はすべての機能を無料で使えます。オープンソースのバイナリ 1 つを自分のマシンで動かすこともできます。',

  worksTitle: 'いま使っているものとそのまま連携。',
  worksBody:
    'mcpd は OpenTelemetry を受信し、モデル呼び出しについて OpenTelemetry と ' +
    'OpenInference の両方の規約を読み取ります。そのため、あなたのスタック向けに' +
    'すでにある計装がそのまま使えます。エージェントのフレームワークも、あなたのコードも' +
    '変わりません。',
  otelLabel: '任意の OpenTelemetry エクスポーターを mcpd に向ける',
  sdkLead: 'または SDK を追加:',
  frameworksLegend: 'エージェントフレームワーク',
  providersLegend: 'モデルプロバイダー',
  ownLoop: '独自のループ',

  seeTitle: 'すべてのステップを、根拠とともに。',
  seeBody:
    '実行は、モデル呼び出し、ツール呼び出し、検索からなるツリーです。どのステップを' +
    '開いても、正確なプロンプトと回答、使ったトークン、かかったコストを読めます。' +
    '検索では、モデルが言った内容から実行を探せます。どのログ行も、それを書いた' +
    'ステップにリンクしています。',
  seeFacts: [
    'すべての実行のウォーターフォールを 1 つの時間軸で',
    'ツール呼び出しを含む会話の全体',
    '実行、モデル、プロジェクトごとのコスト',
    'trace id で結び付いたログ、メトリクス、トレース',
  ],
  openInterface: 'インターフェースを開く',

  flowTitle: 'クラッシュしても止まらないワークフロー。',
  flowBody:
    'ステップは、6 つの言語のいずれかを使い、あなた自身のコードで書きます。' +
    'ステップ間の実行は mcpd が保持します。リトライも、タイマーも、1 週間かかる' +
    'かもしれないイベント待ちもです。ステップの途中でワーカーが落ちても、' +
    '別のワーカーがそのステップを引き継ぎます。',
  flowNotes: [
    ['すべてのステップをあなたのコードが実行', 'デーモンがモデル、プロンプト、資格情報を見ることはありません。ワーカーは一度に 1 つのステップを引き受けます。'],
    ['待機中はプロセス不要', 'スリープや承認待ちの間は、プロセスが 1 つも生きていなくても実行が保たれます。デプロイをまたいでも、1 週間たっても同じです。'],
    ['すべての実行がトレース', '各ステップは入力、出力、コストを持つスパンです。そのため、検索もスコアリングも実行にそのまま使えます。'],
  ],
  flowLink: 'ワークフローについて読む',

  evalTitle: '品質の低下をすぐに検知。',
  evalBody:
    '13 個の組み込みスコアラー、またはモデルを審査役にして、すべての実行を採点します。' +
    '本番の実行をデータセットにして、実験を比較できます。モニターがエラー率、' +
    'レイテンシ、コスト、スコアを見張り、どれかが動いたら Webhook を呼び出します。',
  evalLink: '評価',
  alertLink: 'モニターとアラート',

  deployTitle: 'どこでも動作。',
  deployBody:
    'ストレージとインターフェースを内蔵したバイナリ 1 つです。ノート PC では SQLite、' +
    'チームでは Postgres か ClickHouse、本番では Docker か Kubernetes を使えます。' +
    'テレメトリーもライセンスサーバーもありません。',
  deployLink: 'デプロイガイド',
  targets: [
    ['ホスト版', 'mcpd.sh で、すべての機能を無料で使えます。登録して、最初のトレースを送ってください。'],
    ['ノート PC', 'プロセス 1 つと SQLite ファイル 1 つで動きます。ほかにインストールするものはありません。'],
    ['Docker', 'コンテナ、ボリューム、ポートが 1 つずつで動きます。'],
    ['Kubernetes', 'Helm チャートを使い、背後に Postgres か ClickHouse を置き、プロジェクトごとにキーを分けます。'],
  ],
  ownLabel: '自分で動かす',
  fromSource: 'ソースから',

  closeTitle: '5 分で最初のトレース。',
  closeBody: '無料で登録するか、自分のマシンで動かしてください。どちらでも同じ製品です。',
}
---

<Base title={title} description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
