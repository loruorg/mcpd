---
import Doc from '@/layouts/Doc.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import { GUIDES, GUIDES_UPDATED, guidePath, guidesIndexSchema } from '@/lib/guides'

const title = 'Guides'
const description =
  'Step-by-step guides for mcpd: trace OpenAI, LangChain, the Vercel AI SDK and Pydantic AI, track cost per user, send alerts, and gate CI on evals.'
---

<Doc
  title={title}
  headTitle="Guides: tracing, cost, alerts and evals"
  description={description}
  lede="Each guide does one job from start to finish, with code you can run against a local daemon. Start with the guide for the framework your agent uses, then pick the job you need next."
  updated={GUIDES_UPDATED}
  stamp
  schema={guidesIndexSchema(title, description)}
>
  <LiveTrace class="not-prose my-8" />

  <ul class="guide-index not-prose">
    {
      GUIDES.map((g) => (
        <li>
          <a href={guidePath(g.slug)}>
            <span class="guide-title">{g.title}</span>
            <span class="guide-blurb">{g.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p>
    For the concepts behind them, read the <a href="/docs/concepts" class="link">Concepts</a> page. Every
    endpoint the guides call is in the <a href="/docs/reference/api" class="link">HTTP API reference</a>.
  </p>
</Doc>

<style>
  .guide-index {
    max-width: 68ch;
    border-top: 1px solid var(--color-scribe-2);
  }
  .guide-index li {
    border-bottom: 1px solid var(--color-scribe-2);
  }
  .guide-index a {
    display: block;
    padding: 0.85rem 0;
  }
  .guide-title {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 130ms ease;
  }
  .guide-index a:hover .guide-title {
    color: var(--color-accent);
  }
  .guide-blurb {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
</style>
