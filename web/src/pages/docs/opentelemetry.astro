---
import Doc from '@/layouts/Doc.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'

const exporterEnv = `# The base URL. Your exporter appends /v1/traces itself.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# http/protobuf, http/json and grpc all work on this one port.
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional. Send gzip if your payloads are large.
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Only when mcpd runs with --ingest-key.
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer YOUR_INGEST_KEY"`

const rawPost = `curl -X POST http://localhost:4317/v1/traces \\
  -H 'content-type: application/json' \\
  -d '{
  "resourceSpans": [{
    "resource": { "attributes": [
      { "key": "service.name", "value": { "stringValue": "checkout-agent" } }
    ]},
    "scopeSpans": [{
      "spans": [{
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "name": "chat gpt-4o",
        "startTimeUnixNano": "1700000000000000000",
        "endTimeUnixNano": "1700000001500000000",
        "status": { "code": 1 },
        "attributes": [
          { "key": "gen_ai.system", "value": { "stringValue": "openai" } },
          { "key": "gen_ai.request.model", "value": { "stringValue": "gpt-4o" } },
          { "key": "gen_ai.operation.name", "value": { "stringValue": "chat" } },
          { "key": "gen_ai.usage.input_tokens", "value": { "intValue": "1200" } },
          { "key": "gen_ai.usage.output_tokens", "value": { "intValue": "350" } }
        ]
      }]
    }]
  }]
}'

# {"partialSuccess":{"rejectedSpans":0,"errorMessage":""}}`

const grpcEnv = `# gRPC on the same port. No path: the exporter names the service itself.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# Only when mcpd runs with --ingest-key. gRPC metadata keys are lowercase.
export OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer YOUR_INGEST_KEY"`

const collectorYaml = `# An OpenTelemetry Collector that forwards everything to mcpd over gRPC.
receivers:
  otlp:
    protocols: { grpc: {}, http: {} }

exporters:
  otlp:
    endpoint: mcpd.internal:4317
    compression: gzip
    tls:
      insecure: true # mcpd serves cleartext; terminate TLS in front of it
    headers:
      authorization: Bearer \${env:MCPD_INGEST_KEY}

service:
  pipelines:
    traces: { receivers: [otlp], exporters: [otlp] }
    logs: { receivers: [otlp], exporters: [otlp] }
    metrics: { receivers: [otlp], exporters: [otlp] }`

const zipkinEnv = `# An OpenTelemetry SDK, exporting in Zipkin's format.
export OTEL_TRACES_EXPORTER=zipkin
export OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:4317/api/v2/spans

# A Zipkin reporter takes the same URL as its endpoint, for example
#   URLConnectionSender.create("http://localhost:4317/api/v2/spans")`

const zipkinPost = `curl -X POST http://localhost:4317/api/v2/spans \\
  -H 'content-type: application/json' \\
  -d '[{
  "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
  "id": "00f067aa0ba902b7",
  "kind": "CLIENT",
  "name": "chat gpt-4o",
  "timestamp": 1700000000000000,
  "duration": 1500000,
  "localEndpoint": { "serviceName": "checkout-agent" },
  "tags": { "gen_ai.system": "openai", "gen_ai.request.model": "gpt-4o" }
}]'

# HTTP 202 {"accepted":1,"rejected":0,"duplicate":0}`

const jaegerEnv = `# A Jaeger client library, sending Thrift over HTTP.
export JAEGER_ENDPOINT=http://localhost:4317/api/traces

# Anything that speaks Jaeger's gRPC collector API, such as jaeger-agent.
jaeger-agent --reporter.grpc.host-port=localhost:4317`
---

<Doc
  title="OpenTelemetry"
  description="mcpd accepts OTLP over HTTP and gRPC, Zipkin v2 and Jaeger on one port, and reads both the OpenTelemetry gen_ai.* and the OpenInference llm.* semantic conventions. No mcpd-specific code required."
  lede="If your agent already emits OpenTelemetry, Zipkin or Jaeger, mcpd is an endpoint change. This page is the whole path: the endpoints, the encodings, and every attribute mcpd reads."
  og="docs"
>
  <h2>The endpoints</h2>
  <p>
    mcpd serves OTLP over HTTP and over gRPC, Zipkin and Jaeger on the same port
    as its query API and its interface. There is no collector to run in front
    of it, no second container, and no separate receiver port. The port takes
    HTTP/1.1 and cleartext HTTP/2 side by side, and a gRPC call is an HTTP/2
    request, so one address serves every protocol below.
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Endpoint</th>
          <th>Accepts</th>
          <th>Answers with</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>POST /v1/traces</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partialSuccess.rejectedSpans</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/logs</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedLogRecords</code></td>
        </tr>
        <tr>
          <td><code>POST /v1/metrics</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partialSuccess.rejectedDataPoints</code></td>
        </tr>
        <tr>
          <td>gRPC <code>TraceService/Export</code></td>
          <td><code>ExportTraceServiceRequest</code></td>
          <td><code>partial_success.rejected_spans</code></td>
        </tr>
        <tr>
          <td>gRPC <code>LogsService/Export</code></td>
          <td><code>ExportLogsServiceRequest</code></td>
          <td><code>partial_success.rejected_log_records</code></td>
        </tr>
        <tr>
          <td>gRPC <code>MetricsService/Export</code></td>
          <td><code>ExportMetricsServiceRequest</code></td>
          <td><code>partial_success.rejected_data_points</code></td>
        </tr>
        <tr>
          <td><code>POST /api/v2/spans</code></td>
          <td>Zipkin v2 spans, JSON or proto3</td>
          <td><code>202</code> with <code>accepted</code> and <code>rejected</code></td>
        </tr>
        <tr>
          <td><code>POST /api/traces</code></td>
          <td>a Jaeger batch in Thrift binary</td>
          <td><code>202</code> with <code>accepted</code> and <code>rejected</code></td>
        </tr>
        <tr>
          <td>gRPC <code>jaeger.api_v2.CollectorService/PostSpans</code></td>
          <td><code>PostSpansRequest</code></td>
          <td><code>PostSpansResponse</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Every successful OTLP export answers with OTLP's own
    <code>partialSuccess</code> shape. When something was refused it carries the
    count and the reason. That is how a collector tells a sender it dropped
    something, and exporters read it. The answer comes in the encoding the
    export arrived in: protobuf for protobuf, JSON for JSON.
  </p>

  <h2>Point an exporter at it</h2>
  <p>
    Two variables do the work. Set them in the environment of the process that
    runs your agent, and nothing else changes.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="exporter"
    samples={[{ lang: 'curl', label: 'Environment', shiki: 'bash', code: exporterEnv }]}
  />

  <p>
    Two details are worth knowing before you debug a silence. First,
    <code>OTEL_EXPORTER_OTLP_ENDPOINT</code> is a base URL and the exporter
    appends the signal path to it. Set
    <code>OTEL_EXPORTER_OTLP_TRACES_ENDPOINT</code> instead if you want to give
    the full URL, path included. Second, port 4317 is conventionally the gRPC
    port in OpenTelemetry and 4318 the HTTP one. mcpd serves both on 4317,
    because it serves everything on one port. An exporter set to
    <code>grpc</code> finds it on its default port; an HTTP exporter left on
    its default sends to 4318, so name the port.
  </p>

  <h2>OTLP over gRPC</h2>
  <p>
    The three OTLP collector services are served on the same port:
    <code>opentelemetry.proto.collector.trace.v1.TraceService</code>,
    <code>logs.v1.LogsService</code> and <code>metrics.v1.MetricsService</code>.
    Set the exporter's protocol to <code>grpc</code> and keep the endpoint:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="grpc exporter"
    samples={[{ lang: 'curl', label: 'Environment', shiki: 'bash', code: grpcEnv }]}
  />

  <p>
    A gRPC call takes exactly the road of the matching HTTP door: the same key
    check, the same project for an account's key, the same ceilings, sampling,
    redaction and costing, and the same recognition of a resent export. The key
    goes in the call's metadata as <code>authorization: Bearer</code>, or as
    <code>x-mcpd-key</code>. A refused call ends with the gRPC status an
    exporter acts on: <code>UNAUTHENTICATED</code> for a missing or unknown key,
    <code>PERMISSION_DENIED</code> for a key without the ingest scope,
    <code>INVALID_ARGUMENT</code> for a message that will not decode,
    <code>RESOURCE_EXHAUSTED</code> past a limit, and
    <code>UNAVAILABLE</code> when the store cannot take the write, which
    exporters retry. A method mcpd does not serve answers
    <code>UNIMPLEMENTED</code>.
  </p>
  <p>
    Messages may be gzip-compressed (<code>grpc-encoding: gzip</code>). The
    listener speaks cleartext HTTP/2. To serve gRPC over TLS, terminate TLS in a
    proxy and forward HTTP/2 to mcpd; the proxy must keep HTTP/2 on the hop to
    the daemon, because gRPC does not run over HTTP/1.1.
  </p>
  <p>
    An OpenTelemetry Collector forwards to mcpd with its OTLP exporter:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="collector"
    samples={[{ lang: 'curl', label: 'YAML', shiki: 'yaml', code: collectorYaml }]}
  />

  <h2>Both encodings, for every signal</h2>
  <p>
    <code>/v1/traces</code>, <code>/v1/logs</code> and <code>/v1/metrics</code>
    read the <code>content-type</code> header and accept either encoding:
    OTLP/protobuf when it contains <code>protobuf</code>, OTLP/JSON otherwise.
    Protobuf is the OpenTelemetry default, so an unmodified SDK pointed at mcpd
    sends all three signals and they land with no configuration at all. The
    same export stores the same records in either encoding, down to the ids a
    resend is recognised by.
  </p>
  <p>
    When no <code>content-type</code> is sent at all, mcpd assumes
    <code>application/json</code>.
  </p>

  <h2>Compression and size</h2>
  <p>
    A request body may arrive with <code>content-encoding: gzip</code>, with
    <code>identity</code>, or with no encoding header. Anything else is refused
    by name: <code>content-encoding "br" is not supported; use gzip or send the
    body uncompressed</code>. Responses are compressed by content negotiation,
    so a large trace read back over a slow link is compressed too.
  </p>
  <p>
    Two limits apply to one request. The body limit is 32 MiB and is measured
    on what arrives, so gzip buys you room. The batch limit is 10,000 signals,
    counted after decoding on every ingest door: spans on
    <code>/v1/traces</code>, <code>/api/v2/spans</code>,
    <code>/api/traces</code> and their gRPC services, records on
    <code>/v1/logs</code>, data points on <code>/v1/metrics</code> and
    everything in the request on <code>/v1/ingest</code>. A gzip body or
    message is held to the body limit after it is inflated as well. A larger
    batch is refused with
    <code>413 payload_too_large</code> naming both numbers. Both limits are
    settings: <code>--max-body-bytes</code> and
    <code>--max-batch-signals</code>, described on
    <a href="/docs/configuration" class="link">Configuration</a>.
  </p>

  <h2>Zipkin</h2>
  <p>
    <code>POST /api/v2/spans</code> is Zipkin's v2 span endpoint. It takes a
    JSON array of spans, or a proto3 <code>ListOfSpans</code> when the
    <code>content-type</code> contains <code>protobuf</code>, gzip-encoded or
    not, and answers <code>202</code>. Point a Zipkin reporter or an
    OpenTelemetry SDK's Zipkin exporter at it:
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="zipkin exporter"
    samples={[{ lang: 'curl', label: 'Environment', shiki: 'bash', code: zipkinEnv }]}
  />

  <CodeSwitcher
    class="not-prose my-6"
    title="raw Zipkin JSON"
    samples={[{ lang: 'curl', label: 'Shell', shiki: 'bash', code: zipkinPost }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Zipkin field</th>
          <th>Becomes</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>localEndpoint.serviceName</code></td><td>the service, resource <code>service.name</code></td></tr>
        <tr><td><code>tags</code></td><td>span attributes, so <code>gen_ai.*</code> and <code>llm.*</code> tags are read as on OTLP</td></tr>
        <tr><td><code>kind</code></td><td>the <code>span.kind</code> attribute, lowercase</td></tr>
        <tr><td><code>annotations</code></td><td>span events, each named by its value</td></tr>
        <tr><td><code>remoteEndpoint</code></td><td><code>peer.service</code>, <code>network.peer.address</code>, <code>network.peer.port</code></td></tr>
        <tr><td><code>error</code> tag, or <code>otel.status_code</code></td><td>the status, with the tag's value as the message</td></tr>
        <tr><td><code>timestamp</code>, <code>duration</code></td><td>start and end; a span with no duration has not finished</td></tr>
        <tr><td><code>debug</code></td><td>the sampled bit, so the sampler keeps the trace</td></tr>
        <tr><td><code>parentId</code></td><td>the parent</td></tr>
        <tr><td><code>shared</code></td><td>a server half, kept beside its client half</td></tr>
      </tbody>
    </table>
  </div>

  <p>
    A 64-bit trace id is padded to 128 bits with leading zeros, which is the id
    OpenTelemetry gives the same trace. A shared server span reuses its
    client's span id; mcpd keys a span on its id, so the server half is stored
    under an id derived from the shared one and parented to it, and both halves
    are kept. A resent span lands on the same row.
  </p>

  <h2>Jaeger</h2>
  <p>
    Two Jaeger collector doors are served: <code>POST /api/traces</code>,
    which takes one <code>jaeger.Batch</code> in Thrift's binary protocol
    (<code>application/x-thrift</code>) and answers <code>202</code>, and the
    gRPC service <code>jaeger.api_v2.CollectorService/PostSpans</code>. Both map
    a span the same way.
  </p>

  <CodeSwitcher
    class="not-prose my-6"
    title="jaeger"
    samples={[{ lang: 'curl', label: 'Environment', shiki: 'bash', code: jaegerEnv }]}
  />

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>Jaeger field</th>
          <th>Becomes</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>process <code>serviceName</code></td><td>the service, resource <code>service.name</code></td></tr>
        <tr><td>process tags</td><td>resource attributes</td></tr>
        <tr><td>span tags</td><td>span attributes, typed as Jaeger typed them</td></tr>
        <tr><td>logs</td><td>span events, named by the <code>event</code> field</td></tr>
        <tr><td><code>parentSpanId</code>, or the first <code>CHILD_OF</code> in the same trace</td><td>the parent</td></tr>
        <tr><td>every other reference</td><td>a span link, of kind <code>child_of</code> or <code>follows_from</code></td></tr>
        <tr><td><code>error</code> tag, or <code>otel.status_code</code></td><td>the status</td></tr>
        <tr><td>sampled or debug flag</td><td>the sampled bit</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Span links</h2>
  <p>
    A link says that a span is related to another span, in this trace or in
    another one, without being its child. mcpd keeps links from every door: the
    <code>links</code> of an OTLP span in either encoding and over either
    transport, the <code>links</code> of a native span, and the references of a
    Jaeger span that are not its parent. A link's kind comes from its
    <code>mcpd.link.kind</code> attribute, or from
    <code>opentracing.ref_type</code>, which is what a Jaeger reference
    becomes. Every link is stored with the span and returned with the trace.
  </p>

  <h2>What happens between arriving and being stored</h2>
  <p>
    An OTLP span, a Zipkin or Jaeger span and a native span take the same path.
    That is the point of the pipeline being shared: the order below cannot
    drift between the doors.
  </p>

  <PipelineDiagram class="not-prose my-8" />

  <p>
    Costing at ingest is why an OTLP span gets a cost figure at all. mcpd prices
    it from the price book this server is running with, at the moment it
    arrives, so changing your rates later cannot silently rewrite what last
    month cost. See <a href="/docs/cost" class="link">Cost accounting</a>.
  </p>

  <h2>Both semantic conventions</h2>
  <p>
    Two competing sets of attribute names are in use for AI spans:
    OpenTelemetry's own <code>gen_ai.*</code> and OpenInference's
    <code>llm.*</code> with <code>openinference.span.kind</code>. mcpd reads
    both, and its own <code>mcpd.*</code> names on top. You do not rename
    anything.
  </p>
  <p>
    Each row below is read in order, first match wins. An attribute that no row
    names is still kept: the whole flattened attribute map is stored on the
    span, so nothing you send is lost by not being mapped.
  </p>

  <h3>Model, payload and usage</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>mcpd field</th>
          <th>Read from, in order</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>model</code></td>
          <td><code>gen_ai.request.model</code>, <code>gen_ai.response.model</code>, <code>llm.model_name</code>, <code>mcpd.model</code></td>
        </tr>
        <tr>
          <td><code>provider</code></td>
          <td><code>gen_ai.system</code>, <code>llm.provider</code>, <code>mcpd.provider</code></td>
        </tr>
        <tr>
          <td><code>input</code></td>
          <td><code>input.value</code>, <code>gen_ai.prompt</code>, <code>mcpd.input</code></td>
        </tr>
        <tr>
          <td><code>output</code></td>
          <td><code>output.value</code>, <code>gen_ai.completion</code>, <code>mcpd.output</code></td>
        </tr>
        <tr>
          <td><code>entity_name</code></td>
          <td><code>gen_ai.agent.name</code>, <code>mcpd.entity.name</code></td>
        </tr>
        <tr>
          <td><code>usage.input_tokens</code></td>
          <td><code>gen_ai.usage.input_tokens</code>, <code>gen_ai.usage.prompt_tokens</code>, <code>llm.token_count.prompt</code>, <code>mcpd.usage.input_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.output_tokens</code></td>
          <td><code>gen_ai.usage.output_tokens</code>, <code>gen_ai.usage.completion_tokens</code>, <code>llm.token_count.completion</code>, <code>mcpd.usage.output_tokens</code></td>
        </tr>
        <tr>
          <td><code>usage.total_tokens</code></td>
          <td><code>llm.token_count.total</code>, <code>gen_ai.usage.total_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_read</code></td>
          <td><code>gen_ai.usage.cache_read_input_tokens</code>, <code>llm.token_count.prompt_details.cache_read</code>, <code>mcpd.usage.cache_read_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.cache_write</code></td>
          <td><code>gen_ai.usage.cache_creation_input_tokens</code>, <code>llm.token_count.prompt_details.cache_write</code>, <code>mcpd.usage.cache_write_tokens</code></td>
        </tr>
        <tr>
          <td><code>input_details.audio</code></td>
          <td><code>llm.token_count.prompt_details.audio</code></td>
        </tr>
        <tr>
          <td><code>output_details.reasoning</code></td>
          <td><code>llm.token_count.completion_details.reasoning</code>, <code>gen_ai.usage.reasoning_tokens</code></td>
        </tr>
        <tr>
          <td><code>output_details.audio</code></td>
          <td><code>llm.token_count.completion_details.audio</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    A span with none of the three token counts carries no usage object at all,
    rather than one full of zeroes. Zero input tokens and unknown input tokens
    are different facts, and a cost report built on the first when it meant the
    second is wrong in a way nobody notices.
  </p>

  <h3>Correlation</h3>
  <p>
    Correlation fields are what let you ask for one user's runs, or one
    session's. Span attributes are read first, then resource attributes.
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>mcpd field</th>
          <th>Read from, in order</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>project</code></td>
          <td><code>mcpd.project</code> on the span, then on the resource, then the daemon's <code>--project</code></td>
        </tr>
        <tr>
          <td><code>environment</code></td>
          <td><code>mcpd.environment</code>, resource <code>deployment.environment.name</code>, resource <code>deployment.environment</code></td>
        </tr>
        <tr>
          <td><code>service_name</code></td>
          <td>resource <code>service.name</code></td>
        </tr>
        <tr>
          <td><code>service_version</code></td>
          <td>resource <code>service.version</code></td>
        </tr>
        <tr>
          <td><code>session_id</code></td>
          <td><code>gen_ai.conversation.id</code>, <code>session.id</code>, <code>mcpd.session_id</code></td>
        </tr>
        <tr>
          <td><code>thread_id</code></td>
          <td><code>mcpd.thread_id</code>, <code>thread.id</code></td>
        </tr>
        <tr>
          <td><code>user_id</code></td>
          <td><code>user.id</code>, <code>enduser.id</code>, <code>mcpd.user_id</code></td>
        </tr>
        <tr>
          <td><code>request_id</code></td>
          <td><code>mcpd.request_id</code>, <code>http.request.id</code></td>
        </tr>
        <tr>
          <td><code>release</code></td>
          <td><code>mcpd.release</code>, resource <code>service.version</code></td>
        </tr>
        <tr>
          <td><code>run_id</code>, <code>resource_id</code>, <code>experiment_id</code></td>
          <td><code>mcpd.run_id</code>, <code>mcpd.resource_id</code>, <code>mcpd.experiment_id</code></td>
        </tr>
        <tr>
          <td><code>tags</code></td>
          <td><code>mcpd.tags</code>, as an array of strings</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3>Status and errors</h3>
  <p>
    OTLP status code <code>1</code> becomes <code>ok</code> and <code>2</code>
    becomes <code>error</code>. An unset status with an end time is recorded as
    <code>ok</code>, because a span that finished without complaint did.
    An unset status with no end time stays <code>unset</code>: the span is still
    running, and mcpd stores it that way rather than inventing an outcome.
  </p>
  <p>
    On an error span, the message comes from <code>status.message</code>, then
    <code>exception.message</code>, and failing both the literal string
    <code>unspecified error</code>. The error kind comes from
    <code>exception.type</code> and the stack from
    <code>exception.stacktrace</code>. An error span always carries a message,
    because "something failed" with no text is not something you can act on.
  </p>

  <h3>Span kind</h3>
  <p>
    The kind drives how a span is drawn in the waterfall. mcpd infers it in
    order of specificity, and falls back to <code>generic</code>, which is
    always safe. Mislabelling a span is worse than declining to label it.
  </p>
  <ol>
    <li><code>mcpd.span.kind</code>, when it names a kind mcpd knows.</li>
    <li><code>openinference.span.kind</code>.</li>
    <li><code>gen_ai.operation.name</code>.</li>
    <li>The presence of an attribute that only one kind of span carries.</li>
  </ol>

  <div class="scroll-x">
    <table>
