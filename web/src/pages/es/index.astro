---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { localeOf, urlFor } from '@/lib/i18n'

const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, code)

/* El titular cuenta los canales del banco de pruebas, nunca un número escrito
   a mano. `spell` de `@/lib/conformance` deletrea en inglés, así que la misma
   cuenta se deletrea aquí en español y la frase sigue sin abrir con una cifra. */
const PALABRAS = [
  'ningún', 'Un', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis', 'Siete', 'Ocho',
  'Nueve', 'Diez', 'Once', 'Doce',
]
const deletrear = (n: number): string => PALABRAS[n] ?? String(n)

const descripcion =
  'Un daemon gratuito y de código abierto para agentes de IA. Conserva un workflow entre ' +
  'pasos mientras tu código hace el trabajo dentro de cada uno, y registra cada paso ' +
  'como una traza con su costo.'
---

<Base title="Ejecuciones duraderas y observabilidad para agentes, en un solo binario" description={descripcion} kind="software" og="default" flushFooter>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">
          Cada paso que da tu agente, sostenido hasta el final y registrado.
        </h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">
          mcpd es un daemon, no un framework. Sostiene una ejecución entre
          pasos: los reintentos, los temporizadores, la espera de una semana
          hasta una aprobación, mientras tu propio código hace el trabajo dentro
          de cada paso, en cualquier lenguaje. Cada paso queda en una traza con
          lo que costó.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">Latencia del modelo</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">traza de muestra</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="Compílalo y ejecútalo"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">
          Luego abre <span class="data text-ink">localhost:4317</span>. Sin cuenta, sin
          base de datos que levantar, nada que firmar. Todavía no hay versión publicada:
          la imagen y los paquetes llegan con la primera.
          <a href={linkTo('/docs/quickstart')} class="link ml-1">Lee el inicio rápido de cinco minutos</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Una ejecución que puedes leer.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Un agente que falla no falla en la línea de log que menciona el error.
          Falla tres pasos antes, cuando el modelo eligió la herramienta
          equivocada y volvió a elegirla.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          mcpd reconstruye la ejecución entera como un árbol: cada llamada al
          modelo, cada llamada a una herramienta, cada recuperación, con el
          prompt y la completion exactos adjuntos a cada una, la latencia de
          cada una y lo que costó cada una.
        </p>
        <p class="mt-6">
          <a href={linkTo('/app')} class="link">Abre la interfaz</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Una ejecución que sobrevive al proceso que la inició.
      </h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">
        El daemon es dueño de la ejecución entre pasos. Tu proceso es dueño de
        todo lo que ocurre dentro de uno, y no entrega nada: ni el modelo, ni el
        prompt, ni una credencial.
      </p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">El grafo son datos, los cuerpos son tuyos</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un workflow se escribe una vez, en código. El grafo llega al daemon
          como una definición que él valida y versiona. Los cuerpos de los pasos
          se quedan en tu proceso, en cualquiera de los seis lenguajes, para que
          un worker los sirva.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Reintentos, temporizadores y esperas son filas</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un fallo transitorio se reintenta con el presupuesto del propio paso.
          Una pausa o una espera de aprobación sostiene la ejecución sin ningún
          proceso vivo, a través de un despliegue, de una caída o de una semana.
          Un evento responde a la espera por nombre y clave, y un evento
          repetido es un duplicado, no una segunda ejecución.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Cada ejecución es una traza</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Cada paso es un span con su entrada, su salida y el uso que declaró,
          valorado con el mismo libro de precios que cualquier otro span. La
          llamada al modelo dentro de un paso cuelga de él, así que la búsqueda,
          el costo y los evaluadores funcionan igual sobre una ejecución.
        </p>
      </div>
    </div>
    <p class="mt-8">
      <a href={linkTo('/docs/workflows')} class="link">Lee sobre los workflows</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
          Instrumenta en el lenguaje que ya escribes.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Seis SDK, un mismo comportamiento. Registrar un span nunca bloquea,
          nunca lanza una excepción y nunca crece sin límite: si mcpd está
          inalcanzable, tu agente no se entera, que es la única forma aceptable
          de que falle la observabilidad. Cada uno lleva además un worker, así
          que los pasos de una ejecución duradera se sirven desde el mismo
          proceso que los registra.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          Ninguno es obligatorio. Apunta <span class="data text-ink"
            >OTEL_EXPORTER_OTLP_ENDPOINT</span
          > a mcpd y el SDK de OpenTelemetry que ya ejecutas llegará hasta él, sin
          código nuestro en tu aplicación. Los seis son una comodidad sobre una superficie
          HTTP, no una condición para quedar registrado.
        </p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">
          La observabilidad que viene pegada a un framework solo puede registrar
          agentes construidos con ese framework. mcpd acepta lo que llegue a su
          endpoint OTLP: un framework de agentes, un bucle que escribiste tú, o
          los servicios que llame cualquiera de los dos.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={linkTo('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={linkTo('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={linkTo('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={linkTo('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={linkTo('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={linkTo('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="instrumentar una ejecución" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Seis señales, correlacionadas por la ejecución que las produjo.
    </h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">
      La mayoría de las herramientas te dan las trazas en un sitio y los logs en
      otro, y te dejan cuadrar a ojo las marcas de tiempo. mcpd guarda las seis
      señales contra los mismos ids de traza y de span, así que un pico en un
      gráfico abre la ejecución que lo causó y una ejecución muestra las líneas
      de log que emitió.
    </p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      {deletrear(CHANNELS.length)} lenguajes que coinciden.
    </h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Cada SDK se prueba por su cuenta, lo que demuestra que cada uno hace lo
        que quisieron sus autores y nada sobre si coinciden entre sí. Por eso
        cada uno escribe la misma ejecución contra un mismo daemon, y las trazas
        se leen de vuelta y se comparan unas con otras.
      </p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Un comportamiento que se cumple en un lenguaje y no en otro aparece ahí
        y en ningún otro sitio. Se ejecuta en CI con cada cambio.
        <a href={linkTo('/docs/from-mastra')} class="link ml-1">Cómo se compara</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Quién leyó qué, incluido quién quedó fuera.
      </h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">
        La pregunta que decide una revisión de seguridad no es si los datos
        están a salvo. Es si puedes demostrar, después, quién llegó a ellos.
      </p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Seis ámbitos de clave</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Emitir telemetría, leer prompts, cambiar datos guardados, destruirlos,
          arrancar ejecuciones y reclamar pasos son privilegios distintos. Una
          lista write sin definir acepta las claves de ingesta, y una lista admin
          sin definir acepta las claves de lectura. Las listas execute y worker
          sin definir aceptan las claves de escritura. Actualizar no te deja
          fuera.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Un proyecto es una frontera</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Las claves, la retención y el muestreo son por proyecto. Una clave
          listada bajo uno llega a ese, y el daemon resuelve de quién es un
          dataset antes de devolver un solo caso de él.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Nada llama a casa</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          En todo el daemon hay cuatro puntos que hacen solicitudes salientes, y
          tú configuras cada uno: el reenviador, dos webhooks y el juez. No hay
          comprobación de actualizaciones, ni telemetría, ni servidor de
          licencias.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Qué clave, y qué persona</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          El registro nombra la clave. Dale a mcpd la cabecera que tu ingress ya
          establece, y las direcciones autorizadas a establecerla, y nombrará
          también a la persona. Enviada desde cualquier otro sitio, una cabecera
          es una afirmación que podría hacer cualquiera, así que la fila queda
          vacía en vez de llevar una suposición.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Una solicitud de borrado es una llamada</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un DELETE elimina todas las ejecuciones registradas a nombre de una
          persona, con los spans, logs, métricas, puntuaciones y feedback que
          cuelgan de ellas, y responde con un recuento por señal. Las filas de un
          proyecto que esa clave no puede abrir ni se tocan ni se cuentan.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Compruébalo antes de confiar en él</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          <span class="data text-ink">mcpd doctor</span> califica un despliegue:
          si el almacenamiento acepta una escritura y la devuelve, si quedó un
          ámbito abierto, si un proyecto configurado ha recibido alguna vez un
          span. Todo lo que te pide corregir nombra el flag que lo arregla.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">
            Cinco minutos hasta tu primera traza.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
            Ejecuta el daemon, apunta tu agente hacia él, abre la interfaz. Si
            tarda más que eso, es un error y queremos el informe.
          </p>
        </div>
        <Command
          variant="floor"
          label="Empezar"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: 'Desde el código', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
