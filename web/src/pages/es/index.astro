---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const descripcion =
  'Observabilidad gratis y de código abierto para agentes de IA. Cualquier framework, ' +
  'lenguaje o proveedor de modelos, con OpenTelemetry o seis SDK. Aloja un solo binario ' +
  'o úsalo gratis en mcpd.sh.'

const copy: HomeCopy = {
  h1: 'El observatorio de agentes sin imposiciones.',
  lede:
    'Ve cada ejecución de cada agente que lanzas: cada llamada al modelo, cada llamada a ' +
    'una herramienta y cada recuperación, con su prompt, su respuesta y su costo. Cualquier ' +
    'framework, cualquier lenguaje, cualquier proveedor de modelos. Nada que adoptar.',
  startFree: 'Empieza gratis',
  selfHost: 'Alójalo tú',
  heroNote: 'Alojado gratis con todas las funciones, o un binario de código abierto en tu propia máquina.',

  worksTitle: 'Funciona con lo que ya usas.',
  worksBody:
    'mcpd recibe OpenTelemetry y lee las convenciones de OpenTelemetry y de OpenInference ' +
    'para las llamadas a modelos, así que la instrumentación que ya existe para tu stack ' +
    'funciona tal cual. Tu agente conserva su framework y tú conservas tu código.',
  otelLabel: 'Apunta cualquier exportador de OpenTelemetry a mcpd',
  sdkLead: 'O añade un SDK:',
  frameworksLegend: 'Frameworks de agentes',
  providersLegend: 'Proveedores de modelos',
  ownLoop: 'Tu propio bucle',

  seeTitle: 'Cada paso, con las pruebas.',
  seeBody:
    'Una ejecución es un árbol de llamadas a modelos, llamadas a herramientas y ' +
    'recuperaciones. Abre cualquier paso para leer el prompt y la respuesta exactos, los ' +
    'tokens que usó y lo que costó. La búsqueda encuentra una ejecución por lo que dijo el ' +
    'modelo, y cada línea de log enlaza con el paso que la escribió.',
  seeFacts: [
    'Una cascada de cada ejecución, en un solo reloj',
    'La conversación completa, con las llamadas a herramientas',
    'Costo por ejecución, por modelo y por proyecto',
    'Logs, métricas y trazas unidos por el id de traza',
  ],
  openInterface: 'Abre la interfaz',

  flowTitle: 'Workflows que sobreviven a un fallo.',
  flowBody:
    'Escribe los pasos en tu propio código, en cualquiera de los seis lenguajes. mcpd ' +
    'sostiene la ejecución entre ellos: reintentos, temporizadores y esperas de un evento ' +
    'que puede tardar una semana. Si un worker muere a mitad de un paso, otro lo retoma.',
  flowNotes: [
    ['Tu código ejecuta cada paso', 'El daemon nunca ve un modelo, un prompt ni una credencial. Los workers reclaman un paso cada vez.'],
    ['Esperar no retiene ningún proceso', 'Una pausa o una espera de aprobación sostiene la ejecución sin ningún proceso vivo, durante un despliegue o una semana.'],
    ['Cada ejecución es una traza', 'Cada paso es un span con su entrada, su salida y su costo, así que la búsqueda y la evaluación también funcionan sobre las ejecuciones.'],
  ],
  flowLink: 'Lee sobre workflows',

  evalTitle: 'Entérate cuando baja la calidad.',
  evalBody:
    'Evalúa cada ejecución con trece evaluadores integrados o con un modelo como juez. ' +
    'Convierte ejecuciones de producción en datasets y compara experimentos. Los monitores ' +
    'vigilan la tasa de errores, la latencia, el costo y las puntuaciones, y llaman a tu ' +
    'webhook cuando alguno se mueve.',
  evalLink: 'Evaluación',
  alertLink: 'Monitores y alertas',

  deployTitle: 'Ejecútalo donde quieras.',
  deployBody:
    'Un solo binario con el almacenamiento y la interfaz integrados. SQLite en un portátil, ' +
    'Postgres o ClickHouse para un equipo, Docker o Kubernetes en producción. Sin telemetría ' +
    'y sin servidor de licencias.',
  deployLink: 'Guía de despliegue',
  targets: [
    ['Alojado', 'Gratis en mcpd.sh con todas las funciones. Regístrate y envía tu primera traza.'],
    ['Tu portátil', 'Un proceso y un archivo SQLite. Nada más que instalar.'],
    ['Docker', 'Un contenedor, un volumen, un puerto.'],
    ['Kubernetes', 'Un chart de Helm, con Postgres o ClickHouse detrás y claves por proyecto.'],
  ],
  ownLabel: 'Ejecuta el tuyo',
  fromSource: 'Desde el código',

  closeTitle: 'Tu primera traza en cinco minutos.',
  closeBody: 'Regístrate gratis o ejecútalo en tu propia máquina. El mismo producto en ambos casos.',
}
---

<Base title="El observatorio de agentes sin imposiciones" description={descripcion} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
