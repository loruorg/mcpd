import Doc from '@/layouts/Doc.astro'
import Command from '@/components/Command.astro'
import PipelineDiagram from '@/components/PipelineDiagram.astro'
import { localeOf, urlFor } from '@/lib/i18n'

const locale = localeOf(Astro.url.pathname)

const destinations = `{
  "forward": [
    {
      "vendor": "langfuse",
      "region": "eu",
      "public_key": "\${LANGFUSE_PUBLIC_KEY}",
      "secret_key": "\${LANGFUSE_SECRET_KEY}",
      "filter": { "projects": ["checkout"], "sample": 0.25 },
      "redact": { "key_contains": ["email"] }
    },
    {
      "name": "honeycomb-prod",
      "vendor": "honeycomb",
      "api_key": "\${HONEYCOMB_API_KEY}",
      "dataset": "agents",
      "signals": { "traces": true, "logs": true, "metrics": false }
    },
    {
      "name": "collector",
      "endpoint": "https://otel.internal.example.com:4318",
      "protocol": "protobuf",
      "headers": { "Authorization": "Bearer \${COLLECTOR_TOKEN}" },
      "redact": { "drop_payloads": true }
    }
  ]
}`
---

<Doc
  title="Reenvío"
  description="Copia lo que mcpd almacena a Langfuse, Datadog, Honeycomb y quince destinos más a la vez, cada uno con su filtro, su redacción y su spool duradero."
  lede="mcpd habla OTLP en los dos sentidos. Nada de lo que llega se queda atascado aquí."
  og="docs"
>
  <h2>Un almacén, tantas copias como necesites</h2>
  <p>
    mcpd recibe OTLP y emite OTLP. Un destino es una entrada del archivo de
    configuración: un nombre de proveedor, una credencial y, si quieres, un
    filtro, una regla de ocultación y las señales que recibe. mcpd conoce el
    endpoint, la cabecera de autenticación y los nombres de atributo que lee
    cada proveedor, así que tú escribes la clave y no la integración.
  </p>
  <p>
    También significa que adoptar mcpd es reversible. Apúntalo a lo que estabas
    usando antes, ejecuta los dos durante quince días y decide con los datos
    delante en lugar de con una migración que no puedes deshacer.
  </p>

  <h2>Cómo activarlo</h2>
  <p>
    Para un solo receptor OTLP bastan los flags. Da la URL base y no
    <code>/v1/traces</code>: se añade la ruta de cada señal.
  </p>

  <Command
    class="not-prose my-6"
    title="almacena en local y copia hacia adelante"
    command="mcpd serve --forward-endpoint https://otlp.example.com"
    primaryLabel="OTLP"
    secondary={[
      {
        label: 'Con una cabecera',
        command: "mcpd serve --forward-endpoint https://otlp.example.com --forward-header 'Authorization: Bearer $TOKEN'",
      },
      {
        label: 'Un proveedor',
        command: "mcpd serve --forward-vendor honeycomb --forward-header 'x-honeycomb-team: $HONEYCOMB_API_KEY'",
      },
      {
        label: 'Protobuf',
        command: 'mcpd serve --forward-endpoint https://otlp.example.com --forward-protocol protobuf',
      },
    ]}
  />

  <p>
    <code>--forward-vendor</code> elige el endpoint y las convenciones de un
    proveedor; la credencial va en <code>--forward-header</code>. Con un
    proveedor que tiene endpoint por defecto, se puede omitir
    <code>--forward-endpoint</code>. <code>--forward-protocol</code> acepta
    <code>json</code>, <code>protobuf</code> o <code>grpc</code>. Un destino
    dado por flags sustituye al bloque <code>forward</code> del archivo, así que
    se puede apuntar una instancia a otro sitio sin editar un ConfigMap
    compartido.
  </p>

  <h2>Varios destinos</h2>
  <p>
    El bloque <code>forward</code> del archivo de configuración acepta un
    destino como objeto, la forma que leían las versiones anteriores y que
    sigue funcionando, o una lista de ellos. Cada destino recibe su propia
    copia, su propio spool y sus propios reintentos, así que un proveedor lento
    nunca frena a uno rápido.
  </p>

  <pre><code class="language-json">{destinations}</code></pre>

  <p>
    Cualquier cadena se puede escribir como <code>$&#123;ENV_NAME&#125;</code>.
    Se lee del entorno una vez, al arrancar. Una variable sin definir impide el
    arranque y se nombra en el error, así que una credencial que falta en un
    secreto es un error que ves al desplegar y no un 401 que descubres una
    semana después.
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Campo</th><th>Qué hace</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><code>name</code></td>
          <td>El nombre del destino, que se usa como etiqueta <code>destination</code> en sus métricas y como su directorio de spool. Letras, dígitos, <code>-</code>, <code>_</code> y <code>.</code>. Por defecto, el nombre del proveedor</td>
        </tr>
        <tr>
          <td><code>vendor</code></td>
          <td>Uno de los ajustes predefinidos de abajo. Por defecto, <code>otlp</code></td>
