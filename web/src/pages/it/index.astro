---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'

const description =
  'Osservabilità gratuita e open source per agenti IA. Qualsiasi framework, linguaggio o ' +
  'fornitore di modelli, con OpenTelemetry o sei SDK. Ospita un solo binario, o usalo ' +
  'gratis su mcpd.sh.'

const copy: HomeCopy = {
  h1: 'L’osservatorio di agenti senza vincoli.',
  lede:
    'Guarda ogni esecuzione di ogni agente che rilasci: ogni chiamata al modello, ogni ' +
    'chiamata a uno strumento e ogni recupero, con il suo prompt, la sua risposta e il suo ' +
    'costo. Qualsiasi framework, qualsiasi linguaggio, qualsiasi fornitore di modelli. ' +
    'Niente da adottare.',
  startFree: 'Inizia gratis',
  selfHost: 'Ospitalo tu',
  heroNote: 'Ospitato gratis con tutte le funzioni, o un binario open source sulla tua macchina.',

  worksTitle: 'Funziona con quello che usi già.',
  worksBody:
    'mcpd riceve OpenTelemetry e legge sia le convenzioni OpenTelemetry sia quelle ' +
    'OpenInference per le chiamate ai modelli, quindi la strumentazione che esiste già per ' +
    'il tuo stack funziona così com’è. Il tuo agente tiene il suo framework, e tu tieni il ' +
    'tuo codice.',
  otelLabel: 'Punta qualsiasi exporter OpenTelemetry verso mcpd',
  sdkLead: 'Oppure aggiungi un SDK:',
  frameworksLegend: 'Framework per agenti',
  providersLegend: 'Fornitori di modelli',
  ownLoop: 'Il tuo ciclo',

  seeTitle: 'Ogni passo, con le prove.',
  seeBody:
    'Un’esecuzione è un albero di chiamate ai modelli, chiamate agli strumenti e recuperi. ' +
    'Apri un passo qualsiasi per leggere il prompt e la risposta esatti, i token usati e ' +
    'quanto è costato. La ricerca trova un’esecuzione da ciò che ha detto il modello, e ' +
    'ogni riga di log rimanda al passo che l’ha scritta.',
  seeFacts: [
    'Una cascata di ogni esecuzione, su un solo orologio',
    'La conversazione completa, chiamate agli strumenti incluse',
    'Costo per esecuzione, per modello e per progetto',
    'Log, metriche e tracce uniti dal trace id',
  ],
  openInterface: 'Apri l’interfaccia',

  flowTitle: 'Workflow che sopravvivono a un crash.',
  flowBody:
    'Scrivi i passi nel tuo codice, in uno dei sei linguaggi. mcpd conserva l’esecuzione ' +
    'tra un passo e l’altro: nuovi tentativi, timer e attese di un evento che può durare ' +
    'una settimana. Se un worker muore a metà di un passo, un altro lo riprende.',
  flowNotes: [
    ['Il tuo codice esegue ogni passo', 'Il daemon non vede mai un modello, un prompt o una credenziale. I worker prendono un passo alla volta.'],
    ['Le attese non tengono processi', 'Una pausa o un’attesa di approvazione trattiene l’esecuzione senza nessun processo attivo, durante un deploy o per una settimana.'],
    ['Ogni esecuzione è una traccia', 'Ogni passo è uno span con input, output e costo, quindi ricerca e valutazione funzionano anche sulle esecuzioni.'],
  ],
  flowLink: 'Leggi la pagina sui workflow',

  evalTitle: 'Accorgiti quando la qualità cala.',
  evalBody:
    'Valuta ogni esecuzione con tredici valutatori integrati o con un modello come giudice. ' +
    'Trasforma le esecuzioni di produzione in dataset e confronta gli esperimenti. I monitor ' +
    'controllano tasso di errore, latenza, costo e punteggi, e chiamano il tuo webhook ' +
    'quando uno di questi si muove.',
  evalLink: 'Valutazione',
  alertLink: 'Monitor e avvisi',

  deployTitle: 'Eseguilo ovunque.',
  deployBody:
    'Un solo binario con lo storage e l’interfaccia integrati. SQLite su un portatile, ' +
    'Postgres o ClickHouse per un team, Docker o Kubernetes in produzione. Nessuna ' +
    'telemetria e nessun server di licenze.',
  deployLink: 'Guida al deploy',
  targets: [
    ['Ospitato', 'Gratis su mcpd.sh con tutte le funzioni. Registrati e invia la tua prima traccia.'],
    ['Il tuo portatile', 'Un processo e un file SQLite. Nient’altro da installare.'],
    ['Docker', 'Un container, un volume, una porta.'],
    ['Kubernetes', 'Un chart Helm, con Postgres o ClickHouse dietro e chiavi per progetto.'],
  ],
  ownLabel: 'Gestiscilo tu',
  fromSource: 'Dal codice',

  closeTitle: 'La tua prima traccia in cinque minuti.',
  closeBody: 'Registrati gratis, o eseguilo sulla tua macchina. Lo stesso prodotto in entrambi i casi.',
}
---

<Base title="L’osservatorio di agenti senza vincoli" description={description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
