---
import Base from '@/layouts/Base.astro'
import StripChart from '@/components/StripChart.astro'
import Waterfall from '@/components/Waterfall.astro'
import RunDrum from '@/components/RunDrum.astro'
import LeaseBoard from '@/components/LeaseBoard.astro'
import CodeSwitcher from '@/components/CodeSwitcher.astro'
import Command from '@/components/Command.astro'
import SortingBench from '@/components/SortingBench.astro'
import Conformance from '@/components/Conformance.astro'
import AuditLedger from '@/components/AuditLedger.astro'
import { CHANNELS } from '@/lib/conformance'
import { DEFAULT_LOCALE, localeOf, localesWithPage, urlFor } from '@/lib/i18n'

/* I link interni restano scritti come route inglesi e vengono localizzati qui.
   Una route la cui pagina italiana non è ancora scritta porta alla pagina
   inglese, invece che a un URL italiano senza niente dietro. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

/* Il titolo legge il conteggio dal banco di prova, quindi il numero va scritto
   in lettere in italiano: `spell` scrive parole inglesi. */
const PAROLE = [
  'Nessun', 'Un', 'Due', 'Tre', 'Quattro', 'Cinque', 'Sei', 'Sette', 'Otto',
  'Nove', 'Dieci', 'Undici', 'Dodici',
]
const inLettere = (n: number): string => PAROLE[n] ?? String(n)

const descrizione =
  'Un daemon gratuito e open source per agenti IA. Conserva un workflow tra un passo e ' +
  'l’altro mentre il tuo codice lavora dentro ciascuno, e registra ogni passo come una ' +
  'traccia con il suo costo.'
---

<Base
  title="Esecuzioni durevoli e osservabilità per agenti, in un solo binario"
  description={descrizione}
  kind="software"
  og="default"
  flushFooter
>
  {/* ------------------------------------------------------------ channel 01
      The fold. A full-width recessed instrument with the claim on the panel
      above it and the one action beneath. Not a hero stack; not a text column
      beside a product card.

      `min-h-svh` so the first screen is always this composition and never a
      band of the next section peeking in underneath it. `svh` rather than `vh`
      because mobile browsers shrink the visual viewport when the toolbar
      retracts, and `vh` would leave a gap at exactly the moment someone starts
      to scroll. */}
  <section class="flex min-h-[calc(100svh-3.9rem)] flex-col justify-center gap-8 py-10">
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-end justify-between gap-6 max-lg:block">
        <h1 class="display max-w-[17ch] text-[clamp(2.4rem,5.6vw,4.5rem)]">
          Ogni passo del tuo agente, tenuto fino alla fine e messo agli atti.
        </h1>
        {/* One paragraph. It shipped as two, differing by a breakpoint and by
            four words, and the clause that answers the reader's actual
            objection had already gone missing from the mobile copy. The measure
            changes at the breakpoint; the sentence does not. */}
        <p class="mt-4 max-w-[46ch] pb-2 text-[0.9375rem] leading-relaxed text-ink-2 lg:mt-0 lg:max-w-[30ch]">
          mcpd è un daemon, non un framework. Conserva un’esecuzione tra un passo
          e l’altro: i nuovi tentativi, i timer, l’attesa di una settimana per
          un’approvazione, mentre il tuo codice fa il lavoro dentro ogni passo,
          in qualsiasi linguaggio. Ogni passo finisce in una traccia, con quello
          che è costato.
        </p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex items-baseline justify-between pb-2">
        <span class="legend">Latenza del modello</span>
        <span class="data hidden text-[0.75rem] text-ink-3 sm:inline">traccia di esempio</span>
      </div>
      {/* Shorter on a phone. At a fixed 300 the instrument took half the
          viewport and pushed the command, the only action on this page, below
          the fold on a 667px screen.

          The pen arm moves in with it. It stands a fixed distance inside the
          field, and at the desktop distance it sat off the right-hand edge of
          every phone: the paper fed past nothing and the signature instrument
          read as a static line. At 200 it stands about two thirds of the way
          across a 320px screen and still inside a 640px one. */}
      <StripChart height={170} pen={200} class="sm:hidden" />
      <StripChart height={300} class="max-sm:hidden" />
    </div>

    {/* One action. The command is the call to action; there is no button pair.

        The well and the sentence sit side by side only from `xl`. At `lg` the
        sentence had no measure and took what it wanted, and the well, the only
        action on the page, was squeezed to one word per line on a 1024 screen.
        Below `xl` the sentence sits under the well at a reading measure. */}
    <div class="mx-auto w-full max-w-[86rem] px-5 sm:px-8">
      <div class="flex min-w-0 flex-col gap-4 xl:flex-row xl:items-center">
        {/* The command that works today. The Docker image is the intended
            install and lands with the first release; until then a page that
            led with it sent every reader to a pull that fails. */}
        <Command
          class="xl:max-w-[38rem] xl:flex-1"
          label="Compila ed esegui"
          command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
        />
        <p class="max-w-[46ch] text-[0.9375rem] leading-relaxed text-ink-2 xl:pl-2">
          Poi apri <span class="data text-ink">localhost:4317</span>. Nessun account,
          nessun database da mettere in piedi, niente da firmare. Non c’è ancora una
          release: l’immagine e i pacchetti arrivano con la prima.
          <a href={url('/docs/quickstart')} class="link ml-1"
            >Leggi l’avvio rapido di cinque minuti</a
          >.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 02
      Prove it. The product doing its actual job on a real failing run. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-14">
      <div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)]">
          Un’esecuzione che si legge.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Un agente che fallisce non fallisce nella riga di log che nomina
          l’errore. Fallisce tre passi prima, quando il modello ha scelto lo
          strumento sbagliato e poi lo ha scelto di nuovo.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          mcpd ricostruisce l’intera esecuzione come un albero: ogni chiamata al
          modello, ogni chiamata a uno strumento, ogni recupero, con il prompt e
          la completion esatti allegati a ciascuna, la latenza di ciascuna e
          quanto è costata ciascuna.
        </p>
        <p class="mt-6">
          <a href={url('/app')} class="link">Apri l’interfaccia</a>
        </p>
      </div>
      <Waterfall />
    </div>
    <RunDrum class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 02b
      Hold it. The daemon between the steps: the argument the run cursor makes,
      with the instrument taking the full width because the drawing is the
      argument and the copy is its caption. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Un’esecuzione che sopravvive al processo che l’ha avviata.
      </h2>
      <p class="prose max-w-[46ch] text-[0.9375rem]">
        Il daemon tiene l’esecuzione tra un passo e l’altro. Il tuo processo
        tiene tutto quello che accade dentro un passo, e non cede niente: né il
        modello, né il prompt, né una credenziale.
      </p>
    </div>

    <LeaseBoard class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Il grafo è un dato, i corpi sono tuoi
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un workflow si scrive una volta sola, in codice. Il grafo arriva al
          daemon come una definizione: la convalida e la versiona. I corpi dei
          passi restano nel tuo processo, in uno dei sei linguaggi, e un worker
          li serve.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Nuovi tentativi, timer e attese sono righe
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un errore transitorio viene ritentato sul budget del passo stesso. Una
          pausa o un’attesa di approvazione trattiene l’esecuzione senza nessun
          processo vivo, attraverso un deploy, un crash o una settimana. Un
          evento risponde all’attesa per nome e per chiave, e un evento ripetuto
          è un duplicato, non una seconda esecuzione.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Ogni esecuzione è una traccia</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Ogni passo è uno span con il suo input, il suo output e il consumo che
          ha dichiarato, valorizzato con lo stesso listino che valorizza tutti
          gli altri span. La chiamata al modello fatta dentro un passo si colloca
          sotto di esso, così la ricerca, il costo e gli scorer lavorano su
          un’esecuzione senza cambiarla.
        </p>
      </div>
    </div>
    <p class="mt-8">
      <a href={url('/docs/workflows')} class="link">Leggi la pagina sui workflow</a>
    </p>
  </section>

  {/* ------------------------------------------------------------ channel 03
      Instrument it. Real code, in every language, read from the examples. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-14">
      <div>
        <h2 class="display max-w-[22ch] text-[clamp(1.75rem,3vw,2.5rem)]">
          Strumenta nel linguaggio che scrivi già.
        </h2>
        <p class="prose mt-5 text-[0.9375rem]">
          Sei SDK, un solo comportamento. Registrare uno span non blocca mai, non
          solleva mai un’eccezione e non cresce mai senza limite: se mcpd è
          irraggiungibile il tuo agente non se ne accorge, che è l’unico modo
          accettabile in cui l’osservabilità può guastarsi. Ognuno porta con sé
          anche un worker, così i passi di un’esecuzione durevole sono serviti
          dallo stesso processo che li registra.
        </p>
        <p class="prose mt-4 text-[0.9375rem]">
          Nessuno di essi è obbligatorio. Punta <span class="data text-ink"
            >OTEL_EXPORTER_OTLP_ENDPOINT</span
          > su mcpd e un SDK OpenTelemetry che già esegui lo raggiunge, senza una riga
          del nostro codice dentro la tua applicazione. I sei sono una comodità posata
          su una superficie HTTP, non una condizione per essere registrati.
        </p>
        {/* The honest difference from observability that ships inside a
            framework, stated here rather than in a section of its own: this is
            the paragraph where a reader is deciding whether their existing
            agent qualifies. */}
        <p class="prose mt-4 text-[0.9375rem]">
          L’osservabilità che arriva attaccata a un framework sa registrare solo
          gli agenti costruiti con quel framework. mcpd prende tutto quello che
          raggiunge il suo endpoint OTLP: un framework per agenti, un ciclo che
          hai scritto tu, o i servizi che l’uno o l’altro chiama.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={url('/docs/sdks/typescript')} class="link text-[0.9375rem]">TypeScript</a>
          <a href={url('/docs/sdks/python')} class="link text-[0.9375rem]">Python</a>
          <a href={url('/docs/sdks/rust')} class="link text-[0.9375rem]">Rust</a>
          <a href={url('/docs/sdks/go')} class="link text-[0.9375rem]">Go</a>
          <a href={url('/docs/sdks/kotlin')} class="link text-[0.9375rem]">Kotlin</a>
          <a href={url('/docs/sdks/elixir')} class="link text-[0.9375rem]">Elixir</a>
        </div>
      </div>
      <CodeSwitcher region="trace" title="strumentare un’esecuzione" />
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 04
      What it records. Six signals, one correlation, shown as a diagram of
      the actual mechanism, not as three feature cards. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <h2 class="display max-w-[26ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      Sei segnali, correlati dall’esecuzione che li ha prodotti.
    </h2>
    <p class="prose mt-5 max-w-[62ch] text-[0.9375rem]">
      Quasi tutti i prodotti ti danno le tracce qui e i log da un’altra parte, e
      ti lasciano far combaciare i timestamp a occhio. mcpd conserva tutti e sei i
      segnali sotto gli stessi id di traccia e di span, così un picco su un
      grafico apre l’esecuzione che lo ha causato e un’esecuzione mostra le
      righe di log che ha emesso.
    </p>
    <SortingBench class="mt-10" />
  </section>

  {/* ------------------------------------------------------------ channel 05
      Proof. The one claim a competitor cannot answer with better copy, drawn as
      the instrument that checks it.

      The reading order here is instrument first, argument after, and that is
      the point of the section rather than a variation for its own sake. Three
      sections in a row had put a text column on the left and an instrument on
      the right; a third instance of one skeleton stops being a rhythm and
      starts being a template. It was also the wrong home for this particular
      instrument. Seven channels against nine checks is a wide reading, and in a
      right-hand column it had to scroll sideways inside itself on any screen
      under about 1200px, so the last three checks were behind a scrollbar
      exactly where the argument lands. At full width the whole grid is on
      screen at once, which is the only form in which it argues anything: you
      are meant to see that every cell is lit, not read a sentence saying so. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    {/* The number is read from the harness, not typed here. A language added
        to the suite used to leave this headline saying seven beside a panel
        drawing eight rows. */}
    <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
      {inLettere(CHANNELS.length)} linguaggi che vanno d’accordo.
    </h2>

    <Conformance class="mt-9" />

    <div class="mt-9 grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Ogni SDK è testato per conto suo, il che dimostra che ognuno fa quello
        che i suoi autori volevano e non dice niente sul fatto che coincidano
        tra loro. Perciò ognuno scrive la stessa esecuzione su un solo daemon,
        e le tracce vengono rilette e confrontate una con l’altra.
      </p>
      <p class="max-w-[52ch] text-[0.9375rem] leading-relaxed text-ink-2">
        Un comportamento che vale in un linguaggio e non in un altro si vede lì e
        in nessun altro posto. Gira in CI a ogni modifica.
        <a href={url('/docs/from-mastra')} class="link ml-1">Come regge il confronto</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05a
      Running it for other people. The composition is deliberately not the
      text-beside-instrument of the two sections around it: the ledger takes the
      full width, because the ledger IS the argument.

      The notes under it answer the questions a review asks after the ledger,
      and they are notes rather than sections on purpose. Attribution to a
      person, erasure by subject and `mcpd doctor` each landed as a feature and
      each could have taken a section of its own; a page that grows a section
      per feature is a feature list, and this one is not. They belong here
      because they all answer the same question the ledger does. There are six,
      which is two full rows of the three-across grid: the count has to stay a
      multiple of three, because a seventh note leaves one alone on a third row
      and that reads as an accident rather than a decision. */}
  <div class="seam"></div>
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="display max-w-[20ch] text-[clamp(1.75rem,3vw,2.5rem)]">
        Chi ha letto che cosa, compreso chi è stato respinto.
      </h2>
      <p class="prose max-w-[42ch] text-[0.9375rem]">
        La domanda che decide una revisione di sicurezza non è se i dati sono al
        sicuro. È se puoi mostrare, dopo, chi li ha raggiunti.
      </p>
    </div>

    <AuditLedger class="mt-10" />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Sei ambiti di chiave</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Emettere telemetria, leggere prompt, modificare dati archiviati,
          distruggerli, avviare esecuzioni e prendere in carico passi sono
          privilegi diversi. Un elenco write non impostato accetta le chiavi di
          ingest, e un elenco admin non impostato accetta le chiavi di lettura.
          Gli elenchi execute e worker non impostati accettano le chiavi di
          scrittura. Aggiornare non ti chiude fuori.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Un progetto è un confine</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Le chiavi, la conservazione e il campionamento si impostano tutti per
          progetto. Una chiave elencata sotto un progetto raggiunge quel
          progetto, e il daemon stabilisce di chi è un dataset prima di
          restituirne anche un solo caso.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Niente chiama casa</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          In tutto il daemon ci sono quattro punti da cui parte una richiesta
          verso l’esterno, e li configuri tutti e quattro: l’inoltro, due webhook
          e il giudice. Non c’è controllo degli aggiornamenti, non c’è telemetria
          e non c’è un server di licenze.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Quale chiave, e quale persona</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Il registro nomina la chiave. Dai a mcpd l’header che il tuo ingress
          imposta già, e gli indirizzi autorizzati a impostarlo, e nomina anche
          la persona. Inviato da qualunque altro posto, un header è
          un’affermazione che chiunque potrebbe fare, quindi la riga resta vuota
          invece di portare una supposizione.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">
          Una richiesta di cancellazione è una sola chiamata
        </p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          Un solo DELETE toglie tutte le esecuzioni registrate a nome di una
          persona, con gli span, i log, le metriche, i punteggi e i feedback che
          ne dipendono, e risponde con un conteggio per segnale. Le righe di un
          progetto che quella chiave non può aprire non vengono né toccate né
          contate.
        </p>
      </div>
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">Controlla prima di fidarti</p>
        <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-ink-2">
          <span class="data text-ink">mcpd doctor</span> dà un voto a un deploy:
          se lo storage accetta una scrittura e la restituisce, se un ambito è
          rimasto aperto, se un progetto configurato ha mai ricevuto uno span.
          Tutto ciò su cui ti chiede di intervenire nomina l’opzione che lo
          corregge.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ channel 05b
      The limits, on the page rather than buried in a file. Three independent
      reviewers named this as the single most trust-building thing available to
      a project with no customers, and it costs nothing but nerve. */}
  <div class="seam"></div>

  {/* ------------------------------------------------------------ channel 06
      The close, on the panel's darker floor. */}
  <div class="seam"></div>
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,34rem)]">
        <div class="min-w-0">
          <h2 class="display max-w-[16ch] text-[clamp(1.75rem,3vw,2.75rem)] text-floor-ink">
            Cinque minuti alla tua prima traccia.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[0.9375rem] leading-relaxed text-floor-ink/80">
            Esegui il daemon, puntaci il tuo agente, apri l’interfaccia. Se ci
            vuole più tempo, è un bug e ci interessa la segnalazione.
          </p>
        </div>
        <Command
          variant="floor"
          label="Avvia"
          command="docker run -p 4317:4317 ghcr.io/mcpd/mcpd"
          secondary={[
            { label: 'Kubernetes', command: 'export INGEST_KEY=$(openssl rand -hex 32) READ_KEY=$(openssl rand -hex 32) && helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace --set keys.ingest=$INGEST_KEY --set keys.read=$READ_KEY' },
            { label: 'Dai sorgenti', command: 'git clone https://github.com/mcpd/mcpd && cd mcpd && make dist' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
