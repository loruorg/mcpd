/* I link interni restano scritti come route inglesi e vengono localizzati qui.
   Una route la cui pagina italiana non è ancora scritta porta alla pagina
   inglese, invece che a un URL italiano senza niente dietro. */
const code = localeOf(Astro.url.pathname)
const url = (route: string) =>
  urlFor(route, localesWithPage(route).includes(code) ? code : DEFAULT_LOCALE)

const destinations = `{
  "forward": [
    {
      "vendor": "langfuse",
      "region": "eu",
      "public_key": "\${LANGFUSE_PUBLIC_KEY}",
      "secret_key": "\${LANGFUSE_SECRET_KEY}",
      "filter": { "projects": ["checkout"], "sample": 0.25 },
      "redact": { "key_contains": ["email"] }
    },
    {
      "name": "honeycomb-prod",
      "vendor": "honeycomb",
      "api_key": "\${HONEYCOMB_API_KEY}",
      "dataset": "agents",
      "signals": { "traces": true, "logs": true, "metrics": false }
    },
    {
      "name": "collector",
      "endpoint": "https://otel.internal.example.com:4318",
      "protocol": "protobuf",
      "headers": { "Authorization": "Bearer \${COLLECTOR_TOKEN}" },
      "redact": { "drop_payloads": true }
    }
  ]
}`
