---
import Base from '@/layouts/Base.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'
import Command from '@/components/Command.astro'
import { SITE } from '@/lib/site'
import { localeOf, urlFor } from '@/lib/i18n'

const code = localeOf(Astro.url.pathname)
const linkTo = (route: string) => urlFor(route, code)

/* Names a reader can instrument today. Text, never logos: these are other
   people's marks. Every framework here reaches mcpd through OpenTelemetry
   (gen_ai.* or OpenInference conventions), which the daemon reads as is. */
const FRAMEWORKS = [
  'LangChain', 'LangGraph', 'LlamaIndex', 'CrewAI', 'Vercel AI SDK', 'OpenAI Agents SDK',
  'Pydantic AI', 'AutoGen', 'Semantic Kernel', 'Haystack', 'DSPy', 'Your own loop',
]
const PROVIDERS = ['OpenAI', 'Anthropic', 'Google Gemini', 'Mistral', 'Azure OpenAI', 'Groq', 'Ollama', 'vLLM']
const LANGUAGES = ['TypeScript', 'Python', 'Rust', 'Go', 'Kotlin', 'Elixir']
const SDK_PATHS: Record<string, string> = {
  TypeScript: '/docs/sdks/typescript', Python: '/docs/sdks/python', Rust: '/docs/sdks/rust',
  Go: '/docs/sdks/go', Kotlin: '/docs/sdks/kotlin', Elixir: '/docs/sdks/elixir',
}
---

<Base title="mcpd" description={SITE.description} kind="software" og="default" flushFooter>
  {/* ----------------------------------------------------------------- hero */}
  <section class="hero relative overflow-hidden">
    <div class="mx-auto grid max-w-[86rem] items-center gap-12 px-5 pb-20 pt-14 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14 lg:pb-28 lg:pt-24">
      <div class="min-w-0">
        <h1 class="display max-w-[15ch] text-[clamp(2.5rem,5.2vw,4.25rem)]">
          The unopinionated agent observatory.
        </h1>
        <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-ink-2 sm:text-[1.125rem]">
          See every run of every agent you ship: each model call, tool call and
          retrieval, with its prompt, its answer and its cost. Any framework, any
          language, any model provider. Nothing to adopt.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/app" class="btn btn-primary">Start free <span class="arrow" aria-hidden="true">→</span></a>
          <a href={linkTo('/docs/quickstart')} class="btn btn-secondary">Self-host</a>
        </div>
        <p class="mt-5 text-[0.875rem] text-ink-3">
          Hosted free with every feature, or one open-source binary on your own machine.
        </p>
      </div>
      <LiveTrace class="min-w-0" />
    </div>
  </section>

  {/* ------------------------------------------------------------ works with */}
  <section class="border-y border-scribe-2 bg-panel-1">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
        <div class="min-w-0">
          <h2 class="display max-w-[18ch] text-[clamp(1.85rem,3.4vw,2.75rem)]">Works with what you already run.</h2>
          <p class="mt-5 max-w-[48ch] text-[1rem] leading-relaxed text-ink-2">
            mcpd receives OpenTelemetry and reads both the OpenTelemetry and the
            OpenInference conventions for model calls. The instrumentation that
            already exists for your stack works as it is. Your agent keeps its
            framework, and you keep your code.
          </p>
          <Command
            class="mt-7"
            label="Point any OpenTelemetry exporter at mcpd"
            command={`export OTEL_EXPORTER_OTLP_ENDPOINT=https://api.mcpd.sh
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json`}
          />
          <p class="mt-4 text-[0.9375rem] text-ink-2">
            Or add an SDK:
            {LANGUAGES.map((l, i) => (
              <>{i > 0 && <span class="text-ink-4"> · </span>}<a href={linkTo(SDK_PATHS[l]!)} class="link">{l}</a></>
            ))}
          </p>
        </div>

        <div class="grid min-w-0 gap-8 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
          <div>
            <p class="legend">Agent frameworks</p>
            <ul class="wordmarks mt-3">
              {FRAMEWORKS.map((f) => <li>{f}</li>)}
            </ul>
          </div>
          <div>
            <p class="legend">Model providers</p>
            <ul class="wordmarks mt-3">
              {PROVIDERS.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- what you see */}
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-16">
      <div class="min-w-0">
        <h2 class="display max-w-[16ch] text-[clamp(1.85rem,3.4vw,2.75rem)]">Every step, with the evidence.</h2>
        <p class="mt-5 max-w-[44ch] text-[1rem] leading-relaxed text-ink-2">
          A run is a tree of model calls, tool calls and retrievals. Open any step
          to read the exact prompt and answer, the tokens it used and what it cost.
          Search finds a run by what the model said, and every log line links back
          to the step that wrote it.
        </p>
        <ul class="facts mt-7">
          <li>Waterfall of every run, on one clock</li>
          <li>Full conversation, tool calls included</li>
          <li>Cost per run, per model and per project</li>
          <li>Logs, metrics and traces joined by trace id</li>
        </ul>
        <p class="mt-7"><a href="/app" class="link">Open the interface</a></p>
      </div>
      <RunViews class="min-w-0" />
    </div>
  </section>

  {/* ------------------------------------------------------------- workflows */}
  <section class="border-y border-scribe-2 bg-panel-1">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-5">
        <h2 class="display max-w-[18ch] text-[clamp(1.85rem,3.4vw,2.75rem)]">Workflows that survive a crash.</h2>
        <p class="max-w-[50ch] text-[1rem] leading-relaxed text-ink-2">
          Write the steps in your own code, in any of six languages. mcpd holds the
          run between them: retries, timers, and waits for an event that may take a
          week. If a worker dies mid-step, another one picks the step up.
        </p>
      </div>
      <DurableRun class="mt-10" />
      <div class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-3">
        <div>
          <p class="text-[0.9375rem] font-medium text-ink">Your code runs every step</p>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">The daemon never sees a model, a prompt or a credential. Workers claim one step at a time.</p>
        </div>
        <div>
          <p class="text-[0.9375rem] font-medium text-ink">Waits hold no process</p>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">A sleep or a wait for approval holds the run with no process alive, through a deploy or a week.</p>
        </div>
        <div>
          <p class="text-[0.9375rem] font-medium text-ink">Every run is a trace</p>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">Each step is a span with its input, output and cost, so search and scoring work on runs too.</p>
        </div>
      </div>
      <p class="mt-8"><a href={linkTo('/docs/workflows')} class="link">Read about workflows</a></p>
    </div>
  </section>

  {/* ------------------------------------------------- evaluation, monitors */}
  <section class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16">
      <MonitorChart class="min-w-0 max-lg:order-2" />
      <div class="min-w-0">
        <h2 class="display max-w-[16ch] text-[clamp(1.85rem,3.4vw,2.75rem)]">Know when quality slips.</h2>
        <p class="mt-5 max-w-[44ch] text-[1rem] leading-relaxed text-ink-2">
          Score every run with thirteen built-in scorers or with a model as the
          judge. Turn production runs into datasets and compare experiments.
          Monitors watch error rate, latency, cost and scores, and call your
          webhook when one of them moves.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2">
          <a href={linkTo('/docs/evaluation')} class="link">Evaluation</a>
          <a href={linkTo('/docs/alerting')} class="link">Monitors and alerts</a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- deploy */}
  <section class="border-t border-scribe-2 bg-panel-1">
    <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
        <div class="min-w-0">
          <h2 class="display max-w-[14ch] text-[clamp(1.85rem,3.4vw,2.75rem)]">Run it anywhere.</h2>
          <p class="mt-5 max-w-[46ch] text-[1rem] leading-relaxed text-ink-2">
            One binary with the storage and the interface built in. SQLite on a
            laptop, Postgres or ClickHouse for a team, Docker or Kubernetes in
            production. No telemetry and no licence server.
          </p>
          <p class="mt-7"><a href={linkTo('/deploy')} class="link">Deployment guide</a></p>
        </div>
        <div class="grid min-w-0 gap-3 sm:grid-cols-2">
          <div class="target">
            <p class="text-[0.9375rem] font-medium text-ink">Hosted</p>
            <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-2">Free at mcpd.sh, every feature included. Sign up and send your first trace.</p>
          </div>
          <div class="target">
            <p class="text-[0.9375rem] font-medium text-ink">Your laptop</p>
            <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-2">One process and one SQLite file. Nothing else to install.</p>
          </div>
          <div class="target">
            <p class="text-[0.9375rem] font-medium text-ink">Docker</p>
            <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-2">One container, one volume, one port.</p>
          </div>
          <div class="target">
            <p class="text-[0.9375rem] font-medium text-ink">Kubernetes</p>
            <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-2">A Helm chart, with Postgres or ClickHouse behind it and keys per project.</p>
          </div>
          <Command
            class="sm:col-span-2"
            label="Run your own"
            command="git clone https://github.com/mcpd/mcpd && cd mcpd && make build && ./target/release/mcpd demo"
            primaryLabel="From source"
            secondary={[
              { label: 'Docker', command: 'docker run -p 4317:4317 ghcr.io/mcpd/mcpd' },
              { label: 'Kubernetes', command: 'helm install mcpd oci://ghcr.io/mcpd/charts/mcpd -n mcpd --create-namespace' },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- close */}
  <section class="bg-floor text-floor-ink">
    <div class="mx-auto flex max-w-[86rem] flex-col items-start gap-8 px-5 py-20 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:py-24">
      <div>
        <h2 class="max-w-[18ch] text-[clamp(1.85rem,3.6vw,3rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-floor-ink">
          Your first trace in five minutes.
        </h2>
        <p class="mt-4 max-w-[46ch] text-[1rem] leading-relaxed text-floor-ink/75">
          Sign up free, or run it on your own machine. The same product either way.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/app" class="btn btn-floor">Start free <span class="arrow" aria-hidden="true">→</span></a>
        <a href={linkTo('/docs/quickstart')} class="btn btn-floor-secondary">Self-host</a>
      </div>
    </div>
  </section>
</Base>
