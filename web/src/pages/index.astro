---
import Base from '@/layouts/Base.astro'
import Home, { type HomeCopy } from '@/components/Home.astro'
import LiveTrace from '@/components/LiveTrace.astro'
import RunViews from '@/components/RunViews.astro'
import DurableRun from '@/components/DurableRun.astro'
import MonitorChart from '@/components/MonitorChart.astro'
import { SITE } from '@/lib/site'

const copy: HomeCopy = {
  h1: 'The unopinionated agent observatory.',
  lede:
    'See every run of every agent you ship: each model call, tool call and retrieval, ' +
    'with its prompt, its answer and its cost. Any framework, any language, any model ' +
    'provider. Nothing to adopt.',
  startFree: 'Start free',
  selfHost: 'Self-host',
  heroNote: 'Hosted free with every feature, or one open-source binary on your own machine.',

  worksTitle: 'Works with what you already run.',
  worksBody:
    'mcpd receives OpenTelemetry and reads both the OpenTelemetry and the OpenInference ' +
    'conventions for model calls, so the instrumentation that already exists for your ' +
    'stack works as it is. Your agent keeps its framework, and you keep your code.',
  otelLabel: 'Point any OpenTelemetry exporter at mcpd',
  sdkLead: 'Or add an SDK:',
  frameworksLegend: 'Agent frameworks',
  providersLegend: 'Model providers',
  ownLoop: 'Your own loop',

  seeTitle: 'Every step, with the evidence.',
  seeBody:
    'A run is a tree of model calls, tool calls and retrievals. Open any step to read the ' +
    'exact prompt and answer, the tokens it used and what it cost. Search finds a run by ' +
    'what the model said, and every log line links back to the step that wrote it.',
  seeFacts: [
    'A waterfall of every run, on one clock',
    'The full conversation, tool calls included',
    'Cost per run, per model and per project',
    'Logs, metrics and traces joined by trace id',
  ],
  openInterface: 'Open the interface',

  flowTitle: 'Workflows that survive a crash.',
  flowBody:
    'Write the steps in your own code, in any of six languages. mcpd holds the run between ' +
    'them: retries, timers, and waits for an event that may take a week. If a worker dies ' +
    'mid-step, another one picks the step up.',
  flowNotes: [
    ['Your code runs every step', 'The daemon never sees a model, a prompt or a credential. Workers claim one step at a time.'],
    ['Waits hold no process', 'A sleep or a wait for approval holds the run with no process alive, through a deploy or a week.'],
    ['Every run is a trace', 'Each step is a span with its input, output and cost, so search and scoring work on runs too.'],
  ],
  flowLink: 'Read about workflows',

  evalTitle: 'Know when quality slips.',
  evalBody:
    'Score every run with thirteen built-in scorers or with a model as the judge. Turn ' +
    'production runs into datasets and compare experiments. Monitors watch error rate, ' +
    'latency, cost and scores, and call your webhook when one of them moves.',
  evalLink: 'Evaluation',
  alertLink: 'Monitors and alerts',

  deployTitle: 'Run it anywhere.',
  deployBody:
    'One binary with the storage and the interface built in. SQLite on a laptop, Postgres ' +
    'or ClickHouse for a team, Docker or Kubernetes in production. No telemetry and no ' +
    'licence server.',
  deployLink: 'Deployment guide',
  targets: [
    ['Hosted', 'Free at mcpd.sh with every feature included. Sign up and send your first trace.'],
    ['Your laptop', 'One process and one SQLite file. Nothing else to install.'],
    ['Docker', 'One container, one volume, one port.'],
    ['Kubernetes', 'A Helm chart, with Postgres or ClickHouse behind it and keys per project.'],
  ],
  ownLabel: 'Run your own',
  fromSource: 'From source',

  closeTitle: 'Your first trace in five minutes.',
  closeBody: 'Sign up free, or run it on your own machine. The same product either way.',
}
---

<Base title="mcpd" description={SITE.description} kind="software" og="default" flushFooter>
  <Home copy={copy}>
    <LiveTrace slot="hero" class="min-w-0" />
    <RunViews slot="see" class="min-w-0" />
    <DurableRun slot="flow" class="mt-10" />
    <MonitorChart slot="eval" />
  </Home>
</Base>
