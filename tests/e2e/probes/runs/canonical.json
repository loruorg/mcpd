{
  "definition_id": "conformance_run",
  "input": { "ticket": "Q-41" },
  "correlation": { "session_id": "sess-runs", "user_id": "user-41" },
  "event": { "name": "approved", "key": "Q-41", "payload": { "by": "ops" }, "event_id": "conformance-approval" },
  "output": { "answer": "an answer to a question", "sent": true, "by": "ops" },
  "state": { "drafted": true },
  "model": { "name": "claude-sonnet-4", "provider": "anthropic", "input_tokens": 120, "output_tokens": 40 },
  "definition_body": {
    "steps": [
      { "kind": "task", "id": "classify" },
      { "kind": "agent", "id": "draft", "input": { "kind": "${steps.classify.output.kind}" } },
      {
        "kind": "wait_event",
        "id": "approval",
        "event": "approved",
        "key": "${input.ticket}",
        "timeout_ms": 60000,
        "accept_parked": true
      },
      {
        "kind": "task",
        "id": "send",
        "input": { "text": "${steps.draft.output}", "by": "${steps.approval.output.by}" },
        "effect": "at_most_once",
        "retry": { "max_attempts": 2, "backoff": "fixed", "initial_ms": 100 }
      }
    ],
    "output": {
      "answer": "${steps.draft.output}",
      "sent": "${steps.send.output.sent}",
      "by": "${steps.send.output.by}"
    }
  }
}
